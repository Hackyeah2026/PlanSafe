@namespace PlanSafe.App.Components

<ModalDialog Width="1000px" IsOpen="IsOpen" Class="tree-dialog" LabelledBy="tree-title">
    @if (IsOpen)
    {
        <div class="tree-modal-card">
            <!-- Minimalist Header -->
            <div class="feature-dialog-header tree-modal-header">
                <div class="tree-header-left">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="6" y1="3" x2="6" y2="15"></line>
                        <circle cx="18" cy="6" r="3"></circle>
                        <circle cx="6" cy="18" r="3"></circle>
                        <path d="M18 9a9 9 0 0 1-9 9"></path>
                    </svg>
                    <h2 id="tree-title" class="tree-modal-title">@L.Scenario.Tree</h2>
                    <span class="tree-count-badge">@_allSessions.Count</span>
                </div>

                <!-- Minimal search bar inside header -->
                <div class="tree-search-wrapper">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text"
                           class="app-input tree-search-input"
                           placeholder="@L.Scenario.FilterHint"
                           aria-label="@L.Scenario.Filter"
                           @bind="_searchQuery"
                           @bind:event="oninput"
                           @bind:after="FilterTree" />
                    @if (!string.IsNullOrEmpty(_searchQuery))
                    {
                        <button type="button" class="app-button btn-clear-search" aria-label="@L.Scenario.ClearFilter" @onclick="ClearSearch"><UiIcon Kind="UiIconKind.Close" /></button>
                    }
                </div>

                <div class="tree-header-actions">
                    <button type="button" class="app-button btn-tree-primary app-button--primary" @onclick="HandleNewBranchFromActive" title="@L.Scenario.BranchCurrent">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        <span>@L.Scenario.NewBranch</span>
                    </button>

                    <button type="button" class="app-button btn-tree-icon" @onclick="ExportJson" aria-label="@L.Scenario.CopyTree" title="@L.Scenario.CopyTree">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                    </button>

                    <button type="button" class="app-button btn-tree-icon btn-tree-close" data-dialog-close @onclick="Close" aria-label="@L.Common.Close">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Graph Canvas Body -->
            <div class="tree-modal-body">
                @if (_isLoading)
                {
                    <div class="tree-status-box">
                        <span class="spinner-border spinner-border-sm text-info me-2"></span>
                        <span>@L.Scenario.Loading</span>
                    </div>
                }
                else if (_layoutNodes.Count == 0)
                {
                    <div class="tree-status-box">
                        <small class="text-secondary">@L.Scenario.NoMatches</small>
                    </div>
                }
                else
                {
                    <div class="graph-scroll-area">
                        <div class="graph-canvas" style="min-width: 100%; height: @(FormattableString.Invariant($"{_svgHeight}px")); position: relative;">
                            <!-- SVG Branch Graph Layer -->
                            <svg class="graph-svg-layer" 
                                 width="@_svgWidth" 
                                 height="@_svgHeight" 
                                 style="position: absolute; left: 0; top: 0; pointer-events: none; z-index: 2;">
                                
                                <!-- Connecting branch curves -->
                                @foreach (var edge in _edges)
                                {
                                    <path d="@GetBranchPath(edge.X1, edge.Y1, edge.X2, edge.Y2)"
                                          stroke="@edge.Color"
                                          stroke-width="@(edge.IsActiveLineage ? "2.8" : "2")"
                                          stroke-opacity="@(edge.IsActiveLineage ? "1" : "0.65")"
                                          fill="none"
                                          stroke-linecap="round" />
                                }

                                <!-- Node commit circles -->
                                @foreach (var item in _layoutNodes)
                                {
                                    if (item.IsActive)
                                    {
                                        <circle cx="@item.X" cy="@item.Y" r="10" fill="none" stroke="@item.Color" stroke-width="1.8" opacity="0.6" class="pulse-ring" />
                                        <circle cx="@item.X" cy="@item.Y" r="5.5" fill="#ffffff" stroke="@item.Color" stroke-width="2.5" />
                                    }
                                    else
                                    {
                                        <circle cx="@item.X" cy="@item.Y" r="5" fill="@item.Color" stroke="#0b1120" stroke-width="2" />
                                    }
                                }
                            </svg>

                            <!-- Interactive Rows Layer -->
                            <div class="graph-rows-layer" style="position: relative; z-index: 3;">
                                @foreach (var item in _layoutNodes)
                                {
                                    var session = item.Session;
                                    bool isActive = item.IsActive;

                                    <div class="graph-row @(isActive ? "is-active" : "")"
                                         style="height: 44px; padding-left: @(FormattableString.Invariant($"{_svgWidth + 10}px"));"
                                         @onclick="() => HandleCheckout(session)">
                                        
                                        <!-- Branch Pill & Lineage -->
                                        <div class="row-branch-box">
                                            <span class="branch-pill" style="--branch-color: @item.Color;">
                                                <span class="branch-pill-dot" style="background: @item.Color;"></span>
                                                <span class="branch-pill-name">@session.BranchName</span>
                                            </span>

                                            @if (isActive)
                                            {
                                                <span class="badge-head">@L.Scenario.Current</span>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(session.Description))
                                            {
                                                <span class="branch-desc-text" title="@session.Description">@session.Description</span>
                                            }
                                        </div>

                                        <!-- Feature Counter Badges & Actions -->
                                        <div class="row-meta-and-actions" @onclick:stopPropagation>
                                            <div class="row-stat-chips">
                                                @if (session.EvacZoneCount > 0)
                                                {
                                                    <span class="mini-stat stat-evac" title="@session.EvacZoneCount Evacuation Zones">
                                                        <UiIcon Kind="UiIconKind.Warning" /> @session.EvacZoneCount <span class="visually-hidden">@L.Map.EvacuationZones</span>
                                                    </span>
                                                }
                                                @if (session.SafeZoneCount > 0)
                                                {
                                                    <span class="mini-stat stat-safe" title="@session.SafeZoneCount Safe Havens">
                                                        <UiIcon Kind="UiIconKind.Shield" /> @session.SafeZoneCount <span class="visually-hidden">@L.Map.SafeLocations</span>
                                                    </span>
                                                }
                                                @if (session.BlockadeCount > 0)
                                                {
                                                    <span class="mini-stat stat-block" title="@session.BlockadeCount Road Blockades">
                                                        <UiIcon Kind="UiIconKind.Blockade" /> @session.BlockadeCount <span class="visually-hidden">@L.Map.Blockades</span>
                                                    </span>
                                                }
                                                <span class="mini-stat stat-sim" title="@session.SimulationConfig.AgentCount Agents">
                                                    <UiIcon Kind="UiIconKind.People" /> @session.SimulationConfig.AgentCount <span class="visually-hidden">@L.Simulation.Agents</span>
                                                </span>
                                                <span class="time-subtle">@GetRelativeTime(session.UpdatedAt)</span>
                                            </div>

                                            <div class="row-buttons">
                                                @if (!isActive)
                                                {
                                                    <button type="button" class="app-button btn-row-action btn-checkout" title="@L.Scenario.SwitchHint" @onclick="() => HandleCheckout(session)">
                                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                                        <span>@L.Scenario.Switch</span>
                                                    </button>
                                                }

                                                <button type="button" class="app-button btn-row-action btn-branch" title="@L.Scenario.BranchFrom" @onclick="() => HandleBranchFrom(session)">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="6" y1="3" x2="6" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg>
                                                    <span>@L.Scenario.Branch</span>
                                                </button>

                                                @if (!item.Node.IsRoot && !isActive && _allSessions.Count > 1)
                                                {
                                                    <button type="button" class="app-button btn-row-action btn-delete" aria-label="@(L.Scenario.DeleteNamed(session.BranchName))" title="@L.Scenario.Delete" @onclick="() => HandleDelete(session)">
                                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Minimalist Footer -->
            <div class="feature-dialog-footer tree-modal-footer">
                <div class="graph-legend">
                    <span class="legend-item"><span class="legend-dot dot-head"></span> @L.Scenario.Active</span>
                    <span class="legend-item"><span class="legend-dot dot-root"></span> @L.Scenario.Root</span>
                    <span class="legend-item"><span class="legend-dot dot-branch"></span> @L.Scenario.Branch</span>
                </div>
                <button type="button" class="app-button btn-modal-secondary btn-sm" @onclick="Close">
                    @L.Common.Close
                </button>
            </div>
        </div>
    }
</ModalDialog>
