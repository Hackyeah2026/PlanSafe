@namespace PlanSafe.App.Components
<div class="simulation-run-controls" role="group" aria-label="@L.Simulation.Controls">
    <AppButton data-testid="toggle" Tone="@(IsRunning ? ButtonTone.Danger : ButtonTone.Success)" Disabled="@(!Ready)" OnClick="OnToggle">@(IsRunning ? L.Simulation.Stop : L.Simulation.Run)</AppButton>
    <AppButton Disabled="@(!Ready || IsRunning)" OnClick="OnStep">@L.Simulation.Step</AppButton>
    <AppButton data-testid="reset" Disabled="@(!Ready)" OnClick="OnReset">@L.Simulation.ResetAgents</AppButton>
    <AppButton Tone="ButtonTone.Primary" Disabled="@(!Ready || IsPublishing)" OnClick="OnPublish"><UiIcon Kind="UiIconKind.Phone" /> @(IsPublishing ? L.Publish.Publishing : L.Publish.Plan)</AppButton>
    <AppButton Pressed="ShowStats" OnClick="OnStatistics">@L.Statistics.Label</AppButton>
</div>
@code {
    [Parameter] public bool Ready { get; set; }
    [Parameter] public bool IsRunning { get; set; }
    [Parameter] public bool IsPublishing { get; set; }
    [Parameter] public bool ShowStats { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public EventCallback OnStep { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }
    [Parameter] public EventCallback OnPublish { get; set; }
    [Parameter] public EventCallback OnStatistics { get; set; }
}
