@namespace PlanSafe.App.Components

<div class="command-panel">
    <!-- Panel Header -->
    <div class="panel-header">
        <div class="header-title-row">
            <div class="header-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"></polygon>
                    <line x1="9" y1="3" x2="9" y2="18"></line>
                    <line x1="15" y1="6" x2="15" y2="21"></line>
                </svg>
            </div>
            <div>
                <h2 class="panel-title">Evacuation Command</h2>
                <div class="panel-subtitle">Simulation & Evacuation Center</div>
            </div>
        </div>
        <div class="header-actions">
            <div class="status-badge">
                <span class="status-dot"></span>
                <span class="status-text">Standby</span>
            </div>
            @if (OnClose.HasDelegate)
            {
                <button type="button" class="btn-panel-close" @onclick="OnClose" aria-label="Close panel" title="Close controls">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            }
        </div>
    </div>

    <!-- Simulation Action Buttons -->
    <div class="action-section">
        <div class="section-label">Simulation Controls</div>
        
        <button type="button" class="btn-command btn-configure" title="Configure simulation parameters and evacuation routes">
            <span class="btn-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
            </span>
            <span class="btn-text">Configure simulation/evacuation</span>
        </button>

        <button type="button" class="btn-command btn-start-simulation" title="Start crowd movement simulation">
            <span class="btn-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
            </span>
            <span class="btn-text">Start simulation</span>
        </button>

        <button type="button" class="btn-command btn-start-evacuation" title="Trigger citizen evacuation protocol">
            <span class="btn-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
            </span>
            <span class="btn-text">Start evacuation</span>
        </button>
    </div>

    <!-- Live Telemetry / Overview (Preparation for Next Round) -->
    <div class="metrics-section">
        <div class="section-label">Operational Overview</div>
        
        <div class="metric-card">
            <div class="metric-label">Initial Location (Test)</div>
            <div class="metric-value">Center of Kraków</div>
            <div class="metric-sub">50.0614° N, 19.9366° E</div>
        </div>

        <div class="metric-grid">
            <div class="metric-card">
                <div class="metric-label">Engine</div>
                <div class="metric-value highlight">WebAssembly</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Tile Source</div>
                <div class="metric-value">OpenStreetMap</div>
            </div>
        </div>

        <div class="upcoming-banner">
            <div class="banner-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                Next Round Readiness
            </div>
            <p class="banner-desc">Agent crowd rendering, emergency evacuation routes, and safe destination zones will be activated in the next iteration.</p>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
}
