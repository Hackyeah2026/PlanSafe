@namespace PlanSafe.App.Components
@using PlanSafe.Contracts.Models.Simulation

<ModalDialog Width="500px" IsOpen="true" Class="publish-dialog" LabelledBy="publish-title">
    <div class="feature-dialog-header">
        <h2 id="publish-title">Share evacuation plan</h2>
        <button type="button" class="app-button app-icon-button" data-dialog-close aria-label="Close" @onclick="OnClose"><UiIcon Kind="UiIconKind.Close" /></button>
    </div>
    <div class="feature-dialog-body">
        <PublishedPlanShare Plan="Plan" />
        <p class="publish-summary ui-muted">Shelters: @ShelterCount · Roadblocks: @ObstacleCount · Area: @WorldWidth.ToString("F0") m</p>
    </div>
    <div class="feature-dialog-footer"><AppButton OnClick="OnClose">Close</AppButton></div>
</ModalDialog>
@code {
    [Parameter, EditorRequired] public PublishPlanResponse Plan { get; set; } = default!;
    [Parameter] public int ShelterCount { get; set; }
    [Parameter] public int ObstacleCount { get; set; }
    [Parameter] public double WorldWidth { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}
