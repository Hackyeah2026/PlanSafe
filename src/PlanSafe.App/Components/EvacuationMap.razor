@namespace PlanSafe.App.Components
@using System.Text.Json
@using System.Diagnostics
@using PlanSafe.Contracts.Models.Map
@using PlanSafe.Contracts.Models.Simulation
@using PlanSafe.App.Services
@using PlanSafe.Contracts.Models.Session
@using PlanSafe.App.Simulation
@using PlanSafe.Contracts.Models.Stats
@inject IJSRuntime JS
@inject IMapInterop MapInterop
@inject IMapSessionService SessionService
@inject NavigationManager Navigation
@inject PlanSafe.App.Services.Gus.IGusCensusService CensusService
@inject PlanSafe.App.Services.Gus.IGusOccupantGenerator OccupantGenerator
@inject PlanSafe.App.Services.Osm.IOsmObstacleService OsmService
@implements IAsyncDisposable

<div class="map-module-layout">
    <!-- Map Canvas Area -->
    <div class="map-area">
        <div id="@MapContainerId" class="map-viewport">
            <canvas id="@SimCanvasId" @ref="_simCanvasRef"
                    class="map-simulation-canvas @(_isSimulating ? "active" : "")"
                    style="display: @(_isSimulating ? "block" : "none");"></canvas>
        </div>

        @if (!string.IsNullOrEmpty(_simWarningMessage))
        {
            <div class="sim-warning-toast desktop-floating-bar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                <span>@_simWarningMessage</span>
                <button type="button" class="btn-toast-close" @onclick="() => _simWarningMessage = null">&times;</button>
            </div>
        }

        @if (_isSimulating)
        {
            <SimulationControlBar
                IsRunning="@_isRunning"
                SimulationTime="@(_engine?.SimulationTime ?? 0)"
                EvacuatedCount="@(_engine?.EvacuatedCount ?? 0)"
                TotalAgents="@_simTotalAgents"
                RenderMode="@_simConfig.RenderMode"
                ShowWhiskers="@_simConfig.ShowWhiskers"
                TimeScale="@_simConfig.TimeScale"
                Unlimited="@_simConfig.Unlimited"
                OnToggle="ToggleSimulation"
                OnStep="StepSimulation"
                OnReset="ResetSimulation"
                OnRenderModeChanged="HandleRenderModeChanged"
                OnToggleWhiskers="HandleToggleWhiskers"
                OnCycleSpeed="HandleCycleSpeed"
                OnOpenStats="() => _isStatsOpen = true"
                OnExit="StopSimulation" />
        }

        <!-- Desktop Floating Drawing Toolbar (Hidden on mobile < 992px) -->
        <div class="map-drawing-toolbar desktop-floating-bar">
            <!-- Navigate / Pan -->
            <button type="button"
                    class="tool-btn @(_activeCategory == "navigate" ? "active" : "")"
                    @onclick='() => SelectCategory("navigate")'
                    title="Pan & Navigate (Default)">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"></path>
                    <path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2"></path>
                    <path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8"></path>
                    <path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"></path>
                </svg>
                <span class="tool-label">Navigate</span>
            </button>

            <div class="tool-separator"></div>

            <!-- Evacuation Zone (Dark Orange) -->
            <button type="button"
                    class="tool-btn btn-tool-zone @(_activeCategory == "evac" ? "active" : "")"
                    @onclick='() => SelectCategory("evac")'
                    title="Evacuation Zone (Dark Orange)">
                <span class="category-dot zone-dot"></span>
                <span class="tool-label">Evac Zone</span>
            </button>

            <!-- Safe Location (Green) -->
            <button type="button"
                    class="tool-btn btn-tool-safe @(_activeCategory == "safe" ? "active" : "")"
                    @onclick='() => SelectCategory("safe")'
                    title="Safe Location (Green)">
                <span class="category-dot safe-dot"></span>
                <span class="tool-label">Safe Location</span>
            </button>

            <!-- Blockade (Red Line) -->
            <button type="button"
                    class="tool-btn btn-tool-blockade @(_activeCategory == "blockade" ? "active" : "")"
                    @onclick='() => SelectCategory("blockade")'
                    title="Blockade (Red Line: start to end)">
                <span class="category-dot blockade-dot"></span>
                <span class="tool-label">Blockade</span>
            </button>

            <!-- Shape Selector (Polygon / Circle) for Evac & Safe Zones -->
            @if (_activeCategory == "evac" || _activeCategory == "safe")
            {
                <div class="tool-separator"></div>
                <div class="shape-toggle-group">
                    <button type="button"
                            class="shape-btn @(_selectedShape == "polygon" ? "active" : "")"
                            @onclick='() => SelectShape("polygon")'
                            title="Polygon (immediately confirmed on 3rd click, click more points to expand)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="12 2 22 8.5 18 21 6 21 2 8.5 12 2"></polygon>
                        </svg>
                        <span>Polygon</span>
                    </button>
                    <button type="button"
                            class="shape-btn @(_selectedShape == "circle" ? "active" : "")"
                            @onclick='() => SelectShape("circle")'
                            title="Circle (center + radius)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="9"></circle>
                        </svg>
                        <span>Circle</span>
                    </button>
                </div>
            }
        </div>

        <!-- Desktop Floating Active Tool Instruction Pill (Hidden on mobile) -->
        @if (_activeCategory != "navigate" && _activeDrawMode != "none")
        {
            <div class="draw-instruction-pill desktop-floating-bar">
                <div class="instruction-content">
                    <span class="pulsing-record-dot"></span>
                    <span class="instruction-text">@(_activeDrawHint ?? "Click on the map to define shape")</span>
                </div>
                <div class="instruction-actions">
                    @if ((_activeDrawMode == "evac_polygon" || _activeDrawMode == "safe_polygon" || _activeDrawMode == "polygon") && _currentPointCount >= 3)
                    {
                        <button type="button" class="btn-instruction-action btn-finish-polygon" @onclick="FinishPolygon" title="Finish drawing polygon (already confirmed)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            Done
                        </button>
                    }
                    <button type="button" class="btn-instruction-action btn-cancel-draw" @onclick="CancelDrawing" title="Cancel drawing mode (Esc)">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                        Cancel (Esc)
                    </button>
                </div>
            </div>
        }

        <!-- Desktop Floating Scenario Branch Capsule (Top Right - Hidden on mobile) -->
        <div class="map-floating-controls desktop-floating-bar">
            <div class="branch-floating-badge-group">
                <!-- Active Branch Indicator (Click to open Scenario Tree) -->
                <button type="button"
                        class="btn-branch-pill"
                        @onclick="() => _isTreeMapOpen = true"
                        title="Active Branch: @(_activeSession?.BranchName ?? "main") • Click to view Scenario Tree">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="branch-pill-icon">
                        <line x1="6" y1="3" x2="6" y2="15"></line>
                        <circle cx="18" cy="6" r="3"></circle>
                        <circle cx="6" cy="18" r="3"></circle>
                        <path d="M18 9a9 9 0 0 1-9 9"></path>
                    </svg>
                    <span class="branch-pill-tag">@(_activeSession?.BranchName ?? "main")</span>
                </button>

                <div class="branch-pill-divider"></div>

                <!-- Create Branch Button -->
                <button type="button"
                        class="btn-floating-pill-action btn-pill-branch"
                        @onclick="() => _isCreateBranchOpen = true"
                        title="Fork child branch from '@(_activeSession?.BranchName)'">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span>Branch</span>
                </button>

                <!-- Tree Map Button -->
                <button type="button"
                        class="btn-floating-pill-action btn-pill-tree"
                        @onclick="() => _isTreeMapOpen = true"
                        title="Open visual scenario tree map">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="6" y1="3" x2="6" y2="15"></line>
                        <circle cx="18" cy="6" r="3"></circle>
                        <circle cx="6" cy="18" r="3"></circle>
                        <path d="M18 9a9 9 0 0 1-9 9"></path>
                    </svg>
                    <span>Tree Map</span>
                </button>

                <!-- Statistics Button -->
                <button type="button"
                        class="btn-floating-pill-action btn-pill-stats"
                        @onclick="() => _isStatsOpen = true"
                        title="View evacuation analytics & statistics (sample data)">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                    <span>Statistics</span>
                </button>

                <div class="branch-pill-divider"></div>

                <!-- Center Map Button -->
                <button type="button"
                        class="btn-floating-pill-action btn-pill-center"
                        @onclick="HandleRecenter"
                        title="Reset map view to center">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="2" x2="12" y2="6"></line>
                        <line x1="12" y1="18" x2="12" y2="22"></line>
                        <line x1="2" y1="12" x2="6" y2="12"></line>
                        <line x1="18" y1="12" x2="22" y2="12"></line>
                    </svg>
                    <span>Center</span>
                </button>
            </div>
        </div>

        <!-- Mobile Unified Top Control Panel (Replaces separate floating panels on mobile < 992px) -->
        <div class="mobile-unified-panel">
            <!-- Row 1: Scenario Branch & Quick Actions -->
            <div class="mobile-panel-header-row">
                <button type="button"
                        class="btn-branch-pill mobile-branch-pill"
                        @onclick="() => _isTreeMapOpen = true"
                        title="Active Branch: @(_activeSession?.BranchName ?? "main") • Tap to view Tree">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="branch-pill-icon">
                        <line x1="6" y1="3" x2="6" y2="15"></line>
                        <circle cx="18" cy="6" r="3"></circle>
                        <circle cx="6" cy="18" r="3"></circle>
                        <path d="M18 9a9 9 0 0 1-9 9"></path>
                    </svg>
                    <span class="branch-pill-tag">@(_activeSession?.BranchName ?? "main")</span>
                </button>

                <div class="mobile-action-buttons">
                    <button type="button"
                            class="btn-floating-pill-action btn-pill-branch"
                            @onclick="() => _isCreateBranchOpen = true"
                            title="Fork branch">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        <span>Branch</span>
                    </button>

                    <button type="button"
                            class="btn-floating-pill-action btn-pill-tree"
                            @onclick="() => _isTreeMapOpen = true"
                            title="Tree Map">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="6" y1="3" x2="6" y2="15"></line>
                            <circle cx="18" cy="6" r="3"></circle>
                            <circle cx="6" cy="18" r="3"></circle>
                            <path d="M18 9a9 9 0 0 1-9 9"></path>
                        </svg>
                        <span>Tree</span>
                    </button>

                    <button type="button"
                            class="btn-floating-pill-action btn-pill-stats"
                            @onclick="() => _isStatsOpen = true"
                            title="Statistics">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="20" x2="18" y2="10"></line>
                            <line x1="12" y1="20" x2="12" y2="4"></line>
                            <line x1="6" y1="20" x2="6" y2="14"></line>
                        </svg>
                        <span>Stats</span>
                    </button>

                    <button type="button"
                            class="btn-floating-pill-action btn-pill-center"
                            @onclick="HandleRecenter"
                            title="Center map">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="2" x2="12" y2="6"></line>
                            <line x1="12" y1="18" x2="12" y2="22"></line>
                            <line x1="2" y1="12" x2="6" y2="12"></line>
                            <line x1="18" y1="12" x2="22" y2="12"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Subtle Separator -->
            <div class="mobile-panel-separator"></div>

            <!-- Row 2: Drawing Tools or Drawing Progress Banner -->
            @if (_activeCategory != "navigate" && _activeDrawMode != "none")
            {
                <div class="mobile-drawing-active-strip">
                    <div class="d-flex align-items-center gap-2 min-w-0 flex-grow-1">
                        <span class="pulsing-record-dot"></span>
                        <span class="mobile-instruction-text text-truncate">@(_activeDrawHint ?? "Click map to draw")</span>
                    </div>
                    <div class="d-flex align-items-center gap-1 flex-shrink-0">
                        @if ((_activeDrawMode == "evac_polygon" || _activeDrawMode == "safe_polygon" || _activeDrawMode == "polygon") && _currentPointCount >= 3)
                        {
                            <button type="button" class="btn-instruction-action btn-finish-polygon" @onclick="FinishPolygon">
                                Done
                            </button>
                        }
                        <button type="button" class="btn-instruction-action btn-cancel-draw" @onclick="CancelDrawing">
                            Cancel
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="mobile-tools-strip">
                    <button type="button"
                            class="tool-btn mobile-tool-btn @(_activeCategory == "navigate" ? "active" : "")"
                            @onclick='() => SelectCategory("navigate")'
                            title="Pan">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"></path><path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2"></path><path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8"></path><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"></path></svg>
                        <span>Pan</span>
                    </button>

                    <button type="button"
                            class="tool-btn mobile-tool-btn btn-tool-zone @(_activeCategory == "evac" ? "active" : "")"
                            @onclick='() => SelectCategory("evac")'
                            title="Evac Zone">
                        <span class="category-dot zone-dot"></span>
                        <span>Evac</span>
                    </button>

                    <button type="button"
                            class="tool-btn mobile-tool-btn btn-tool-safe @(_activeCategory == "safe" ? "active" : "")"
                            @onclick='() => SelectCategory("safe")'
                            title="Safe Location">
                        <span class="category-dot safe-dot"></span>
                        <span>Safe</span>
                    </button>

                    <button type="button"
                            class="tool-btn mobile-tool-btn btn-tool-blockade @(_activeCategory == "blockade" ? "active" : "")"
                            @onclick='() => SelectCategory("blockade")'
                            title="Blockade">
                        <span class="category-dot blockade-dot"></span>
                        <span>Block</span>
                    </button>

                    @if (_activeCategory == "evac" || _activeCategory == "safe")
                    {
                        <div class="tool-separator"></div>
                        <div class="shape-toggle-group">
                            <button type="button"
                                    class="shape-btn mobile-shape-btn @(_selectedShape == "polygon" ? "active" : "")"
                                    @onclick='() => SelectShape("polygon")'
                                    title="Polygon">
                                Poly
                            </button>
                            <button type="button"
                                    class="shape-btn mobile-shape-btn @(_selectedShape == "circle" ? "active" : "")"
                                    @onclick='() => SelectShape("circle")'
                                    title="Circle">
                                Circle
                            </button>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Mobile Drawer Toggle Tab -->
        @if (!isMobilePanelOpen)
        {
            <div class="mobile-drawer-toggle">
                <button type="button" class="btn-drawer-toggle" @onclick="ToggleMobilePanel" aria-label="Open Control Panel">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="18 15 12 9 6 15"></polyline>
                    </svg>
                    <span>Open Controls</span>
                </button>
            </div>
        }
    </div>

    <!-- Side Panel Dock / Mobile Drawer -->
    <aside class="side-panel-wrapper @(isMobilePanelOpen ? "drawer-open" : "drawer-closed")">
        <div class="drawer-drag-handle d-md-none" @onclick="ToggleMobilePanel">
            <div class="handle-bar"></div>
        </div>
        <SidePanel
            Mode="@(_isSimulating ? (_isRunning ? "Symulacja" : "Wstrzymana") : "Standby")"
            CensusPopulation="@_censusPopulation"
            CensusCells="@_censusCells"
            IsSimulating="@_isSimulating"
            EvacuatedCount="@(_engine?.EvacuatedCount ?? 0)"
            TotalSimulatedAgents="@_simTotalAgents"
            SimulationTime="@(_engine?.SimulationTime ?? 0)"
            TimeScale="@_simConfig.TimeScale"
            Unlimited="@_simConfig.Unlimited"
            OnStartSimulation="HandleStartSimulation"
            OnStartEvacuation="HandleStartSimulation"
            OnConfigureSimulation="() => _isConfigOpen = true"
            OnOpenStatistics="() => _isStatsOpen = true"
            OnClose="ToggleMobilePanel" />
    </aside>

    <!-- Scenario Modals -->
    <CreateBranchModal
        IsOpen="@_isCreateBranchOpen"
        ParentSession="@_branchParentSession"
        OnBranchCreated="HandleBranchCreated"
        OnClose="() => _isCreateBranchOpen = false" />

    <SessionTreeModal
        IsOpen="@_isTreeMapOpen"
        OnCheckoutSession="HandleCheckoutSession"
        OnRequestBranch="HandleRequestBranchFromTree"
        OnClose="() => _isTreeMapOpen = false" />

    <!-- Simulation & Evacuation Configuration Modal -->
    <SimulationConfigModal
        IsOpen="@_isConfigOpen"
        Config="@_simConfig"
        CensusPopulation="@_censusPopulation"
        OnSave="HandleSaveConfig"
        OnStartSimulation="HandleStartSimulation"
        OnClose="() => _isConfigOpen = false" />

    <!-- Evacuation Statistics & Analytics Popup -->
    <StatisticsPopup
        IsOpen="_isStatsOpen"
        OnClose="() => _isStatsOpen = false"
        Stats="@(_isSimulating ? _statsCollector.Stats : _sampleStats)"
        IsLive="@_isSimulating" />
</div>

@code {
    private string MapContainerId { get; set; } = $"map-{Guid.NewGuid():N}";
    private bool isMobilePanelOpen = false;
    private bool isMapInitialized = false;
    private DotNetObjectReference<EvacuationMap>? _dotNetRef;

    private List<MapZoneItem> _mapItems = new();
    private MapSession? _activeSession;
    private List<MapSession> _allSessions = new();
    private MapSession? _branchParentSession;
    private bool _isCreateBranchOpen = false;
    private bool _isTreeMapOpen = false;
    private bool _isStatsOpen = false;
    private readonly PlanSafe.Contracts.Models.Stats.SimulationLiveStats _sampleStats = PlanSafe.App.Simulation.SimulationStatsCollector.CreateSampleData();

    // On-Map Crowd Simulation Engine State
    private ElementReference _simCanvasRef;
    private string SimCanvasId { get; set; } = $"sim-canvas-{Guid.NewGuid():N}";
    private bool _isConfigOpen = false;
    private bool _isSimulating = false;
    private bool _isRunning = false;
    private int _simTotalAgents = 0;
    private SimulationConfig _simConfig = new();
    private CrowdSimulationEngine? _engine;
    private CancellationTokenSource? _simCts;
    private readonly SimulationStatsCollector _statsCollector = new();
    private IJSObjectReference? _simModule;
    private IJSObjectReference? _simulator;
    private string? _simWarningMessage;

    private string _activeCategory = "navigate"; // "navigate", "evac", "safe", "blockade"
    private string _selectedShape = "polygon"; // "polygon", "circle"
    private string _activeDrawMode = "none";
    private string? _activeDrawHint;
    private int _currentPointCount = 0;
    private int _censusPopulation = 0;
    private int _censusCells = 0;

    private bool _disposed = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isMapInitialized && !_disposed)
        {
            isMapInitialized = true;
            await CensusService.EnsureLoadedAsync();
            if (_disposed) return;
            _ = OsmService.EnsureLoadedAsync();

            _activeSession = await SessionService.GetActiveSessionAsync();
            if (_disposed) return;

            _allSessions = await SessionService.GetAllSessionsAsync();
            if (_disposed) return;

            _branchParentSession = _activeSession;
            _simConfig = _activeSession.SimulationConfig?.Clone() ?? new SimulationConfig();

            double lat = _activeSession.MapCenter is { Length: >= 2 } ? _activeSession.MapCenter[0] : 50.0614;
            double lng = _activeSession.MapCenter is { Length: >= 2 } ? _activeSession.MapCenter[1] : 19.9366;
            int zoom = _activeSession.ZoomLevel > 0 ? _activeSession.ZoomLevel : 14;

            _dotNetRef = DotNetObjectReference.Create(this);
            if (_disposed)
            {
                _dotNetRef.Dispose();
                _dotNetRef = null;
                return;
            }

            try
            {
                await MapInterop.InitializeMapAsync(MapContainerId, lat, lng, zoom, _dotNetRef);
            }
            catch (Exception) when (_disposed)
            {
                return;
            }

            if (_disposed) return;

            try
            {
                await MapInterop.LoadSessionItemsAsync(MapContainerId, _activeSession.Items, lat, lng, zoom);
            }
            catch (Exception) when (_disposed)
            {
                return;
            }

            if (_disposed) return;

            _mapItems = _activeSession.Items;

            RecalculateCensusData();
            if (_simConfig.UseGusCensus && _censusPopulation > 0)
            {
                _simConfig.AgentCount = _censusPopulation;
            }
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnItemsUpdated(string itemsJson)
    {
        if (_disposed) return;
        try
        {
            if (!string.IsNullOrWhiteSpace(itemsJson))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                _mapItems = JsonSerializer.Deserialize<List<MapZoneItem>>(itemsJson, options) ?? new();
            }
            else
            {
                _mapItems.Clear();
            }

            if (_activeSession != null)
            {
                _activeSession.Items = _mapItems;
                await SessionService.SaveSessionAsync(_activeSession);
                if (_disposed) return;
                _allSessions = await SessionService.GetAllSessionsAsync();
            }

            if (_disposed) return;
            RecalculateCensusData();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PlanSafe] Error deserializing map items: {ex.Message}");
        }
    }

    private async Task HandleCheckoutSession(MapSession session)
    {
        _activeSession = session;
        _branchParentSession = session;
        _mapItems = session.Items;
        _isTreeMapOpen = false;

        double lat = session.MapCenter is { Length: >= 2 } ? session.MapCenter[0] : 50.0614;
        double lng = session.MapCenter is { Length: >= 2 } ? session.MapCenter[1] : 19.9366;
        int zoom = session.ZoomLevel > 0 ? session.ZoomLevel : 14;

        await MapInterop.LoadSessionItemsAsync(MapContainerId, session.Items, lat, lng, zoom);
        RecalculateCensusData();
        StateHasChanged();
    }

    private async Task HandleSelectSessionById(string sessionId)
