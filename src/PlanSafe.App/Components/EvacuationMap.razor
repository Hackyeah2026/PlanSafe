@namespace PlanSafe.App.Components
@using PlanSafe.Contracts.Models.Map

<div class="map-module-layout ui-workspace @(_isSimulating ? "simulating" : "") @(_isStarting ? "simulation-preparing" : "") @(_isMobilePanelOpen ? "panel-open" : "")"
     aria-busy="@_isStarting.ToString().ToLowerInvariant()">
    <span class="simulation-preparation-cursor" aria-hidden="true"></span>
    <!-- Map Canvas Area -->
    <div class="map-area">
        <div id="@MapContainerId" class="map-viewport">
            <canvas id="@SimCanvasId" @ref="_simulationCanvas"
                    class="map-simulation-canvas @(_isSimulating ? "active" : "")"></canvas>
        </div>

        @if (_simulationWarningMessage is not null)
        {
            <div class="sim-warning-toast surface-panel" role="status">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                <span>@(_simulationWarningMessage?.Invoke())</span>
                <button type="button" class="btn-toast-close" aria-label="@L.Simulation.DismissMessage" @onclick="() => _simulationWarningMessage = null">&times;</button>
            </div>
        }

        @if (_isSimulating || _isStarting)
        {
            <SimulationControlBar
                IsRunning="@_isRunning"
                IsBusy="@_isStarting"
                Engine="@_activeEngine"
                SimulationTime="@_statsCollector.Stats.SimulationTime"
                EvacuatedCount="@_statsCollector.Stats.EvacuatedAgents"
                TotalAgents="@_totalSimulationAgents"
                RenderMode="@_simulationConfig.RenderMode"
                ShowWhiskers="@_simulationConfig.ShowWhiskers"
                TimeScale="@_simulationConfig.TimeScale"
                Unlimited="@_simulationConfig.Unlimited"
                OnToggle="ToggleSimulation"
                OnStep="StepSimulation"
                OnReset="ResetSimulation"
                OnRenderModeChanged="HandleRenderModeChanged"
                OnToggleWhiskers="HandleToggleWhiskers"
                OnCycleSpeed="HandleCycleSpeed"
                OnOpenStats="() => _isStatsOpen = true"
                OnExit="StopSimulation" />
        }

        @if (_tourPreview)
        {
            @* Tour-only illustration: no simulation state or action callbacks are connected. *@
            <div class="map-tour-controls-preview" hidden inert aria-hidden="true">
                <SimulationControlBar />
            </div>
        }

        <div class="map-drawing-toolbar">
            <AppButton Class="map-tour-replay" OnClick="ReplayMapTour" Disabled='@(!_tourReady || _isStarting || _isSimulating || _tourPreview || _activeDrawMode != "none")' aria-label="@L.Tour.Replay">? <span>@L.Tour.Replay</span></AppButton>
            <MapDrawingTools TourPreview="@_tourPreview" Category="@_activeCategory" Shape="@_selectedShape" DrawMode="@_activeDrawMode"
                             Hint="@_activeDrawHint" PointCount="@_currentPointCount"
                             OnCategory="SelectCategory" OnShape="SelectShape" OnFinish="FinishPolygon" OnCancel="CancelDrawing" />
        </div>
    </div>

    <aside id="map-control-panel" class="side-panel-wrapper surface-panel">
        <SidePanel HasEvacuationZone="@_mapItems.Any(item => item.Category == ZoneCategory.EvacuationZone)"
                   CensusLoaded="@CensusService.IsLoaded"
                   CensusLoading="@_isCensusLoading"
                   CensusPopulation="@_censusPopulation"
                   BranchName='@(_activeSession?.BranchName ?? "main")' Expanded="@_isMobilePanelOpen"
                   IsSimulating="@_isSimulating" EvacuatedCount="@_statsCollector.Stats.EvacuatedAgents"
                   TotalSimulatedAgents="@_totalSimulationAgents" SimulationTime="@_statsCollector.Stats.SimulationTime"
                   OnStartEvacuation="HandleStartEvacuation"
                   OnStartSimulation="HandleStartSimulation" OnConfigureSimulation="() => _isConfigOpen = true"
                   OnScenarios="() => _isTreeMapOpen = true" OnNewBranch="() => _isCreateBranchOpen = true"
                   OnRecenter="HandleRecenter"
                   OnToggle="ToggleMobilePanel" />
    </aside>

    @if (_isPublishPlanOpen)
    {
        <PublishPlanModal IsOpen="true" MapItems="@_mapItems"
                          AgentCount="@PlannedAgentCount"
                          ActiveSession="@_activeSession" WeightDistance="@_simulationConfig.WeightDistance"
                          WeightOccupancy="@_simulationConfig.WeightOccupancy" OnClose="() => _isPublishPlanOpen = false" />
    }

    <!-- Scenario Modals -->
    <CreateBranchModal
        IsOpen="@_isCreateBranchOpen"
        ParentSession="@_branchParentSession"
        OnBranchCreated="HandleBranchCreated"
        OnClose="() => _isCreateBranchOpen = false" />

    <SessionTreeModal
        IsOpen="@_isTreeMapOpen"
        OnCheckoutSession="HandleCheckoutSession"
        OnRequestBranch="HandleRequestBranchFromTree"
        OnClose="() => _isTreeMapOpen = false" />

    <!-- Simulation & Evacuation Configuration Modal -->
    <SimulationConfigModal
        IsOpen="@_isConfigOpen"
        Config="@_simulationConfig"
        CensusPopulation="@_censusPopulation"
        OnSave="HandleSaveConfig"
        OnStartSimulation="HandleStartSimulation"
        OnClose="() => _isConfigOpen = false" />

    <!-- Evacuation Statistics & Analytics Popup -->
    <StatisticsPopup
        IsOpen="_isStatsOpen"
        OnClose="() => _isStatsOpen = false"
        Stats="@_statsCollector.Stats"
        IsLive="@_isSimulating" />
</div>

@code {
    private bool _isPublishPlanOpen;
}
