@using PlanSafe.Contracts.Models.Simulation
@inject IJSRuntime JS

@if (Projector)
{
    <div class="fullscreen-qr-view">
        <button type="button" 
                class="fullscreen-qr-close" 
                data-dialog-close 
                aria-label="@L.Publish.CloseProjector" 
                @onclick="HandleCloseProjector">
            <UiIcon Kind="UiIconKind.Close" />
        </button>
        <div class="fullscreen-qr-frame" role="img" aria-label="@L.Publish.QrLabel">
            @((MarkupString)WrapSvgResponsive(Plan.QrCodeSvg))
        </div>
    </div>
}
else
{
    <div class="plan-share">
        <div class="share-heading">
            <span class="share-status"><UiIcon Kind="UiIconKind.Shield" /> @L.Publish.Ready</span>
            <h3>@L.Publish.Scan</h3>
        </div>
        <div class="share-qr" role="img" aria-label="@L.Publish.QrLabel">@((MarkupString)WrapSvgResponsive(Plan.QrCodeSvg))</div>
        <p class="share-session ui-muted">@L.Publish.CodeLabel <strong>@Plan.SessionId</strong></p>
        <div class="share-link">
            <label for="@linkId">@L.Publish.LinkLabel</label>
            <input id="@linkId" type="text" class="app-input" readonly value="@Plan.EvacuateUrl" />
            <div class="share-actions">
                <AppButton OnClick="CopyUrlAsync">@(copied ? L.Publish.LinkCopied : L.Publish.CopyLink)</AppButton>
                <a class="app-button app-button--primary" href="@Plan.EvacuateUrl" target="_blank" rel="noopener">@L.Publish.NextPerson <UiIcon Kind="UiIconKind.ArrowRight" /></a>
            </div>
            <span class="share-feedback ui-muted" role="status">@(feedback?.Invoke())</span>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public PublishPlanResponse Plan { get; set; } = default!;
    [Parameter] public bool Projector { get; set; }
    [Parameter] public EventCallback OnCloseProjector { get; set; }
    private readonly string linkId = $"plan-link-{Guid.NewGuid():N}";
    private bool copied;
    private Func<string?>? feedback;

    private async Task HandleCloseProjector()
    {
        if (OnCloseProjector.HasDelegate)
        {
            await OnCloseProjector.InvokeAsync();
        }
    }

    private async Task CopyUrlAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Plan.EvacuateUrl);
            copied = true;
            feedback = () => L.Publish.CopySuccess;
        }
        catch (JSException)
        {
            copied = false;
            feedback = () => L.Publish.CopyFailed;
        }
    }

    private static string WrapSvgResponsive(string? svg)
    {
        if (string.IsNullOrWhiteSpace(svg)) return string.Empty;
        return svg.StartsWith("<svg", StringComparison.OrdinalIgnoreCase)
            ? "<svg style=\"width:100%;height:100%;display:block\" " + svg[4..]
            : svg;
    }
}
