@namespace PlanSafe.App.Components

<section class="map-drawing-tools surface-panel" aria-label="@L.Drawing.Tools">
    <div class="drawing-categories" role="group" aria-label="@L.Drawing.Category">
        <AppButton Class="drawing-tool" aria-label="@L.Drawing.Navigate" title="@L.Drawing.Navigate" Pressed='@(Category == "navigate")' OnClick='() => OnCategory.InvokeAsync("navigate")'>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d="M3 10 21 3l-7 18-3-8z" /></svg><span>@L.Drawing.Navigate</span>
        </AppButton>
        <AppButton Class="drawing-tool drawing-tool--zone" aria-label="@L.Drawing.EvacuationZone" title="@L.Map.EvacuationZone" Pressed='@(Category == "evac")' OnClick='() => OnCategory.InvokeAsync("evac")'>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m12 2 10 8-4 12H6L2 10z" /></svg><span>@L.Drawing.EvacuationZone</span>
        </AppButton>
        @if (Category == "evac" || (TourPreview && Category == "navigate"))
        {
            @ShapeChoices
        }
        <AppButton Class="drawing-tool drawing-tool--safe" aria-label="@L.Map.SafeLocation" title="@L.Map.SafeLocation" Pressed='@(Category == "safe")' OnClick='() => OnCategory.InvokeAsync("safe")'>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 9c0 5-7 12-7 12S5 14 5 9a7 7 0 1 1 14 0Z" /><circle cx="12" cy="9" r="2" /></svg><span>@L.Map.SafeLocation</span>
        </AppButton>
        @if (Category == "safe")
        {
            @ShapeChoices
        }
        <AppButton Class="drawing-tool drawing-tool--blockade" aria-label="@L.Map.Blockade" title="@L.Map.Blockade" Pressed='@(Category == "blockade")' OnClick='() => OnCategory.InvokeAsync("blockade")'>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="m12 2 7 18H5zM3 22h18M8 12h8M6 17h12" /></svg><span>@L.Map.Blockade</span>
        </AppButton>
    </div>
</section>
@if (Category != "navigate" && DrawMode != "none")
{
    <div class="drawing-instructions surface-panel" aria-label="@L.Drawing.Instructions">
        <span role="status">@DrawingHint</span>
        <div class="drawing-instruction-actions">
            @if ((DrawMode is "evac_polygon" or "safe_polygon" or "polygon") && PointCount >= 3)
            {
                <AppButton Class="drawing-finish" OnClick="OnFinish">@L.Drawing.Done</AppButton>
            }
            <AppButton OnClick="OnCancel">@L.Drawing.Cancel</AppButton>
        </div>
    </div>
}

@code {
    // Hint identifiers arrive from the JavaScript drawing controller.
    private string DrawingHint => Hint switch
    {
        "Drawing.BlockadeEnd" => L.Drawing.BlockadeEnd,
        "Drawing.RadiusHint" => L.Drawing.RadiusHint,
        "Drawing.FirstPoint" => L.Drawing.FirstPoint,
        "Drawing.SecondPoint" => L.Drawing.SecondPoint,
        "Drawing.PolygonAdded" => L.Drawing.PolygonAdded,
        "Drawing.PolygonVertices" => L.Drawing.PolygonVertices(PointCount),
        "Drawing.EvacuationCenter" => L.Drawing.EvacuationCenter,
        "Drawing.EvacuationPolygon" => L.Drawing.EvacuationPolygon,
        "Drawing.SafeCenter" => L.Drawing.SafeCenter,
        "Drawing.SafePolygon" => L.Drawing.SafePolygon,
        "Drawing.BlockadeStart" => L.Drawing.BlockadeStart,
        _ => L.Drawing.ShapeHint
    };

    private RenderFragment ShapeChoices => @<div role="group" aria-label="@L.Drawing.Shape" class="drawing-shapes">
        <AppButton data-map-tour="polygon" aria-label="@L.Drawing.Polygon" title="@L.Drawing.Polygon" Pressed='@(Shape == "polygon")' OnClick='() => OnShape.InvokeAsync("polygon")'>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m12 2 10 8-4 12H6L2 10z" /></svg><span>@L.Drawing.Polygon</span>
        </AppButton>
        <AppButton data-map-tour="circle" aria-label="@L.Drawing.Circle" title="@L.Drawing.Circle" Pressed='@(Shape == "circle")' OnClick='() => OnShape.InvokeAsync("circle")'>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /></svg><span>@L.Drawing.Circle</span>
        </AppButton>
    </div>;
    [Parameter] public bool TourPreview { get; set; }
    [Parameter] public string Category { get; set; } = "navigate";
    [Parameter] public string Shape { get; set; } = "polygon";
    [Parameter] public string DrawMode { get; set; } = "none";
    [Parameter] public string? Hint { get; set; }
    [Parameter] public int PointCount { get; set; }
    [Parameter] public EventCallback<string> OnCategory { get; set; }
    [Parameter] public EventCallback<string> OnShape { get; set; }
    [Parameter] public EventCallback OnFinish { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
