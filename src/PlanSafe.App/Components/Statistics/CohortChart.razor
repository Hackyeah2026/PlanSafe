@namespace PlanSafe.App.Components.Statistics
@using PlanSafe.Contracts.Models.Stats
@using static PlanSafe.App.Components.Statistics.ChartGeometry
@{
    var (maximum, ticks) = Stats.GetCohortYScale();
    float slotWidth = 690f / Math.Max(10, Stats.Cohorts.Count);
}
<div class="chart-wrapper">
<svg viewBox="0 0 780 360" class="stat-svg" role="img" aria-label="@L.Statistics.CohortDescription">
    <text x="390" y="22" text-anchor="middle" class="svg-title">@L.Statistics.CohortTitle</text>
    <defs>
        @for (int i = 0; i < BarColors.Length; i++)
        {
            <linearGradient id="cohort-gradient-@i" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="@BarColors[i].Start" /><stop offset="100%" stop-color="@BarColors[i].End" />
            </linearGradient>
        }
        <linearGradient id="cohort-active" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#38bdf8" /><stop offset="50%" stop-color="#0ea5e9" /><stop offset="100%" stop-color="#0284c7" /></linearGradient>
    </defs>
    @foreach (var tick in ticks)
    {
        <line x1="65" y1="@F(Y(tick, maximum))" x2="755" y2="@F(Y(tick, maximum))" class="chart-grid" stroke-dasharray="3,3" />
        <g><text x="55" y="@F(Y(tick, maximum) + 4)" text-anchor="end">@tick.ToString("0.0#")</text></g>
    }
    @for (int i = 0; i < 10; i++)
    {
        var cohort = i < Stats.Cohorts.Count ? Stats.Cohorts[i] : null;
        float center = 65 + slotWidth * i + slotWidth / 2;
        float barWidth = Math.Min(58, slotWidth * .65f);
        float minutes = cohort?.DisplayMinutes ?? 0;
        float height = minutes > .0001f ? Math.Clamp(Math.Max(8, minutes / maximum * 262), 0, 262) : 0;
        bool active = !(cohort?.IsCompleted ?? false) && cohort?.CurrentElapsedSeconds > 0;
        <rect x="@F(center - barWidth / 2)" y="@F(302 - Math.Max(4, height))" width="@F(barWidth)" height="@F(Math.Max(4, height))" rx="4" fill="@((cohort?.IsCompleted ?? false) ? $"url(#cohort-gradient-{i})" : active ? "url(#cohort-active)" : "var(--ui-fill)")" stroke="@((cohort?.IsCompleted ?? false) || active ? "#0a84ff" : "var(--ui-border)")" />
        @if ((cohort?.IsCompleted ?? false) || active)
        {
            <g><text x="@F(center)" y="@F(296 - height)" text-anchor="middle" class="svg-bar-value">@cohort!.FormattedDuration</text></g>
        }
        <g><text x="@F(center)" y="320" text-anchor="middle">@(cohort?.CohortLabel ?? $"{i * 10}–{(i + 1) * 10}%")</text></g>
    }
    <text x="18" y="175" transform="rotate(-90 18 175)" text-anchor="middle">@L.Statistics.CohortDuration</text>
    <text x="410" y="350" text-anchor="middle">@L.Statistics.PopulationCohort</text>
</svg>
<p class="chart-legend">@(L.Statistics.CompletedCohorts(Stats.Cohorts.Count(c => c.IsCompleted), Stats.EvacuationPercent))</p>
</div>
@code {
    [Parameter] public SimulationLiveStats Stats { get; set; } = new();
    private static readonly (string Start, string End)[] BarColors =
    {
        ("#38bdf8", "#0284c7"), ("#60a5fa", "#2563eb"), ("#3b82f6", "#1d4ed8"),
        ("#2563eb", "#1e40af"), ("#1d4ed8", "#1e3a8a"), ("#1e40af", "#172554"),
        ("#2563eb", "#0369a1"), ("#1d4ed8", "#0284c7"), ("#1e3a8a", "#0369a1"), ("#0369a1", "#0284c7")
    };
}
