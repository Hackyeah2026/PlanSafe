@namespace PlanSafe.App.Components.Statistics
@using PlanSafe.Contracts.Models.Stats
@using static PlanSafe.App.Components.Statistics.ChartGeometry
@{
    var maxTime = Math.Max(60f, Stats.GetMaxTimeSeconds());
    var (maximum, ticks) = Stats.GetDensityYScale();
    var paths = Paths(Stats.DensityHistory.Select(p => (p.TimeSeconds, p.Plus1Sigma, p.Minus1Sigma, p.MeanDensity)), maxTime, maximum);
}
<div class="chart-wrapper">
<svg viewBox="0 0 780 360" class="stat-svg" role="img" aria-label="Crowd density profile with standard deviation">
    <text x="390" y="22" text-anchor="middle" class="svg-title">3. Crowd Density Profile: μ(t) ± σ</text>
    @foreach (var tick in ticks)
    {
        <line x1="65" y1="@F(Y(tick, maximum))" x2="755" y2="@F(Y(tick, maximum))" class="chart-grid" stroke-dasharray="3,3" />
        <g><text x="55" y="@F(Y(tick, maximum) + 4)" text-anchor="end">@tick.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</text></g>
    }
    @foreach (var reference in new[] { (.5f, "#1a7f45"), (2f, "#c46508"), (3.5f, "#d32f2f") })
    {
        <line x1="65" y1="@F(Y(reference.Item1, maximum))" x2="755" y2="@F(Y(reference.Item1, maximum))" stroke="@reference.Item2" stroke-dasharray="4,4" />
    }
    @for (int time = 0; time <= maxTime; time += maxTime <= 120 ? 20 : maxTime <= 300 ? 60 : 120)
    {
        <g><text x="@F(X(time, maxTime))" y="320" text-anchor="middle">@(time)s</text></g>
    }
    @if (Stats.DensityHistory.Count > 1)
    {
        <path d="@paths.Band" fill="url(#density-band)" stroke="#0284c7" stroke-opacity=".4" />
        <path d="@paths.Mean" fill="none" stroke="url(#density-line)" stroke-width="2.6" stroke-linejoin="round" />
    }
    <defs>
        <linearGradient id="density-band" x1="0%" y1="100%" x2="0%" y2="0%"><stop offset="0%" stop-color="#4662d8" stop-opacity=".45" /><stop offset="40%" stop-color="#1ae4b6" stop-opacity=".6" /><stop offset="80%" stop-color="#faba39" stop-opacity=".75" /><stop offset="100%" stop-color="#d73027" stop-opacity=".85" /></linearGradient>
        <linearGradient id="density-line" x1="0%" y1="100%" x2="0%" y2="0%"><stop offset="0%" stop-color="#4662d8" /><stop offset="40%" stop-color="#1ae4b6" /><stop offset="80%" stop-color="#faba39" /><stop offset="100%" stop-color="#f14424" /></linearGradient>
    </defs>
    <text x="18" y="175" transform="rotate(-90 18 175)" text-anchor="middle">Density [ped/m²]</text>
    <text x="410" y="350" text-anchor="middle">Time Elapsed Since Alarm [s]</text>
</svg>
<p class="chart-legend">Band: μ ± σ · Line: μ(t) · Free flow 0.5 ped/m² · Queue 2.0 ped/m² · Critical 3.5 ped/m²</p>
</div>
@code { [Parameter] public SimulationLiveStats Stats { get; set; } = new(); }
