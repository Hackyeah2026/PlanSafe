@namespace PlanSafe.App.Components.Statistics
@using PlanSafe.Contracts.Models.Stats
@using static PlanSafe.App.Components.Statistics.ChartGeometry
@{
    var references = new[] { (1.1f, "#1a7f45", L.Statistics.Freeflow), (.6f, "#c46508", L.Statistics.Bottleneck), (.2f, "#d32f2f", L.Statistics.Jam) };
    var maxTime = Math.Max(60f, Stats.GetMaxTimeSeconds());
    var (maximum, ticks) = Stats.GetSpeedYScale();
    var paths = Paths(Stats.SpeedHistory.Select(p => (p.TimeSeconds, p.Plus1Sigma, p.Minus1Sigma, p.MeanSpeed)), maxTime, maximum);
}
<div class="chart-wrapper">
<svg viewBox="0 0 780 360" class="stat-svg" role="img" aria-label="@L.Statistics.SpeedDescription">
    <text x="390" y="22" text-anchor="middle" class="svg-title">@L.Statistics.SpeedTitle</text>
    @foreach (var tick in ticks)
    {
        <line x1="65" y1="@F(Y(tick, maximum))" x2="755" y2="@F(Y(tick, maximum))" class="chart-grid" stroke-dasharray="3,3" />
        <g><text x="55" y="@F(Y(tick, maximum) + 4)" text-anchor="end">@tick.ToString("0.0")</text></g>
    }
    @foreach (var reference in references)
    {
        <line x1="65" y1="@F(Y(reference.Item1, maximum))" x2="755" y2="@F(Y(reference.Item1, maximum))" stroke="@reference.Item2" stroke-dasharray="4,4" />
    }
    @for (int time = 0; time <= maxTime; time += maxTime <= 120 ? 20 : maxTime <= 300 ? 60 : 120)
    {
        <g><text x="@F(X(time, maxTime))" y="320" text-anchor="middle">@(time)s</text></g>
    }
    @if (Stats.SpeedHistory.Count > 1)
    {
        <path d="@paths.Band" fill="#38bdf8" fill-opacity=".2" />
        <path d="@paths.Mean" fill="none" stroke="#38bdf8" stroke-width="2.6" stroke-linejoin="round" />
    }
    <text x="18" y="175" transform="rotate(-90 18 175)" text-anchor="middle">@L.Statistics.SpeedAxis</text>
    <text x="410" y="350" text-anchor="middle">@L.Statistics.TimeAxis</text>
</svg>
<ProfileChartLegend MeanLabel="@L.Statistics.AverageSpeed" References="references" />
</div>
@code { [Parameter] public SimulationLiveStats Stats { get; set; } = new(); }
