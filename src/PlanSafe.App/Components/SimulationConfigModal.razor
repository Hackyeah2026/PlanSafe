@namespace PlanSafe.App.Components

<ModalDialog Width="720px" IsOpen="IsOpen" Class="sim-config-dialog" LabelledBy="sim-config-title">
    @if (IsOpen)
    {
        <div class="sim-config-modal-card" @onclick:stopPropagation>
            <!-- Modal Header -->
            <div class="feature-dialog-header sim-config-modal-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="config-icon-box">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                    </div>
                    <div>
                        <h2 id="sim-config-title" class="sim-config-title">@L.Simulation.SettingsTitle</h2>
                        <div class="sim-config-subtitle">@L.Simulation.SettingsDescription</div>
                    </div>
                </div>
                <button type="button" class="app-button app-icon-button" data-dialog-close @onclick="Close" aria-label="@L.Common.Close">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="feature-dialog-body sim-config-modal-body">
                <div class="row g-3">
                    <!-- Column 1: Populacja & Dynamika -->
                    <div class="col-md-6">
                        <!-- Sekcja 1: Populacja & Agenci -->
                        <div class="config-section-card mb-3">
                            <h6 class="config-section-header">
                                <span class="section-dot dot-cyan"></span> @L.Simulation.PopulationSettings
                            </h6>

                            <div class="mb-3">
                                <label class="form-label small text-muted d-block mb-1">@L.Census.Source</label>
                                <div class="btn-group w-100 btn-group-sm" role="group">
                                    <button type="button" class="btn @(_localConfig.UseGusCensus ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SetCensusMode(true)">
                                        @(L.Census.SourcePopulation(CensusPopulation))
                                    </button>
                                    <button type="button" class="btn @(!_localConfig.UseGusCensus ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SetCensusMode(false)">
                                        @L.Census.CustomCount
                                    </button>
                                </div>
                            </div>

                            @if (!_localConfig.UseGusCensus)
                            {
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1 small">
                                        <span class="text-muted">@L.Simulation.AgentCountLabel</span>
                                        <span class="config-value">@_localConfig.AgentCount</span>
                                    </div>
                                    <input type="range" aria-label="@L.Simulation.AgentCount" class="form-range" min="50" max="50000" step="50" @bind="_localConfig.AgentCount" />
                                    <div class="d-flex justify-content-between text-muted" style="font-size: 0.65rem;">
                                        <span>50</span>
                                        <span>10 000</span>
                                        <span>25 000</span>
                                        <span>50 000</span>
                                    </div>
                                </div>
                            }

                        </div>

                        <!-- Sekcja 2: Tempo i Wydajność -->
                        <div class="config-section-card">
                            <h6 class="config-section-header">
                                <span class="section-dot dot-yellow"></span> @L.Simulation.SpeedSettings
                            </h6>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1 small">
                                    <span class="text-muted">@L.Simulation.SpeedLabel</span>
                                    <span class="config-value">@(_localConfig.Unlimited ? L.Simulation.Unlimited : $"{_localConfig.TimeScale.ToString("F1")}×")</span>
                                </div>
                                <input type="range" aria-label="@L.Simulation.Speed" class="form-range" min="1.0" max="50.0" step="1.0" disabled="@_localConfig.Unlimited" @bind="_localConfig.TimeScale" />
                                <div class="d-flex justify-content-between text-muted" style="font-size: 0.65rem;">
                                    <span>@L.Simulation.RealTime</span>
                                    <span>25.0×</span>
                                    <span>50.0×</span>
                                </div>
                                <div class="form-check form-switch mt-2">
                                    <input id="modal-unlimited" class="form-check-input" type="checkbox" @bind="_localConfig.Unlimited" />
                                    <label class="form-check-label small" for="modal-unlimited">@L.Simulation.UnlimitedOption</label>
                                </div>
                            </div>

                            <div class="mb-2">
                                <label class="form-label small text-muted mb-1" for="modal-fps">@L.Simulation.FpsLimit</label>
                                <select id="modal-fps" class="form-select form-select-sm" @bind="_localConfig.RenderFps">
                                    <option value="15">15 FPS</option>
                                    <option value="30">30 FPS</option>
                                    <option value="60">60 FPS</option>
                                    <option value="display">@L.Simulation.DisplayRefreshOption</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Column 2: Balansowanie Schronów & Wizualizacja -->
                    <div class="col-md-6">
                        <!-- Sekcja 3: Moduł 2 Dystrybucja Schronów -->
                        <div class="config-section-card mb-3">
                            <h6 class="config-section-header">
                                <span class="section-dot dot-green"></span> @L.Shelter.AllocationTitle
                            </h6>

                            <div class="mb-2">
                                <label class="form-label small text-muted mb-1 d-block">@L.Shelter.Presets</label>
                                <div class="btn-group w-100 btn-group-sm mb-2" role="group">
                                    <button type="button" class="btn @(Math.Abs(_localConfig.WeightDistance - 1.0) < 0.05 && Math.Abs(_localConfig.WeightOccupancy) < 0.05 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SetScenario(1.0, 0.0)">
                                        @L.Shelter.PresetA
                                    </button>
                                    <button type="button" class="btn @(Math.Abs(_localConfig.WeightDistance - 0.5) < 0.05 && Math.Abs(_localConfig.WeightOccupancy - 0.5) < 0.05 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SetScenario(0.5, 0.5)">
                                        @L.Shelter.PresetB
                                    </button>
                                    <button type="button" class="btn @(Math.Abs(_localConfig.WeightDistance - 0.2) < 0.05 && Math.Abs(_localConfig.WeightOccupancy - 0.8) < 0.05 ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SetScenario(0.2, 0.8)">
                                        @L.Shelter.PresetC
                                    </button>
                                </div>
                            </div>

                            <!-- Proporcja Wag -->
                            <div class="weight-summary mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1 small">
                                    <span class="text-muted">@L.Shelter.WeightsLabel</span>
                                    <span>
                                        <strong class="text-info">@((_localConfig.WeightDistance * 100).ToString("F0"))%</strong>
                                        <span class="text-muted"> / </span>
                                        <strong class="text-warning">@((_localConfig.WeightOccupancy * 100).ToString("F0"))%</strong>
                                    </span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-info" role="progressbar" style="width: @((_localConfig.WeightDistance * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                                    <div class="progress-bar bg-warning" role="progressbar" style="width: @((_localConfig.WeightOccupancy * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                                </div>
                                <div class="d-flex justify-content-between text-muted mt-1" style="font-size: 0.65rem;">
                                    <span class="text-info">@L.Shelter.DistanceArrow</span>
                                    <span class="text-warning">@L.Shelter.OccupancyArrow</span>
                                </div>
                            </div>

                            <!-- Suwak Wagi Odległości -->
                            <div class="mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-1 small">
                                    <span class="text-info fw-semibold">@L.Shelter.DistanceLabel</span>
                                    <span class="config-value">@_localConfig.WeightDistance.ToString("F2")</span>
                                </div>
                                <input type="range" aria-label="@L.Shelter.DistanceWeight" class="form-range" min="0" max="1" step="0.01" value="@_localConfig.WeightDistance.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" @oninput="OnWeightDistInput" />
                            </div>

                            <!-- Suwak Wagi Obłożenia -->
                            <div class="mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-1 small">
                                    <span class="text-warning fw-semibold">@L.Shelter.OccupancyLabel</span>
                                    <span class="config-value">@_localConfig.WeightOccupancy.ToString("F2")</span>
                                </div>
                                <input type="range" aria-label="@L.Shelter.OccupancyWeight" class="form-range" min="0" max="1" step="0.01" value="@_localConfig.WeightOccupancy.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" @oninput="OnWeightOccInput" />
                            </div>
                        </div>

                        <!-- Sekcja 4: Wizualizacja -->
                        <div class="config-section-card">
                            <h6 class="config-section-header">
                                <span class="section-dot dot-purple"></span> @L.Simulation.DisplayMode
                            </h6>

                            <div class="mb-3">
                                <label class="form-label small text-muted mb-1" for="modal-render-mode">@L.Simulation.MapDisplay</label>
                                <select id="modal-render-mode" class="form-select form-select-sm" @bind="_localConfig.RenderMode">
                                    <option value="agents">@L.Simulation.StreetPositions</option>
                                    <option value="heatmap">@L.Simulation.SpeedMap</option>
                                    <option value="density">@L.Simulation.DensityMap</option>
                                </select>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="feature-dialog-footer sim-config-modal-footer">
                <button type="button" class="app-button" @onclick="ResetToDefaults">
                    @L.Simulation.Defaults
                </button>
                <div class="d-flex gap-2">
                    <button type="button" class="app-button" @onclick="Close">
                        @L.Common.Cancel
                    </button>
                    <button type="button" class="app-button" @onclick="SaveAndClose">
                        @L.Common.Save
                    </button>
                    <button type="button" class="app-button app-button--primary" @onclick="SaveAndStart">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                            <polygon points="5 3 19 12 5 21 5 3"></polygon>
                        </svg>
                        <span>@L.Simulation.StartAction</span>
                    </button>
                </div>
            </div>
        </div>
    }
</ModalDialog>
