            px = Math.Clamp(px, padL, padL + chartW);

            if (i == 0) band2.Append($"M {px.ToString("0.0", CultureInfo.InvariantCulture)} {py.ToString("0.0", CultureInfo.InvariantCulture)}");
            else band2.Append($" L {px.ToString("0.0", CultureInfo.InvariantCulture)} {py.ToString("0.0", CultureInfo.InvariantCulture)}");
        }
        for (int i = data.Count - 1; i >= 0; i--)
        {
            float px = padL + (data[i].TimeSeconds / maxT) * chartW;
            float val = Math.Clamp(data[i].Minus2Sigma, 0f, maxD);
            float py = padT + chartH - (val / maxD) * chartH;
            px = Math.Clamp(px, padL, padL + chartW);
            band2.Append($" L {px.ToString("0.0", CultureInfo.InvariantCulture)} {py.ToString("0.0", CultureInfo.InvariantCulture)}");
        }
        band2.Append(" Z");

        // Band 1 (+-1 sigma)
        for (int i = 0; i < data.Count; i++)
        {
            float px = padL + (data[i].TimeSeconds / maxT) * chartW;
            float val = Math.Clamp(data[i].Plus1Sigma, 0f, maxD);
            float py = padT + chartH - (val / maxD) * chartH;
            px = Math.Clamp(px, padL, padL + chartW);

            if (i == 0) band1.Append($"M {px.ToString("0.0", CultureInfo.InvariantCulture)} {py.ToString("0.0", CultureInfo.InvariantCulture)}");
            else band1.Append($" L {px.ToString("0.0", CultureInfo.InvariantCulture)} {py.ToString("0.0", CultureInfo.InvariantCulture)}");
        }
        for (int i = data.Count - 1; i >= 0; i--)
        {
            float px = padL + (data[i].TimeSeconds / maxT) * chartW;
            float val = Math.Clamp(data[i].Minus1Sigma, 0f, maxD);
            float py = padT + chartH - (val / maxD) * chartH;
            px = Math.Clamp(px, padL, padL + chartW);
            band1.Append($" L {px.ToString("0.0", CultureInfo.InvariantCulture)} {py.ToString("0.0", CultureInfo.InvariantCulture)}");
        }
        band1.Append(" Z");

        // Mean line
        for (int i = 0; i < data.Count; i++)
        {
            float px = padL + (data[i].TimeSeconds / maxT) * chartW;
            float val = Math.Clamp(data[i].MeanDensity, 0f, maxD);
            float py = padT + chartH - (val / maxD) * chartH;
            px = Math.Clamp(px, padL, padL + chartW);
            lastX = px;
            lastY = py;

            if (i == 0) meanLine.Append($"M {px.ToString("0.0", CultureInfo.InvariantCulture)} {py.ToString("0.0", CultureInfo.InvariantCulture)}");
            else meanLine.Append($" L {px.ToString("0.0", CultureInfo.InvariantCulture)} {py.ToString("0.0", CultureInfo.InvariantCulture)}");
        }

        return (band2.ToString(), band1.ToString(), meanLine.ToString(), lastX, lastY);
    }
}
