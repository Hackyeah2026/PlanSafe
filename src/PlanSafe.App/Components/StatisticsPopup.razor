@namespace PlanSafe.App.Components
@using System.Globalization
@using PlanSafe.App.Components.Statistics

@if (IsOpen)
{
    @if (_isDragging)
    {
        <div class="stats-drag-shield"
             @onpointermove="OnDragMove"
             @onpointerup="EndDrag"
             @onpointercancel="EndDrag"></div>
    }

    <div class="stats-floating-overlay ui-workspace" style="@GetOverlayStyle()" role="region" aria-label="@L.Statistics.Title">
        <div class="stats-panel @(_isMinimized ? "minimized" : "") @(_isMaximized ? "maximized" : "")">
            
            <!-- Window Drag & Action Header -->
            <div class="stats-header @(_isDragging ? "is-dragging" : "")" 
                 @onpointerdown="StartDrag" 
                 @onpointermove="OnDragMove" 
                 @onpointerup="EndDrag" 
                 @ondblclick="ToggleMaximize">
                <div class="header-left">
                    <span class="drag-grip" @ondblclick="ResetPosition" @ondblclick:stopPropagation><UiIcon Kind="UiIconKind.Grip" /></span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                    <span class="header-title">@L.Statistics.Title</span>
                    
                    @if (IsLive)
                    {
                        @if (Stats.IsComplete || (Stats.ActiveAgents == 0 && Stats.SimulationTime > 0))
                        {
                            <span class="live-pill completed">
                                <span class="check-icon">✓</span>
                                @L.Simulation.Ended
                            </span>
                        }
                        else
                        {
                            <span class="live-pill live">
                                <span class="pulse-dot"></span>
                                @L.Simulation.Live
                            </span>
                        }
                    }
                    else
                    {
                        <span class="live-pill sample">
                            @L.Demo.SampleData
                        </span>
                    }
                </div>

                <div class="header-actions" @onmousedown:stopPropagation @onpointerdown:stopPropagation @ondblclick:stopPropagation>
                    <button type="button" class="btn-stat-action" @onclick="ToggleMinimize" aria-label="@(_isMinimized ? L.Common.Expand : L.Common.Minimize)" title="@(_isMinimized ? L.Common.Expand : L.Common.Minimize)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            @if (_isMinimized)
                            {
                                <polyline points="4 14 12 6 20 14"></polyline>
                            }
                            else
                            {
                                <polyline points="4 10 12 18 20 10"></polyline>
                            }
                        </svg>
                    </button>
                    <button type="button" class="btn-stat-action" @onclick="ToggleMaximize" aria-label="@(_isMaximized ? L.Common.Restore : L.Common.Maximize)" title="@(_isMaximized ? L.Common.Restore : L.Common.Maximize)">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            @if (_isMaximized)
                            {
                                <rect x="3" y="3" width="18" height="18" rx="2" stroke-dasharray="3 3"></rect>
                            }
                            else
                            {
                                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                            }
                        </svg>
                    </button>
                    <button type="button" class="btn-stat-action" @onclick="ResetPosition" aria-label="@L.Statistics.ResetPosition" title="@L.Statistics.ResetPosition"><UiIcon Kind="UiIconKind.Reset" /></button>
                    <button type="button" class="btn-stat-action btn-stat-close" @onclick="Close" aria-label="@L.Common.Close" title="@L.Common.Close">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Minimized Summary Bar -->
            @if (_isMinimized)
            {
                <div class="minimized-strip" @onclick="ToggleMinimize">
                    <div class="mini-kpi">
                        <span class="mini-kpi-lbl">@L.Statistics.EvacuatedLabel</span>
                        <span class="mini-kpi-val text-success">@Stats.EvacuatedAgents / @Stats.TotalAgents (@Stats.EvacuationPercent%)</span>
                    </div>
                    <div class="mini-kpi">
                        <span class="mini-kpi-lbl">@L.Statistics.TimeLabel</span>
                        <span class="mini-kpi-val text-light">@Stats.SimulationTime.ToString("0.0")s</span>
                    </div>
                    <div class="mini-kpi">
                        <span class="mini-kpi-lbl">@L.Statistics.MeanSpeedLabel</span>
                        <span class="mini-kpi-val text-info">@Stats.CurrentMeanSpeed.ToString("0.00") m/s</span>
                    </div>
                    <div class="mini-kpi">
                        <span class="mini-kpi-lbl">@L.Statistics.PeakDensityLabel</span>
                        <span class="mini-kpi-val text-warning">@Stats.CurrentPeakDensity.ToString("0.0") @L.Statistics.DensityUnit</span>
                    </div>
                </div>
            }
            else
            {
                <!-- KPI Ribbon -->
                <div class="stats-kpi-bar">
                    <div class="kpi-block border-success">
                        <span class="kpi-label">@L.Statistics.Evacuated</span>
                        <span class="kpi-val text-success">@Stats.EvacuatedAgents / @Stats.TotalAgents (@Stats.EvacuationPercent%)</span>
                    </div>
                    <div class="kpi-block border-primary">
                        <span class="kpi-label">@L.Statistics.SimulationTime</span>
                        <span class="kpi-val text-light">@Stats.SimulationTime.ToString("0.0")s <small class="text-secondary">(@((Stats.SimulationTime / 60f).ToString("0.0"))m)</small></span>
                    </div>
                    <div class="kpi-block border-info">
                        <span class="kpi-label">@L.Statistics.MeanSpeed</span>
                        <span class="kpi-val text-info">@Stats.CurrentMeanSpeed.ToString("0.00") m/s</span>
                    </div>
                    <div class="kpi-block border-warning">
                        <span class="kpi-label">@L.Statistics.DensitySummary</span>
                        <span class="kpi-val text-warning">@Stats.CurrentMeanDensity.ToString("0.0") / @Stats.CurrentPeakDensity.ToString("0.0") @L.Statistics.DensityUnit</span>
                    </div>
                </div>

                <!-- Tab Navigation -->
                <div class="stats-tabs">
                    @if (_isMaximized)
                    {
                        <button type="button" class="tab-btn @(_activeTab == "all" ? "active" : "")" @onclick='() => _activeTab = "all"'>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="tab-icon">
                                <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                                <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                                <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                                <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                            </svg>
                            <span>@L.Statistics.AllCharts</span>
                        </button>
                    }
                    <button type="button" class="tab-btn @(_activeTab == "cohorts" ? "active" : "")" @onclick='() => _activeTab = "cohorts"'>
                        <span class="tab-num">1</span>
                        <span>@L.Statistics.Cohorts</span>
                    </button>
                    <button type="button" class="tab-btn @(_activeTab == "speed" ? "active" : "")" @onclick='() => _activeTab = "speed"'>
                        <span class="tab-num">2</span>
                        <span>@L.Statistics.SpeedProfile</span>
                    </button>
                    <button type="button" class="tab-btn @(_activeTab == "density" ? "active" : "")" @onclick='() => _activeTab = "density"'>
                        <span class="tab-num">3</span>
                        <span>@L.Statistics.DensityBand</span>
                    </button>
                </div>

                <!-- Tab Contents -->
                <div class="stats-content-area @(_activeTab == "all" ? "fs-mode" : "")">
                    @if (_activeTab == "all")
                    {
                        <div class="fullscreen-dashboard">
                            <CohortChart Stats="Stats" />
                            <div class="fs-row-bottom"><SpeedChart Stats="Stats" /><DensityChart Stats="Stats" /></div>
                        </div>
                    }
                    else if (_activeTab == "cohorts") { <CohortChart Stats="Stats" /> }
                    else if (_activeTab == "speed") { <SpeedChart Stats="Stats" /> }
                    else if (_activeTab == "density") { <DensityChart Stats="Stats" /> }
                </div>
            }

        </div>
    </div>
}
