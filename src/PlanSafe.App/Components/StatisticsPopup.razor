                                            <stop offset="25%" stop-color="#28b7e2" stop-opacity="0.55" />
                                            <stop offset="38%" stop-color="#1ae4b6" stop-opacity="0.60" />
                                            <stop offset="50%" stop-color="#63fe62" stop-opacity="0.65" />
                                            <stop offset="63%" stop-color="#bdf838" stop-opacity="0.70" />
                                            <stop offset="75%" stop-color="#faba39" stop-opacity="0.75" />
                                            <stop offset="88%" stop-color="#f56e29" stop-opacity="0.80" />
                                            <stop offset="100%" stop-color="#d73027" stop-opacity="0.85" />
                                        </linearGradient>
                                        <linearGradient id="turboSpeedLine" x1="0%" y1="100%" x2="0%" y2="0%">
                                            <stop offset="0%" stop-color="#4662d8" />
                                            <stop offset="20%" stop-color="#28b7e2" />
                                            <stop offset="40%" stop-color="#1ae4b6" />
                                            <stop offset="60%" stop-color="#63fe62" />
                                            <stop offset="80%" stop-color="#faba39" />
                                            <stop offset="100%" stop-color="#f14424" />
                                        </linearGradient>
                                    </defs>

                                    <!-- X Axis Title -->
                                    @SvgText(sPadL + sChartW / 2f, sSvgH - 12f, "Time Elapsed Since Alarm [s]", "svg-axis-label", "middle")
                                </svg>
                            </div>
                        </div>
                    }

                    @if (_activeTab == "density")
                    {
                        <div class="chart-wrapper">
                            <!-- CHART 3: CROWD DENSITY PROFILE -->
                            @{
                                const float dSvgW = 820f;
                                const float dSvgH = 430f;
                                const float dPadL = 70f;
                                const float dPadR = 30f;
                                const float dPadT = 45f;
                                const float dPadB = 65f;
                                float dChartW = dSvgW - dPadL - dPadR;
                                float dChartH = dSvgH - dPadT - dPadB;
                                float dMaxT = Math.Max(60f, Stats.GetMaxTimeSeconds());
                                var (dMaxD, densityYTicks) = Stats.GetDensityYScale();
                                float critY = dPadT + dChartH - (3.5f / dMaxD) * dChartH;
                                float queueY = dPadT + dChartH - (2.0f / dMaxD) * dChartH;
                                float freeD = dPadT + dChartH - (0.5f / dMaxD) * dChartH;
                            }
                            <div class="chart-container">
                                <svg viewBox="0 0 @F(dSvgW) @F(dSvgH)" class="stat-svg" preserveAspectRatio="xMidYMid meet">
                                    @SvgText(dSvgW / 2f, 24f, "Mean Crowd Density Profile on Evacuation Routes: μ(t) ± σ", "svg-title", "middle")

                                    <!-- Y Ticks -->
                                    @foreach (var d in densityYTicks)
                                    {
                                        float y = dPadT + dChartH - (d / dMaxD) * dChartH;
                                        <line x1="@F(dPadL)" y1="@F(y)" x2="@F(dSvgW - dPadR)" y2="@F(y)" stroke="rgba(255,255,255,0.08)" stroke-dasharray="3,3" />
                                        @SvgText(dPadL - 10f, y + 4f, d.ToString(), "svg-tick", "end")
                                    }

                                    <!-- Threshold Reference Lines -->
                                    <line x1="@F(dPadL)" y1="@F(critY)" x2="@F(dSvgW - dPadR)" y2="@F(critY)" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="6,4" />
                                    @SvgText(dPadL + 8f, critY - 4f, "Critical Jam (&gt; 3.5 ped/m²)", "svg-threshold-tag text-danger", "start")

                                    <line x1="@F(dPadL)" y1="@F(queueY)" x2="@F(dSvgW - dPadR)" y2="@F(queueY)" stroke="#a8a29e" stroke-width="1.3" stroke-dasharray="3,3" />
                                    @SvgText(dPadL + 8f, queueY - 4f, "Dense Queue (2.0 ped/m²)", "svg-threshold-tag text-warning", "start")

                                    <line x1="@F(dPadL)" y1="@F(freeD)" x2="@F(dSvgW - dPadR)" y2="@F(freeD)" stroke="#64748b" stroke-width="1.3" stroke-dasharray="8,3,2,3" />

                                    <!-- Y Axis Title -->
                                    @SvgText(-dPadT - dChartH / 2f, 20f, "Crowd Density [ped/m²]", "svg-axis-label", "middle", "rotate(-90)")

                                    <!-- X Axis Baseline & Ticks -->
                                    <line x1="@F(dPadL)" y1="@F(dPadT + dChartH)" x2="@F(dSvgW - dPadR)" y2="@F(dPadT + dChartH)" stroke="#475569" stroke-width="1.5" />
                                    @{
                                        int dXInterval = dMaxT <= 120 ? 30 : (dMaxT <= 360 ? 60 : 120);
                                    }
                                    @for (int t = 0; t <= dMaxT; t += dXInterval)
                                    {
                                        float x = dPadL + (t / dMaxT) * dChartW;
                                        <line x1="@F(x)" y1="@F(dPadT + dChartH)" x2="@F(x)" y2="@F(dPadT + dChartH + 5)" stroke="#64748b" />
                                        string tLabel = t >= 60 ? $"{t}s ({(t / 60)}m)" : $"{t}s";
                                        @SvgText(x, dPadT + dChartH + 20f, tLabel, "svg-tick-x", "middle")
                                    }

                                    <!-- Shaded Single Band & Mean Line -->
                                    @if (Stats.DensityHistory.Count > 1)
                                    {
                                        var (band2D, band1D, meanD, curX, curY) = BuildDensityPaths(dPadL, dPadT, dChartW, dChartH, dMaxT, dMaxD);
                                        <path d="@band1D" fill="url(#densityBandGrad)" stroke="#63fe62" stroke-width="0.8" stroke-opacity="0.4" />
                                        <path d="@meanD" fill="none" stroke="url(#turboDensityLine)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                                        <circle cx="@F(curX)" cy="@F(curY)" r="4.5" fill="#f56e29" stroke="#ffffff" stroke-width="1.5" />
                                    }

                                    <!-- Legend Box -->
                                    <g class="svg-legend" transform="translate(@F(dSvgW - 295), 45)">
                                        <rect x="0" y="0" width="275" height="116" rx="6" fill="rgba(15, 23, 42, 0.88)" stroke="rgba(71, 85, 105, 0.5)" />
                                        
                                        <rect x="10" y="14" width="16" height="10" rx="2" fill="url(#densityBandGrad)" stroke="#63fe62" stroke-width="0.6" />
                                        @SvgText(34f, 23f, "Standard Deviation Band (μ ± σ)", "legend-text")

                                        <line x1="10" y1="38" x2="26" y2="38" stroke="url(#turboDensityLine)" stroke-width="2.5" />
                                        @SvgText(34f, 42f, "Mean Density μ(t)", "legend-text font-bold")

                                        <line x1="10" y1="58" x2="26" y2="58" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="4,2" />
                                        @SvgText(34f, 62f, "Critical Crush Threshold (&gt; 3.5 ped/m²)", "legend-text")

                                        <line x1="10" y1="78" x2="26" y2="78" stroke="#a8a29e" stroke-width="1.5" stroke-dasharray="2,2" />
                                        @SvgText(34f, 82f, "Queue Formation Threshold (&gt; 2.0 ped/m²)", "legend-text")

                                        <line x1="10" y1="98" x2="26" y2="98" stroke="#64748b" stroke-width="1.5" stroke-dasharray="6,2,1,2" />
                                        @SvgText(34f, 102f, "Free Flow (≤ 0.5 ped/m²)", "legend-text")
                                    </g>

                                    <defs>
                                        <!-- Turbo Colormap for Density Single Band & Mean Line -->
                                        <linearGradient id="densityBandGrad" x1="0%" y1="100%" x2="0%" y2="0%">
                                            <stop offset="0%" stop-color="#30123b" stop-opacity="0.45" />
                                            <stop offset="12%" stop-color="#4662d8" stop-opacity="0.50" />
                                            <stop offset="25%" stop-color="#28b7e2" stop-opacity="0.55" />
                                            <stop offset="38%" stop-color="#1ae4b6" stop-opacity="0.60" />
                                            <stop offset="50%" stop-color="#63fe62" stop-opacity="0.65" />
                                            <stop offset="63%" stop-color="#bdf838" stop-opacity="0.70" />
                                            <stop offset="75%" stop-color="#faba39" stop-opacity="0.75" />
                                            <stop offset="88%" stop-color="#f56e29" stop-opacity="0.80" />
                                            <stop offset="100%" stop-color="#d73027" stop-opacity="0.85" />
                                        </linearGradient>
                                        <linearGradient id="turboDensityLine" x1="0%" y1="100%" x2="0%" y2="0%">
                                            <stop offset="0%" stop-color="#4662d8" />
                                            <stop offset="20%" stop-color="#28b7e2" />
                                            <stop offset="40%" stop-color="#1ae4b6" />
                                            <stop offset="60%" stop-color="#63fe62" />
                                            <stop offset="80%" stop-color="#faba39" />
                                            <stop offset="100%" stop-color="#f14424" />
                                        </linearGradient>
                                    </defs>

                                    <!-- X Axis Title -->
                                    @SvgText(dPadL + dChartW / 2f, dSvgH - 12f, "Time Elapsed Since Alarm [s]", "svg-axis-label", "middle")
                                </svg>
                            </div>
                        </div>
                    }
                </div>
            }

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; } = false;
    [Parameter] public bool IsLive { get; set; } = true;
    [Parameter] public SimulationLiveStats Stats { get; set; } = new();
    [Parameter] public EventCallback OnClose { get; set; }

    private string _activeTab = "cohorts";
    private string _previousTab = "cohorts";
    private bool _isMinimized = false;
    private bool _isMaximized = false;

    // Draggable position
    private double _posX = 24;
    private double _posY = 70;

    private static string F(float val) => val.ToString("0.##", CultureInfo.InvariantCulture);
    private static string F(double val) => val.ToString("0.##", CultureInfo.InvariantCulture);

    private static MarkupString SvgText(
        float x, float y, string content, 
        string cssClass = "", string anchor = "start", string transform = "", string? fill = null)
    {
        var transAttr = string.IsNullOrEmpty(transform) ? "" : $" transform=\"{transform}\"";
        string resolvedFill = fill ?? ResolveDefaultFill(cssClass);
        string fontSize = ResolveFontSize(cssClass);
        string fontWeight = ResolveFontWeight(cssClass);

        return new MarkupString(
            $"<text x=\"{F(x)}\" y=\"{F(y)}\" text-anchor=\"{anchor}\" fill=\"{resolvedFill}\" font-size=\"{fontSize}\" font-weight=\"{fontWeight}\" font-family=\"system-ui, -apple-system, sans-serif\" class=\"{cssClass}\"{transAttr}>{content}</text>"
        );
    }

    private static string ResolveDefaultFill(string cssClass)
    {
        if (cssClass.Contains("active-val")) return "#38bdf8";
        if (cssClass.Contains("text-success")) return "#4ade80";
        if (cssClass.Contains("text-warning")) return "#fb923c";
        if (cssClass.Contains("text-danger")) return "#f87171";
        if (cssClass.Contains("svg-title")) return "#f8fafc";
        if (cssClass.Contains("svg-axis-label")) return "#cbd5e1";
        if (cssClass.Contains("svg-tick-x")) return "#e2e8f0";
        if (cssClass.Contains("svg-tick")) return "#cbd5e1";
        if (cssClass.Contains("svg-bar-value")) return "#ffffff";
        if (cssClass.Contains("font-bold")) return "#ffffff";
        if (cssClass.Contains("legend-text")) return "#e2e8f0";
        if (cssClass.Contains("svg-threshold-tag")) return "#f1f5f9";
        return "#e2e8f0";
    }

    private static string ResolveFontSize(string cssClass)
    {
        if (cssClass.Contains("svg-title")) return "13.5px";
        if (cssClass.Contains("svg-axis-label")) return "11.5px";
        if (cssClass.Contains("svg-bar-value")) return "11px";
        if (cssClass.Contains("legend-text")) return "9.5px";
        if (cssClass.Contains("svg-threshold-tag")) return "9.5px";
        return "10.5px";
    }

    private static string ResolveFontWeight(string cssClass)
    {
        if (cssClass.Contains("active-val")) return "800";
        if (cssClass.Contains("svg-title")) return "700";
        if (cssClass.Contains("svg-bar-value")) return "700";
        if (cssClass.Contains("font-bold")) return "700";
        if (cssClass.Contains("svg-axis-label")) return "600";
        if (cssClass.Contains("svg-threshold-tag")) return "600";
        return "500";
    }

    private string GetOverlayStyle()
    {
        if (_isMaximized)
        {
            return "position: fixed; top: 8px; left: 8px; right: 8px; bottom: 8px; z-index: 1200; width: calc(100vw - 16px); height: calc(100vh - 16px);";
        }
        return $"position: fixed; top: {_posY}px; right: {_posX}px; z-index: 1200; max-height: calc(100vh - 90px);";
    }

    private void StartDrag(MouseEventArgs e)
    {
        // Simple drag anchor
    }

    private void ToggleMinimize()
    {
        _isMinimized = !_isMinimized;
    }

    private void ToggleMaximize()
    {
        _isMaximized = !_isMaximized;
        if (_isMaximized)
        {
            _isMinimized = false;
            if (_activeTab != "all")
            {
                _previousTab = _activeTab;
            }
            _activeTab = "all";
        }
        else
        {
            _activeTab = _previousTab == "all" ? "cohorts" : _previousTab;
        }
    }

    private async Task Close()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private static string GetCohortBarStyle(int i)
    {
        string[] styles = {
            "fill: #7dd3fc; stroke: #38bdf8;",
            "fill: #60a5fa; stroke: #38bdf8;",
            "fill: #3b82f6; stroke: #60a5fa;",
            "fill: #2563eb; stroke: #3b82f6;",
            "fill: #1d4ed8; stroke: #2563eb;",
            "fill: #1e40af; stroke: #1d4ed8;",
            "fill: #1d4ed8; stroke: #38bdf8;",
            "fill: #1e40af; stroke: #38bdf8;",
            "fill: #1e3a8a; stroke: #60a5fa;",
            "fill: #0369a1; stroke: #38bdf8;"
        };
        return styles[i % styles.Length];
    }

    private (string band2D, string band1D, string meanD, float lastX, float lastY) BuildSpeedPaths(
        float padL, float padT, float chartW, float chartH, float maxT, float maxSpeed)
    {
        var points = Stats.SpeedHistory;
        var band2 = new System.Text.StringBuilder();
        var band1 = new System.Text.StringBuilder();
        var meanLine = new System.Text.StringBuilder();
        float lastX = padL;
        float lastY = padT + chartH;

        if (points.Count == 0) return ("", "", "", lastX, lastY);

        // Band 2 (+-2 sigma)
        for (int i = 0; i < points.Count; i++)
        {
            float px = padL + (points[i].TimeSeconds / maxT) * chartW;
            float val = Math.Clamp(points[i].Plus2Sigma, 0f, maxSpeed);
            float py = padT + chartH - (val / maxSpeed) * chartH;
            px = Math.Clamp(px, padL, padL + chartW);

            if (i == 0) band2.Append($"M {px.ToString("0.0", CultureInfo.InvariantCulture)} {py.ToString("0.0", CultureInfo.InvariantCulture)}");
            else band2.Append($" L {px.ToString("0.0", CultureInfo.InvariantCulture)} {py.ToString("0.0", CultureInfo.InvariantCulture)}");
        }
        for (int i = points.Count - 1; i >= 0; i--)
        {
            float px = padL + (points[i].TimeSeconds / maxT) * chartW;
            float val = Math.Clamp(points[i].Minus2Sigma, 0f, maxSpeed);
            float py = padT + chartH - (val / maxSpeed) * chartH;
            px = Math.Clamp(px, padL, padL + chartW);
            band2.Append($" L {px.ToString("0.0", CultureInfo.InvariantCulture)} {py.ToString("0.0", CultureInfo.InvariantCulture)}");
        }
        band2.Append(" Z");

        // Band 1 (+-1 sigma)
        for (int i = 0; i < points.Count; i++)
        {
            float px = padL + (points[i].TimeSeconds / maxT) * chartW;
            float val = Math.Clamp(points[i].Plus1Sigma, 0f, maxSpeed);
            float py = padT + chartH - (val / maxSpeed) * chartH;
            px = Math.Clamp(px, padL, padL + chartW);

            if (i == 0) band1.Append($"M {px.ToString("0.0", CultureInfo.InvariantCulture)} {py.ToString("0.0", CultureInfo.InvariantCulture)}");
            else band1.Append($" L {px.ToString("0.0", CultureInfo.InvariantCulture)} {py.ToString("0.0", CultureInfo.InvariantCulture)}");
        }
        for (int i = points.Count - 1; i >= 0; i--)
        {
            float px = padL + (points[i].TimeSeconds / maxT) * chartW;
            float val = Math.Clamp(points[i].Minus1Sigma, 0f, maxSpeed);
            float py = padT + chartH - (val / maxSpeed) * chartH;
            px = Math.Clamp(px, padL, padL + chartW);
            band1.Append($" L {px.ToString("0.0", CultureInfo.InvariantCulture)} {py.ToString("0.0", CultureInfo.InvariantCulture)}");
        }
        band1.Append(" Z");

        // Mean line
        for (int i = 0; i < points.Count; i++)
        {
            float px = padL + (points[i].TimeSeconds / maxT) * chartW;
            float val = Math.Clamp(points[i].MeanSpeed, 0f, maxSpeed);
            float py = padT + chartH - (val / maxSpeed) * chartH;
            px = Math.Clamp(px, padL, padL + chartW);
            lastX = px;
            lastY = py;

            if (i == 0) meanLine.Append($"M {px.ToString("0.0", CultureInfo.InvariantCulture)} {py.ToString("0.0", CultureInfo.InvariantCulture)}");
            else meanLine.Append($" L {px.ToString("0.0", CultureInfo.InvariantCulture)} {py.ToString("0.0", CultureInfo.InvariantCulture)}");
        }

        return (band2.ToString(), band1.ToString(), meanLine.ToString(), lastX, lastY);
    }

    private (string band2D, string band1D, string meanD, float lastX, float lastY) BuildDensityPaths(
        float padL, float padT, float chartW, float chartH, float maxT, float maxD)
    {
        var data = Stats.DensityHistory;
        var band2 = new System.Text.StringBuilder();
        var band1 = new System.Text.StringBuilder();
        var meanLine = new System.Text.StringBuilder();
        float lastX = padL;
