                                const float sPadR = 25f;
                                const float sPadT = 45f;
                                const float sPadB = 65f;
                                float sChartW = sSvgW - sPadL - sPadR;
                                float sChartH = sSvgH - sPadT - sPadB;
                                float maxT = Math.Max(60f, Stats.GetMaxTimeSeconds());
                                var (maxSpeed, speedYTicks) = Stats.GetSpeedYScale();
                                float freeFlowY = sPadT + sChartH - (1.1f / maxSpeed) * sChartH;
                                float bottleY = sPadT + sChartH - (0.6f / maxSpeed) * sChartH;
                                float jamY = sPadT + sChartH - (0.2f / maxSpeed) * sChartH;
                            }
                            <div class="chart-container">
                                <svg viewBox="0 0 @sSvgW @sSvgH" class="stat-svg" preserveAspectRatio="xMidYMid meet">
                                    @SvgText(sSvgW / 2f, 24f, "Agent Mean Speed Profile During Evacuation", "svg-title", "middle")

                                    <!-- Y Ticks -->
                                    @foreach (var spd in speedYTicks)
                                    {
                                        float y = sPadT + sChartH - (spd / maxSpeed) * sChartH;
                                        <line x1="@F(sPadL)" y1="@F(y)" x2="@F(sSvgW - sPadR)" y2="@F(y)" stroke="rgba(255,255,255,0.08)" stroke-dasharray="3,3" />
                                        @SvgText(sPadL - 10f, y + 4f, spd.ToString("0.0", CultureInfo.InvariantCulture), "svg-tick", "end")
                                    }

                                    <!-- Reference Lines -->
                                    <line x1="@F(sPadL)" y1="@F(freeFlowY)" x2="@F(sSvgW - sPadR)" y2="@F(freeFlowY)" stroke="#22c55e" stroke-dasharray="4,4" opacity="0.8" stroke-width="1.2" />
                                    @SvgText(sPadL + 8f, freeFlowY - 4f, "Free Flow (&gt; 1.1 m/s)", "svg-threshold-tag text-success", "start")

                                    <line x1="@F(sPadL)" y1="@F(bottleY)" x2="@F(sSvgW - sPadR)" y2="@F(bottleY)" stroke="#f97316" stroke-dasharray="2,2" opacity="0.8" stroke-width="1.2" />
                                    @SvgText(sPadL + 8f, bottleY - 4f, "Bottleneck / Constrained (0.6 m/s)", "svg-threshold-tag text-warning", "start")

                                    <line x1="@F(sPadL)" y1="@F(jamY)" x2="@F(sSvgW - sPadR)" y2="@F(jamY)" stroke="#ef4444" stroke-dasharray="2,2" opacity="0.8" stroke-width="1.2" />
                                    @SvgText(sPadL + 8f, jamY - 4f, "Jam / Stopped (&lt; 0.2 m/s)", "svg-threshold-tag text-danger", "start")

                                    <!-- Y Axis Title -->
                                    @SvgText(-sPadT - sChartH / 2f, 20f, "Movement Speed [m/s]", "svg-axis-label", "middle", "rotate(-90)")

                                    <!-- X Axis Baseline & Ticks -->
                                    <line x1="@F(sPadL)" y1="@F(sPadT + sChartH)" x2="@F(sSvgW - sPadR)" y2="@F(sPadT + sChartH)" stroke="#475569" stroke-width="1.5" />
                                    @{
                                        int xTickInterval = maxT <= 120 ? 20 : (maxT <= 300 ? 60 : 120);
                                    }
                                    @for (int t = 0; t <= maxT; t += xTickInterval)
                                    {
                                        float x = sPadL + (t / maxT) * sChartW;
                                        <line x1="@F(x)" y1="@F(sPadT + sChartH)" x2="@F(x)" y2="@F(sPadT + sChartH + 5)" stroke="#64748b" />
                                        string tLabel = t >= 60 ? $"{t}s ({(t / 60)}m)" : $"{t}s";
                                        @SvgText(x, sPadT + sChartH + 20f, tLabel, "svg-tick-x", "middle")
                                    }

                                    <!-- Shaded Single Band & Mean Line for Speed Profile -->
                                    @if (Stats.SpeedHistory.Count > 1)
                                    {
                                        var (sBand2D, sBand1D, sMeanD, lastX, lastY) = BuildSpeedPaths(sPadL, sPadT, sChartW, sChartH, maxT, maxSpeed);
                                        <path d="@sBand1D" fill="url(#speedBandGrad)" stroke="#38bdf8" stroke-width="0.8" stroke-opacity="0.4" />
                                        <path d="@sMeanD" fill="none" stroke="url(#turboSpeedLine)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                                        <circle cx="@F(lastX)" cy="@F(lastY)" r="4.5" fill="#faba39" stroke="#ffffff" stroke-width="1.5" />
                                    }

                                    <!-- Speed Profile Legend Box -->
                                    <g class="svg-legend" transform="translate(@F(sSvgW - 275), 45)">
                                        <rect x="0" y="0" width="255" height="116" rx="6" fill="rgba(15, 23, 42, 0.88)" stroke="rgba(71, 85, 105, 0.5)" />
                                        
                                        <rect x="10" y="14" width="16" height="10" rx="2" fill="url(#speedBandGrad)" stroke="#38bdf8" stroke-width="0.6" />
                                        @SvgText(34f, 23f, "Standard Deviation Band (μ ± σ)", "legend-text")

                                        <line x1="10" y1="38" x2="26" y2="38" stroke="url(#turboSpeedLine)" stroke-width="2.5" />
                                        @SvgText(34f, 42f, "Mean Speed μ(t)", "legend-text font-bold")

                                        <line x1="10" y1="58" x2="26" y2="58" stroke="#22c55e" stroke-width="1.5" stroke-dasharray="4,2" />
                                        @SvgText(34f, 62f, "Free Flow (&gt; 1.1 m/s)", "legend-text")

                                        <line x1="10" y1="78" x2="26" y2="78" stroke="#f97316" stroke-width="1.5" stroke-dasharray="2,2" />
                                        @SvgText(34f, 82f, "Bottleneck / Constrained (0.6 m/s)", "legend-text")

                                        <line x1="10" y1="98" x2="26" y2="98" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="6,2,1,2" />
                                        @SvgText(34f, 102f, "Jam / Stopped (&lt; 0.2 m/s)", "legend-text")
