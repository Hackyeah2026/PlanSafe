@namespace PlanSafe.App.Components

<section class="map-session-actions" aria-label="@L.Scenario.Actions">
    <AppButton Class="session-current" OnClick="OnTree" aria-label='@(L.Scenario.OpenTree(BranchName))' title='@(L.Scenario.OpenTree(BranchName))'><UiIcon Kind="UiIconKind.Branch" /><span>@(L.Scenario.Count(BranchName))</span></AppButton>
    <IconButton Label="@L.Scenario.NewBranch" OnClick="OnNewBranch"><UiIcon Kind="UiIconKind.Plus" /></IconButton>
    <IconButton Label="@L.Map.Center" OnClick="OnRecenter"><UiIcon Kind="UiIconKind.Reset" /></IconButton>
</section>

@code {
    [Parameter] public string BranchName { get; set; } = "main";
    [Parameter] public EventCallback OnTree { get; set; }
    [Parameter] public EventCallback OnNewBranch { get; set; }
    [Parameter] public EventCallback OnRecenter { get; set; }
}
