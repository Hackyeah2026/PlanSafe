@namespace PlanSafe.App.Components

<div class="sim-control-bar-wrapper">
    <div class="sim-control-capsule surface-panel">
        <!-- Status indicator dot + stats -->
        <div class="sim-status-group">
            <span class="status-pulse @(IsRunning ? "pulse-active" : "pulse-idle")"></span>
            <div class="sim-status-info">
                <div class="sim-status-title">
                    <span class="sim-mode-tag">@(IsRunning ? L.Simulation.Evacuation : L.Simulation.Paused)</span>
                    <span class="sim-engine-tag" data-testid="map-simulation-engine" data-engine="@Engine"
                          title="@L.Simulation.EngineHint">@(IsBusy ? L.Simulation.Preparing : (Engine == "webgpu" ? "WebGPU (GPU)" : "WASM (CPU)"))</span>
                    <span class="sim-time-text">@SimulationTime.ToString("F1")s</span>
                </div>
                <div class="sim-evac-counter">
                    <strong class="text-success">@EvacuatedCount</strong> @(L.Simulation.EvacuatedProgress(TotalAgents, EvacPercent))
                </div>
            </div>
        </div>

        <div class="capsule-divider"></div>

        <!-- Playback buttons -->
        <div class="sim-btn-group">
            <button type="button"
                    class="app-button btn-capsule-action @(IsRunning ? "btn-capsule-pause" : "btn-capsule-play app-button--primary")"
                    disabled="@IsBusy"
                    @onclick="OnToggle"
                    aria-label="@(IsRunning ? L.Simulation.Pause : L.Simulation.Start)"
                    title="@(IsRunning ? L.Simulation.PauseHint : L.Simulation.ResumeHint)">
                @if (IsRunning)
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                        <rect x="6" y="4" width="4" height="16"></rect>
                        <rect x="14" y="4" width="4" height="16"></rect>
                    </svg>
                    <span>@L.Simulation.Pause</span>
                }
                else
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                    <span>@L.Simulation.Start</span>
                }
            </button>

            <button type="button"
                    class="app-button btn-capsule-action btn-capsule-step"
                    disabled="@(IsBusy || IsRunning)"
                    @onclick="OnStep"
                    aria-label="@L.Simulation.Step"
                    title="@L.Simulation.StepHint">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
                <span>@L.Simulation.Step</span>
            </button>

            <button type="button"
                    class="app-button btn-capsule-action btn-capsule-reset"
                    disabled="@IsBusy"
                    @onclick="OnReset"
                    aria-label="@L.Simulation.Reset"
                    title="@L.Simulation.ResetHint">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                    <path d="M3 3v5h5"></path>
                </svg>
                <span>@L.Simulation.Reset</span>
            </button>
        </div>

        <div class="capsule-divider"></div>

        <!-- View Mode Segmented Controls -->
        <div class="sim-mode-toggle-group segmented-control">
            <button type="button"
                    class="app-button sim-mode-btn" aria-pressed="@((RenderMode == "agents").ToString().ToLowerInvariant())"
                    disabled="@IsBusy"
                    @onclick='() => SetRenderMode("agents")'
                    aria-label="@L.Simulation.Agents"
                    title="@L.Simulation.AgentViewHint">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                    <circle cx="12" cy="12" r="6"></circle>
                </svg>
                <span>@L.Simulation.Agents</span>
            </button>
            <button type="button"
                    class="app-button sim-mode-btn" aria-pressed="@((RenderMode == "heatmap").ToString().ToLowerInvariant())"
                    disabled="@IsBusy"
                    @onclick='() => SetRenderMode("heatmap")'
                    aria-label="@L.Simulation.AgentSpeed"
                    title="@L.Simulation.SpeedMap">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
                </svg>
                <span>@L.Simulation.AgentSpeed</span>
            </button>
            <button type="button"
                    class="app-button sim-mode-btn" aria-pressed="@((RenderMode == "density").ToString().ToLowerInvariant())"
                    disabled="@IsBusy"
                    @onclick='() => SetRenderMode("density")'
                    aria-label="@L.Simulation.Density"
                    title="@L.Simulation.DensityMap">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <rect x="2" y="2" width="20" height="20" rx="4"></rect>
                    <path d="M8 8h8v8H8z"></path>
                </svg>
                <span>@L.Simulation.Density</span>
            </button>
        </div>

        <div class="capsule-divider"></div>

        <!-- Speed Dropdown/Pill -->
        <button type="button"
                class="app-button btn-capsule-speed"
                @onclick="CycleSpeed"
                title="@L.Simulation.ChangeSpeed">
            <span>@(Unlimited ? "MAX" : $"{TimeScale:0.#}×")</span>
        </button>

        <!-- Statistics Button -->
        <button type="button"
                class="app-button btn-capsule-stats"
                @onclick="OnOpenStats"
                title="@L.Statistics.OpenHint">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
        </button>

        <!-- Close / Exit Simulation Mode -->
        <button type="button"
                class="app-button btn-capsule-close"
                disabled="@IsBusy"
                @onclick="OnExit"
                title="@L.Simulation.CloseHint"
                aria-label="@L.Simulation.Close">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>
</div>

@code {
    [Parameter] public bool IsRunning { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public string Engine { get; set; } = "wasm";
    [Parameter] public double SimulationTime { get; set; }
    [Parameter] public int EvacuatedCount { get; set; }
    [Parameter] public int TotalAgents { get; set; }
    [Parameter] public string RenderMode { get; set; } = "agents";
    [Parameter] public bool ShowWhiskers { get; set; }
    [Parameter] public double TimeScale { get; set; } = 1.0;
    [Parameter] public bool Unlimited { get; set; }

    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public EventCallback OnStep { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }
    [Parameter] public EventCallback<string> OnRenderModeChanged { get; set; }
    [Parameter] public EventCallback OnToggleWhiskers { get; set; }
    [Parameter] public EventCallback OnCycleSpeed { get; set; }
    [Parameter] public EventCallback OnOpenStats { get; set; }
    [Parameter] public EventCallback OnExit { get; set; }

    private int EvacPercent => TotalAgents > 0 ? (int)Math.Round((double)EvacuatedCount / TotalAgents * 100) : 0;

    private async Task SetRenderMode(string mode)
    {
        if (OnRenderModeChanged.HasDelegate)
        {
            await OnRenderModeChanged.InvokeAsync(mode);
        }
    }

    private async Task CycleSpeed()
    {
        if (OnCycleSpeed.HasDelegate)
        {
            await OnCycleSpeed.InvokeAsync();
        }
    }
}
