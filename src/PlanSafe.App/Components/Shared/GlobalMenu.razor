@inject IJSRuntime JS
@implements IAsyncDisposable

<details class="global-menu ui-workspace" @ref="disclosure">
    <summary class="surface-panel" aria-label="Navigation and appearance menu">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
        <span>PlanSafe</span>
    </summary>
    <div class="global-menu-content surface-panel surface-panel--strong">
        <nav aria-label="Application navigation">
            <NavLink href="map" Match="NavLinkMatch.All">Map</NavLink>
            <NavLink href="simulation-demo">Simulator</NavLink>
        </nav>
        <AppearanceSettings />
    </div>
</details>

@code {
    private ElementReference disclosure;
    private IJSObjectReference? module;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/disclosure.js");
        await module.InvokeVoidAsync("mount", disclosure);
    }
    public async ValueTask DisposeAsync()
    {
        if (module is null) return;
        try { await module.InvokeVoidAsync("unmount", disclosure); await module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
