@page "/evacuate"
@layout EmptyLayout
@using System.Net.Http.Json
@using System.Text.Json
@using PlanSafe.Contracts.Models.Map
@using PlanSafe.Contracts.Models.Simulation
@using PlanSafe.Contracts.Simulation
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>PlanSafe • Mobilny Asystent Ewakuacji</PageTitle>

<div class="container-fluid py-3" data-bs-theme="dark">
    <!-- Header -->
    <div class="card bg-dark text-white border-secondary mb-3 shadow">
        <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="evac-header-icon rounded-circle d-flex align-items-center justify-content-center bg-danger bg-opacity-20 border border-danger text-danger">
                    <i class="bi bi-shield-shaded fs-3"></i>
                </div>
                <div>
                    <h4 class="mb-0 text-white fw-bold d-flex align-items-center gap-2">
                        <span>Mobilny Asystent Ewakuacji</span>
                    </h4>
                    <span class="small text-muted d-none d-sm-inline">Oficjalny system kierowania ludności do bezpiecznych schronów</span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge bg-danger px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1 pulse-beacon">
                    <i class="bi bi-broadcast"></i> ALARM NA ŻYWO
                </span>
                @if (!string.IsNullOrEmpty(SessionId))
                {
                    <span class="badge bg-black bg-opacity-50 text-info border border-secondary font-monospace px-2 py-2" title="Identyfikator aktywnej sesji ewakuacji">
                        <i class="bi bi-key-fill me-1"></i>SESJA: @SessionId
                    </span>
                }
            </div>
        </div>
    </div>

    @if (isSessionExpired)
    {
        <div class="alert alert-warning py-2 px-3 mb-3 d-flex align-items-center gap-2 shadow-sm" role="alert">
            <i class="bi bi-clock-history text-warning fs-5"></i>
            <span><strong>Komunikat przeglądarki:</strong> Sesja ewakuacji wygasła lub jest nieaktywna. Skontaktuj się ze służbami ratunkowymi.</span>
        </div>
    }

    @if (!isEnvironmentLoaded)
    {
        <div class="card bg-dark text-white border-secondary p-4 text-center my-4 shadow-sm animate-fade-in" data-testid="init-loader">
            <div class="d-flex flex-column align-items-center justify-content-center py-5">
                <div class="spinner-border text-info mb-3" style="width: 2.5rem; height: 2.5rem;" role="status">
                    <span class="visually-hidden">Ładowanie parametrów...</span>
                </div>
                <h5 class="text-white fw-bold mb-1">Inicjalizacja modułu ewakuacji...</h5>
                <span class="text-muted small">Pobieranie parametrów sesji, schronów i blokad</span>
            </div>
        </div>
    }
    else
    {
        <!-- Main Content: Map + Right Panel -->
        <div class="row">
        @if (showManualMap)
        {
            <!-- Map Column -->
            <div class="col-lg-7 col-xl-8 mb-3">
                <div class="position-relative evac-map-container">
                    @if (loading)
                    {
                        <div class="floating-map-calc-badge" data-testid="map-loading-indicator">
                            <span class="spinner-border spinner-border-sm text-info me-2" role="status"></span>
                            <span>Wyznaczanie optymalnej trasy...</span>
                        </div>
                    }
                    @if (isPickingLocation)
                    {
                        <div class="alert alert-warning py-2 px-3 small mb-2 d-flex align-items-center justify-content-between shadow-sm animate-fade-in" style="z-index: 1000;">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-hand-index-thumb-fill text-warning fs-5"></i>
                                <span><strong>Tryb wskazywania pozycji:</strong> Kliknij na mapie wewnątrz wyznaczonej strefy, aby ustawić lokalizację.</span>
                            </div>
                            <button type="button" class="btn-close btn-close-white" @onclick="() => isPickingLocation = false"></button>
                        </div>
                    }

                    <!-- Floating Map Tools -->
                    <div class="floating-evac-tools">
                        <button type="button" class="tool-btn" disabled="@isGpsLoading" @onclick="() => RequestGpsAndAssign(true)" title="Pobierz pozycję GPS">
                            <i class="bi @(isGpsLoading ? "bi-arrow-repeat spin" : "bi-crosshair") text-success"></i>
                            <span>GPS</span>
                        </button>
                        <button type="button" class="tool-btn" @onclick="FitMapBoundsAsync" title="Dopasuj widok do wszystkich schronów">
                            <i class="bi bi-arrows-fullscreen text-info"></i>
                            <span>Widok</span>
                        </button>
                    </div>

                    <!-- Real Leaflet OpenStreetMap Container -->
                    <div id="citizen-leaflet-map" style="width: 100%; height: 100%; touch-action: manipulation;"></div>
                    <div class="floating-evac-legend d-none d-sm-block">
                        <i class="bi bi-hand-index-thumb me-1"></i> Kliknij na mapie, by wskazać pozycję &bull;
                        <span class="text-success"><i class="bi bi-shield-fill-check"></i> Schron</span> &bull;
                        <span class="text-danger"><i class="bi bi-shield-slash-fill"></i> Pełny</span> &bull;
                        <span class="text-info"><i class="bi bi-circle-fill"></i> Twoja pozycja</span>
                    </div>
                </div>
            </div>
        }

        <!-- Right Panel Column -->
        <div class="@(showManualMap ? "col-lg-5 col-xl-4" : "col-12 col-md-10 col-lg-7 col-xl-6 mx-auto") d-flex flex-column gap-3">
            <!-- Target Assignment Card -->
            <div class="card bg-dark text-white border-secondary shadow">
                <div class="card-header border-secondary d-flex justify-content-between align-items-center py-2">
                    <span class="fw-bold d-flex align-items-center text-white">
                        <i class="bi bi-shield-fill-check text-success me-2"></i> Twój przydzielony schron
                    </span>
                    @if (loading)
                    {
                        <span class="spinner-border spinner-border-sm text-info" role="status"></span>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-outline-info py-0 px-2" @onclick="() => FetchAssignment(false)" title="Odśwież przydział" style="font-size: 0.75rem;">
                            <i class="bi bi-arrow-clockwise me-1"></i> Odśwież
                        </button>
                    }
                </div>
                <div class="card-body p-3">
                    @if (errorMessage != null)
                    {
                        <div class="alert alert-warning py-2 small mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @errorMessage
                        </div>
                    }

                    @if (loading)
                    {
                        <div class="text-center py-5" data-testid="calculating-assignment">
                            <div class="spinner-border text-info mb-3" role="status" style="width: 2.5rem; height: 2.5rem;"></div>
                            <h5 class="text-white fw-bold mb-1">Wyznaczanie bezpiecznego schronu...</h5>
                            <p class="text-white-50 small mb-0">Analizowanie obłożenia, odległości i blokad drogowych</p>
                        </div>
                    }
                    else if (!gpsLatitude.HasValue || !gpsLongitude.HasValue)
                    {
                        <div class="text-center py-5 text-muted" data-testid="pick-location-prompt">
                            <i class="bi bi-geo-alt-fill text-info display-4 mb-3 d-block"></i>
                            <h5 class="text-white fw-bold mb-2">Wskaż swoją lokalizację na mapie</h5>
                            <p class="text-white-50 small mb-0">Kliknij na mapie, aby wyznaczyć trasę do optymalnego punktu ewakuacji.</p>
                        </div>
                    }
                    else if (isOutsideZone && assignment?.Target == null)
                    {
                        <div class="text-center py-4 px-2" data-testid="outside-zone-block">
                            <div class="text-warning mb-2" style="font-size: 2.5rem;">
                                <i class="bi bi-shield-exclamation"></i>
                            </div>
                            <h5 class="text-warning fw-bold mb-2">Poza Wyznaczoną Strefą Ewakuacji</h5>
                            <p class="text-white-50 small mb-3">
                                Twoja aktualna lokalizacja znajduje się poza wyznaczoną strefą ewakuacji. Oficjalne wytyczne i przydziały schronów dotyczą wyłącznie osób przebywających na terenie objętym alarmem.
                            </p>
                            <button type="button" class="btn btn-warning btn-sm fw-bold px-3 py-2 shadow-sm" @onclick="EnableMapLocationCorrection" data-testid="outside-zone-correct-btn">
                                <i class="bi bi-geo-alt-fill me-1"></i> Popraw lokalizację na mapie
                            </button>
                        </div>
                    }
                    else if (assignment?.Target != null)
                    {
                        var target = assignment.Target;
                        var occPercent = target.Capacity > 0 ? (int)Math.Round((double)target.CurrentOccupancy / target.Capacity * 100) : 0;
                        var occClass = occPercent >= 100 ? "bg-danger" : occPercent >= 70 ? "bg-warning text-dark" : "bg-success";
                        var barClass = occPercent >= 100 ? "bg-danger" : occPercent >= 70 ? "bg-warning" : "bg-success";
                        var directionDegree = assignment.BearingDegrees ?? (GeoMath.CalculateBearingDegrees(gpsLatitude ?? 50.0617, gpsLongitude ?? 19.9373, target.Latitude ?? target.Y, target.Longitude ?? target.X));
                        var mapsUrl = GetMapsUrl(target);

                        if (isOutsideZone)
                        {
                            <div class="alert alert-warning py-2 px-3 small mb-3 d-flex align-items-center justify-content-between shadow-sm animate-fade-in" role="alert" data-testid="outside-zone-block">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-shield-exclamation text-warning fs-5 flex-shrink-0"></i>
                                    <div>
                                        <strong>Poza strefą alarmu:</strong> Twoja pozycja jest poza obrysem alarmu, ale poniżej wyznaczono trasę do najbliższego punktu zbiórki.
                                    </div>
                                </div>
                                <button type="button" class="btn btn-warning btn-sm fw-bold px-2 py-1 flex-shrink-0 ms-2" @onclick="EnableMapLocationCorrection" data-testid="outside-zone-correct-btn">
                                    <i class="bi bi-geo-alt-fill me-1"></i> Wskaż
                                </button>
                            </div>
                        }

                        <div class="text-center py-2 border-bottom border-secondary mb-3">
                            <div class="display-6 fw-bold text-info text-break" data-testid="target-name">@target.Name</div>
                        </div>

                        <!-- 2-Stat Tiles (Distance & Occupancy) -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="stat-tile text-center h-100">
                                    <div class="text-muted small text-uppercase mb-1">
                                        <i class="bi bi-geo-alt-fill text-info me-1"></i> Odległość
                                    </div>
                                    <div class="h3 fw-bold text-white font-monospace mb-1" data-testid="target-distance">
                                        @(assignment.Distance >= 1000 ? $"{(assignment.Distance / 1000.0):F2} km" : $"{assignment.Distance:F0} m")
                                    </div>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        <i class="bi bi-clock me-1 text-warning"></i> ~@GetEstimatedWalkMinutes(assignment.Distance) min pieszo
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="stat-tile text-center h-100">
                                    <div class="text-muted small text-uppercase mb-1">
                                        <i class="bi bi-people-fill text-warning me-1"></i> Zajętość
                                    </div>
                                    <div class="h3 fw-bold font-monospace mb-1">
                                        <span class="badge @occClass" data-testid="target-occupancy">@occPercent%</span>
                                    </div>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        @target.CurrentOccupancy / @target.Capacity miejsc
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Occupancy Progress Bar -->
                        <div class="mb-3">
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar @barClass" role="progressbar" style="width: @Math.Min(100, occPercent)%;"></div>
                            </div>
                        </div>

                        <!-- Direction Indicator (Compass) -->
                        var dirRounded = (int)Math.Round(directionDegree);
                        <div class="d-flex align-items-center gap-3 p-3 rounded mb-3" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08); overflow: hidden;">
                            <div class="compass-dial d-flex align-items-center justify-content-center flex-shrink-0">
                                <div class="compass-arrow" style="transform: rotate(@(dirRounded)deg);">
                                    <i class="bi bi-cursor-fill text-info fs-3"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 min-w-0" style="min-width: 0;">
                                <div class="fw-semibold text-white d-flex flex-wrap align-items-center justify-content-between gap-1">
                                    <span>Kierunek marszu</span>
                                    <span class="badge bg-secondary font-monospace text-wrap" style="font-size: 0.75rem;">~@(dirRounded)&deg; @GetCompassCardinal(dirRounded)</span>
                                </div>
                                <div class="text-muted small mt-1 text-break">
                                    <span class="text-success"><i class="bi bi-geo-fill me-1"></i>Rzeczywiste współrzędne GPS &bull; Kraków</span>
                                </div>
                            </div>
                        </div>

                        <!-- Google Maps Walking Route Link (Citizen Mode) -->
                        <a href="@mapsUrl" target="_blank" class="btn btn-success btn-lg w-100 py-3 fw-bold mb-0 d-flex align-items-center justify-content-center gap-2 shadow text-uppercase">
                            <i class="bi bi-signpost-2-fill fs-5"></i>
                            <span>Nawiguj pieszo w Google Maps</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                    else if (!loading)
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-shield-x fs-1 mb-2 d-block"></i>
                            <p class="mb-2">Brak dostępnych schronów lub trwa pobieranie przydziału...</p>
                            <button class="btn btn-primary btn-sm" @onclick="() => FetchAssignment(false)">Spróbuj ponownie</button>
                        </div>
                    }
                </div>
            </div>

            <!-- Citizen View: GPS Reading Card -->
            <div class="card bg-dark text-white border-secondary shadow">
                <div class="card-header border-secondary d-flex justify-content-between align-items-center py-2">
                    <span class="fw-semibold text-white d-flex align-items-center">
                        <i class="bi bi-geo-alt-fill text-info me-2"></i> Twoja Pozycja (GPS)
                    </span>
                    <div class="d-flex align-items-center gap-2">
                        @if (gpsLatitude.HasValue && gpsLongitude.HasValue)
                        {
                            <span class="badge bg-success bg-opacity-75">GPS AKTYWNY</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary p-1" title="Odśwież pozycję GPS" disabled="@isGpsLoading" @onclick="() => RequestGpsAndAssign(true)">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-info d-flex align-items-center gap-1 shadow-sm py-1 px-2" style="font-size:0.75rem;" disabled="@isGpsLoading" @onclick="() => RequestGpsAndAssign(true)">
                                <i class="bi bi-crosshair"></i> Pobierz GPS
                            </button>
                        }
                    </div>
                </div>
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-pin-map text-info fs-5"></i>
                        <div>
                            <span class="text-muted small d-block">Współrzędne lokalizacji:</span>
                            @if (isGpsLoading)
                            {
                                <div class="d-flex align-items-center gap-2 text-info small">
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                    <span>Pobieranie pozycji GPS...</span>
                                </div>
                            }
                            else if (gpsLatitude.HasValue && gpsLongitude.HasValue)
                            {
                                <strong class="text-success small">@gpsStatus</strong>
                            }
                            else
                            {
                                <strong class="text-warning small">@(gpsStatus ?? "Pozycja domyślna strefy (Kraków Rynek)")</strong>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(gpsErrorMessage))
                    {
                        <div class="alert alert-warning py-2 px-3 small mb-0 d-flex flex-column gap-1">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <strong>Komunikat przeglądarki:</strong>
                            </div>
                            <span>@gpsErrorMessage</span>
                            @if (isGpsInsecureContext)
                            {
                                <div class="mt-1 pt-1 border-top border-warning border-opacity-50 text-white-50" style="font-size: 0.75rem;">
                                    <span>Standard W3C blokuje GPS na nieszyfrowanym HTTP (LAN). Otwórz aplikację przez <code>http://localhost:5050/evacuate</code> lub wskaż pozycję na mapie.</span>
                                </div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(zoneValidationWarning))
                    {
                        <div class="alert @(isOutsideZone ? "alert-warning" : "alert-info") py-2 px-3 small mt-2 mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                            <span>@zoneValidationWarning</span>
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 pt-2 border-top border-secondary small mt-2">
                        <button type="button" class="btn btn-outline-info btn-sm fw-semibold d-flex align-items-center gap-1 shadow-sm" @onclick="ToggleManualMap" data-testid="correct-location-btn">
                            <i class="bi @(showManualMap ? "bi-eye-slash-fill" : "bi-map-fill")"></i>
                            <span>@(showManualMap ? "Ukryj mapę strefy" : "Wskaż pozycję na mapie")</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
</div>

@code {
    [SupplyParameterFromQuery(Name = "session")]
    public string? SessionId { get; set; }

    [SupplyParameterFromQuery(Name = "wdist")]
    public double? QueryWeightDistance { get; set; }

    [SupplyParameterFromQuery(Name = "wocc")]
    public double? QueryWeightOccupancy { get; set; }

    [SupplyParameterFromQuery(Name = "mode")]
    public string? QueryMode { get; set; }

    private bool isSessionExpired = false;
    private bool isEnvironmentLoaded = false;
    private bool showManualMap = true;
    private bool mapInitialized = false;
    private bool loading = true;
    private bool isGpsLoading = false;
    private bool isPickingLocation = false;
    private bool isOutsideZone = false;
    private bool isGpsInsecureContext = false;

    private string? errorMessage;
    private string? gpsStatus;
    private string? gpsErrorMessage;
    private string? zoneValidationWarning;

    private double? gpsLatitude;
    private double? gpsLongitude;
    private double? gpsAccuracy;

    private double weightDistance = 0.5;
    private double weightOccupancy = 0.5;

    private List<EvacuationTarget> targets = new();
    private List<List<GeoCoordinate>> roadblocks = new();
    private List<List<GeoCoordinate>> evacZones = new();
    private List<List<GeoCoordinate>> safeZones = new();

    private TargetAssignmentResponse? assignment;
    private string? currentAllocatedTargetId;
    private int _calculationSequence = 0;

    private IJSObjectReference? citizenMapModule;
    private DotNetObjectReference<Evacuate>? dotNetRef;
    private System.Threading.Timer? pollTimer;

    private static string GetCompassCardinal(double degrees)
    {
        degrees = (degrees % 360 + 360) % 360;
        string[] cardinals = { "N (Północ)", "NE (Północny Wschód)", "E (Wschód)", "SE (Południowy Wschód)", "S (Południe)", "SW (Południowy Zachód)", "W (Zachód)", "NW (Północny Zachód)" };
        int index = (int)Math.Round(degrees / 45.0) % 8;
        return cardinals[index];
    }

    private static int GetEstimatedWalkMinutes(double distanceMeters)
    {
        return Math.Max(1, (int)Math.Ceiling(distanceMeters / (1.2 * 60)));
    }

    private string GetApiBaseUrl()
    {
        var clientUri = new Uri(Navigation.BaseUri);
        if (clientUri.Port == 5050)
        {
            return $"{clientUri.Scheme}://{clientUri.Host}:5051";
        }
        if (clientUri.Port == 5000)
        {
            return $"{clientUri.Scheme}://{clientUri.Host}:5001";
        }
        if (clientUri.Port > 0 && !clientUri.IsDefaultPort && clientUri.Port != 80 && clientUri.Port != 443)
        {
            return $"{clientUri.Scheme}://{clientUri.Host}:{clientUri.Port + 1}";
        }
        return Navigation.BaseUri.TrimEnd('/');
    }

    private record GpsResult(
        bool Success,
        bool IsSecureContext,
        double? Latitude,
        double? Longitude,
        double? Accuracy,
        string? Code,
        string? Message);

    protected override async Task OnInitializedAsync()
    {
        dotNetRef = DotNetObjectReference.Create(this);

        if (QueryWeightDistance.HasValue) weightDistance = Math.Clamp(QueryWeightDistance.Value, 0.0, 1.0);
        if (QueryWeightOccupancy.HasValue) weightOccupancy = Math.Clamp(QueryWeightOccupancy.Value, 0.0, 1.0);

        await LoadEnvironmentAsync();
        isEnvironmentLoaded = true;

        // Perform immediate assignment so citizen sees a valid shelter without delay
        await FetchAssignment(skipApiRefresh: false);

        // In background, request actual GPS to refine if available
        _ = RequestGpsAndAssign(isUserGesture: false);

        pollTimer = new System.Threading.Timer(async _ =>
        {
            if (isEnvironmentLoaded && !loading)
            {
                await InvokeAsync(() => FetchAssignment(skipApiRefresh: false));
            }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isEnvironmentLoaded && showManualMap && !mapInitialized)
        {
            await InitRealMapAsync();
        }
    }

    private async Task InitRealMapAsync()
    {
        try
        {
            citizenMapModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/citizenMapInterop.js");
            double centerLat = gpsLatitude ?? 50.0614;
            double centerLng = gpsLongitude ?? 19.9366;
            var ok = await citizenMapModule.InvokeAsync<bool>("initCitizenMap", "citizen-leaflet-map", centerLat, centerLng, 15, dotNetRef);
            if (ok)
            {
                mapInitialized = true;
                await UpdateCitizenMapJsAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Evacuate] InitRealMapAsync error: {ex.Message}");
        }
    }

    private async Task LoadEnvironmentAsync()
    {
        try
        {
            string url = $"{GetApiBaseUrl()}/api/evacuate/config";
            if (!string.IsNullOrEmpty(SessionId))
            {
                url += $"?session={Uri.EscapeDataString(SessionId)}";
            }

            var cfg = await Http.GetFromJsonAsync<EvacuationPlanConfig>(url);
            if (cfg != null)
            {
                if (cfg.Targets != null && cfg.Targets.Count > 0)
                {
                    targets = cfg.Targets.ToList();
                }
                if (cfg.Roadblocks != null)
                {
                    roadblocks = cfg.Roadblocks.ToList();
                }
                if (cfg.EvacuationZones != null)
                {
                    evacZones = cfg.EvacuationZones.ToList();
                }
                if (cfg.SafeZones != null)
                {
                    safeZones = cfg.SafeZones.ToList();
                }
                if (!QueryWeightDistance.HasValue) weightDistance = cfg.WeightDistance;
                if (!QueryWeightOccupancy.HasValue) weightOccupancy = cfg.WeightOccupancy;

                if (string.IsNullOrEmpty(SessionId) && !string.IsNullOrEmpty(cfg.SessionId))
                {
                    SessionId = cfg.SessionId;
                }
                else if (!string.IsNullOrEmpty(SessionId) && cfg.ExpiresAtUtc.HasValue && cfg.ExpiresAtUtc.Value < DateTime.UtcNow)
                {
                    isSessionExpired = true;
                }

                // Initialize default coordinates based on evacuation zone or map center
                if (!gpsLatitude.HasValue || !gpsLongitude.HasValue)
                {
                    if (evacZones.Count > 0 && evacZones[0].Count > 0)
                    {
                        gpsLatitude = Math.Round(evacZones[0].Average(p => p.Latitude), 6);
                        gpsLongitude = Math.Round(evacZones[0].Average(p => p.Longitude), 6);
                        gpsStatus = "Pozycja domyślna strefy (oczekiwanie na GPS...)";
                    }
                    else if (cfg.MapCenterLat.HasValue && cfg.MapCenterLng.HasValue)
                    {
                        gpsLatitude = cfg.MapCenterLat.Value;
                        gpsLongitude = cfg.MapCenterLng.Value;
                        gpsStatus = "Pozycja domyślna strefy (oczekiwanie na GPS...)";
                    }
                    else if (targets.Count > 0 && targets[0].Latitude is double tLat && targets[0].Longitude is double tLng)
                    {
                        gpsLatitude = tLat;
                        gpsLongitude = tLng;
                        gpsStatus = "Pozycja domyślna strefy (oczekiwanie na GPS...)";
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Evacuate] LoadEnvironment error: {ex.Message}");
        }

        // Ensure fallback targets if none loaded
        if (targets.Count == 0)
        {
            targets.Add(new EvacuationTarget(
                Id: "shelter-krakow-1",
                Name: "Punkt Zbiórki Północ (Park Krakowski)",
                X: 19.9266,
                Y: 50.0684,
                Width: 20.0,
                Height: 20.0,
                Capacity: 500,
                CurrentOccupancy: 45,
                IsActive: true,
                Latitude: 50.0684,
                Longitude: 19.9266
            ));
            targets.Add(new EvacuationTarget(
                Id: "shelter-krakow-2",
                Name: "Punkt Zbiórki Południe (Planty)",
                X: 19.9380,
                Y: 50.0570,
                Width: 20.0,
                Height: 20.0,
                Capacity: 400,
                CurrentOccupancy: 20,
                IsActive: true,
                Latitude: 50.0570,
                Longitude: 19.9380
            ));
        }

        if (!gpsLatitude.HasValue || !gpsLongitude.HasValue)
        {
            gpsLatitude = 50.0614;
            gpsLongitude = 19.9366;
            gpsStatus = "Pozycja domyślna (Kraków Rynek)";
        }
    }

