@page "/evacuate"
@layout EmptyLayout
@using System.Net.Http.Json
@using System.Text.Json
@using PlanSafe.Contracts.Models.Map
@using PlanSafe.Contracts.Models.Simulation
@using PlanSafe.Contracts.Simulation
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>PlanSafe • Mobile Evacuation Assistant</PageTitle>

<div class="evac-page ui-workspace" lang="en">
    <header class="surface-panel surface-panel--strong evac-header">
        <div class="evac-brand">
            <span class="evac-header-icon"><UiIcon Kind="UiIconKind.Shield" /></span>
            <div>
                <h1>Your route to safe zone</h1>
                <p class="ui-muted">Set your location, check your assigned shelter, and start navigation.</p>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(SessionId))
        {
            <span class="evac-session">Session <strong>@SessionId</strong></span>
        }
    </header>

    @if (isSessionExpired)
    {
        <div class="status-message status-message--warning py-2 px-3 mb-3 d-flex align-items-center gap-2 shadow-sm" role="alert">
            <i class="bi bi-clock-history text-warning fs-5"></i>
            <span><strong>Browser message:</strong> The evacuation session has expired or is inactive. Contact the emergency services.</span>
        </div>
    }

    @if (!isEnvironmentLoaded)
    {
        <div class="surface-panel surface-panel--strong p-4 text-center my-4" data-testid="init-loader">
            <div class="d-flex flex-column align-items-center justify-content-center py-5">
                <div class="spinner-border text-info mb-3" style="width: 2.5rem; height: 2.5rem;" role="status">
                    <span class="visually-hidden">Loading settings...</span>
                </div>
                <h5 class="evac-text fw-bold mb-1">Initializing evacuation module...</h5>
                <span class="text-muted small">Loading session settings, shelters, and roadblocks</span>
            </div>
        </div>
    }
    else
    {
        @if (isProvisionalLocation && !isLocationWarningDismissed)
        {
            <div class="status-message status-message--warning py-2 px-3 mb-3 d-flex align-items-center justify-content-between gap-2" role="alert" data-testid="verify-location-warning">
                <span><strong>Verify your location.</strong> The route starts near the zone’s center. Select your actual location on the map.</span>
                <button type="button" class="app-button app-icon-button" aria-label="Dismiss location warning" @onclick="() => isLocationWarningDismissed = true"><UiIcon Kind="UiIconKind.Close" /></button>
            </div>
        }
        <!-- Main Content: Map + Right Panel -->
        <div class="row g-3 evac-content">
            <!-- Map Column -->
            <div class="col-lg-7 col-xl-8 evac-map-column">
                <div class="position-relative evac-map-container">
                    @if (loading)
                    {
                        <div class="floating-map-calc-badge surface-panel surface-panel--strong" role="status" data-testid="map-loading-indicator">
                            <span class="spinner-border spinner-border-sm text-info me-2" role="status"></span>
                            <span>Calculating the best route...</span>
                        </div>
                    }

                    <!-- Floating Map Tools -->
                    <div class="floating-evac-tools surface-panel surface-panel--strong">
                        <button type="button" class="app-button" disabled="@isGpsLoading" @onclick="() => RequestGpsAndAssign(true)" title="Get GPS location">
                            <i class="bi @(isGpsLoading ? "bi-arrow-repeat spin" : "bi-crosshair") text-success"></i>
                            <span>GPS</span>
                        </button>
                    </div>

                    <!-- Real Leaflet OpenStreetMap Container -->
                    <div id="citizen-leaflet-map" style="width: 100%; height: 100%; touch-action: manipulation;"></div>
                    <div class="floating-evac-legend surface-panel surface-panel--strong">
                        <i class="bi bi-hand-index-thumb me-1"></i> Click the map to set your location &bull;
                        <span class="text-success"><i class="bi bi-shield-fill-check"></i> Shelter</span> &bull;
                        <span class="text-danger"><i class="bi bi-shield-slash-fill"></i> Full</span> &bull;
                        <span class="text-info"><i class="bi bi-circle-fill"></i> Your location</span>
                    </div>
                </div>
            </div>

        <!-- Right Panel Column -->
        <div class="col-lg-5 col-xl-4 d-flex flex-column gap-3 evac-details-column">
            <!-- Target Assignment Card -->
            <div class="surface-panel surface-panel--strong evac-card">
                <div class="evac-card-header d-flex justify-content-between align-items-center py-2">
                    <span class="fw-bold d-flex align-items-center evac-text">
                        <i class="bi bi-shield-fill-check text-success me-2"></i> Your assigned shelter
                    </span>
                    @if (loading)
                    {
                        <span class="spinner-border spinner-border-sm text-info" role="status"></span>
                    }
                    else
                    {
                        <button type="button" class="app-button px-2" @onclick="() => FetchAssignment(false)" title="Refresh assignment" >
                            <i class="bi bi-arrow-clockwise me-1"></i> Refresh
                        </button>
                    }
                </div>
                <div class="evac-card-body">
                    @if (errorMessage != null)
                    {
                        <div class="status-message status-message--warning py-2 small mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @errorMessage
                        </div>
                    }

                    @if (loading)
                    {
                        <div class="text-center py-5" data-testid="calculating-assignment">
                            <div class="spinner-border text-info mb-3" role="status" style="width: 2.5rem; height: 2.5rem;"></div>
                            <h5 class="evac-text fw-bold mb-1">Finding a safe shelter...</h5>
                            <p class="ui-muted small mb-0">Analyzing occupancy, distance, and roadblocks</p>
                        </div>
                    }
                    else if (!gpsLatitude.HasValue || !gpsLongitude.HasValue)
                    {
                        <div class="text-center py-5 text-muted" data-testid="pick-location-prompt">
                            <i class="bi bi-geo-alt-fill text-info display-4 mb-3 d-block"></i>
                            <h5 class="evac-text fw-bold mb-2">Select your location on the map</h5>
                            <p class="ui-muted small mb-0">Click inside the evacuation zone on the map to find a route to the best evacuation point.</p>
                        </div>
                    }
                    else if (isOutsideZone)
                    {
                        <div class="text-center py-4 px-2" data-testid="outside-zone-block">
                            <div class="text-warning mb-2" style="font-size: 2.5rem;">
                                <i class="bi bi-shield-exclamation"></i>
                            </div>
                            <h5 class="text-warning fw-bold mb-2">Outside the Designated Evacuation Zone</h5>
                            <p class="ui-muted small mb-3">
                                Your current location is outside the designated evacuation zone. Official guidance and shelter assignments apply only to people within the alert area.
                            </p>
                            <button type="button" class="app-button fw-bold px-3 py-2 shadow-sm" @onclick="EnableMapLocationCorrection" data-testid="outside-zone-correct-btn">
                                <i class="bi bi-geo-alt-fill me-1"></i> Correct your location on the map
                            </button>
                        </div>
                    }
                    else if (HasValidLocation && assignment?.Target != null && !assignment.IsOutsideZone)
                    {
                        var target = assignment.Target;
                        var occPercent = target.Capacity > 0 ? (int)Math.Round((double)target.CurrentOccupancy / target.Capacity * 100) : 0;
                        var occClass = occPercent >= 100 ? "bg-danger" : occPercent >= 70 ? "bg-warning text-dark" : "bg-success";
                        var barClass = occPercent >= 100 ? "bg-danger" : occPercent >= 70 ? "bg-warning" : "bg-success";
                        var directionDegree = assignment.BearingDegrees ?? (GeoMath.CalculateBearingDegrees(gpsLatitude ?? 50.0617, gpsLongitude ?? 19.9373, target.Latitude ?? target.Y, target.Longitude ?? target.X));
                        var mapsUrl = GetMapsUrl(target);

                        <div class="text-center py-2 border-bottom border-secondary mb-3">
                            <div class="display-6 fw-bold text-info text-break" data-testid="target-name">@target.Name</div>
                        </div>

                        <!-- 2-Stat Tiles (Distance & Occupancy) -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="stat-tile text-center h-100">
                                    <div class="text-muted small text-uppercase mb-1">
                                        <i class="bi bi-geo-alt-fill text-info me-1"></i> Distance
                                    </div>
                                    <div class="h3 fw-bold evac-text font-monospace mb-1" data-testid="target-distance">
                                        @(assignment.Distance >= 1000 ? $"{(assignment.Distance / 1000.0):F2} km" : $"{assignment.Distance:F0} m")
                                    </div>
                                    <div class="text-muted" >
                                        <i class="bi bi-clock me-1 text-warning"></i> ~@GetEstimatedWalkMinutes(assignment.Distance) min on foot
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="stat-tile text-center h-100">
                                    <div class="text-muted small text-uppercase mb-1">
                                        <i class="bi bi-people-fill text-warning me-1"></i> Occupancy
                                    </div>
                                    <div class="h3 fw-bold font-monospace mb-1">
                                        <span class="badge @occClass" data-testid="target-occupancy">@occPercent%</span>
                                    </div>
                                    <div class="text-muted" >
                                        @target.CurrentOccupancy / @target.Capacity spaces
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Occupancy Progress Bar -->
                        <div class="mb-3">
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar @barClass" role="progressbar" aria-valuenow="@Math.Clamp(occPercent, 0, 100)" aria-valuemin="0" aria-valuemax="100" aria-label="Shelter occupancy" style="width: @Math.Clamp(occPercent, 0, 100)%;"></div>
                            </div>
                        </div>

                        <!-- Direction Indicator (Compass) -->
                        var dirRounded = (int)Math.Round(directionDegree);
                        <div class="evac-direction d-flex align-items-center gap-3 p-3 mb-3" >
                            <div class="compass-dial d-flex align-items-center justify-content-center flex-shrink-0">
                                <div class="compass-arrow" style="transform: rotate(@(dirRounded)deg);">
                                    <i class="bi bi-cursor-fill text-info fs-3"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 min-w-0" style="min-width: 0;">
                                <div class="fw-semibold evac-text d-flex flex-wrap align-items-center justify-content-between gap-1">
                                    <span>Walking direction</span>
                                    <span class="badge evac-neutral-badge font-monospace text-wrap" >~@(dirRounded)&deg; @GetCompassCardinal(dirRounded)</span>
                                </div>
                                <div class="text-muted small mt-1 text-break">
                                    <span class="text-success"><i class="bi bi-geo-fill me-1"></i>Actual GPS coordinates &bull; Kraków</span>
                                </div>
                            </div>
                        </div>

                        <!-- Google Maps Walking Route Link (Citizen Mode) -->
                        <a href="@mapsUrl" target="_blank" rel="noopener" class="app-button app-button--success w-100 py-3 fw-bold mb-0 d-flex align-items-center justify-content-center gap-2 shadow text-uppercase">
                            <i class="bi bi-signpost-2-fill fs-5"></i>
                            <span>Get walking directions in Google Maps</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                    else if (!loading)
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-shield-x fs-1 mb-2 d-block"></i>
                            <p class="mb-2">No shelters available, or assignment is still loading...</p>
                            <button class="app-button app-button--primary" @onclick="() => FetchAssignment(false)">Try again</button>
                        </div>
                    }
                </div>
            </div>

            <!-- Citizen View: GPS Reading Card -->
            <div class="surface-panel surface-panel--strong evac-card">
                <div class="evac-card-header d-flex justify-content-between align-items-center py-2">
                    <span class="fw-semibold evac-text d-flex align-items-center">
                        <i class="bi bi-geo-alt-fill text-info me-2"></i> Your location
                    </span>
                    <div class="d-flex align-items-center gap-2">
                        @if (gpsLatitude.HasValue && gpsLongitude.HasValue)
                        {
                            <span class="badge bg-success bg-opacity-75">LOCATION SET</span>
                            <button type="button" class="app-button" title="Refresh GPS location" aria-label="Refresh GPS location" disabled="@isGpsLoading" @onclick="() => RequestGpsAndAssign(true)">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="app-button d-flex align-items-center gap-1 shadow-sm py-1 px-2"  disabled="@isGpsLoading" @onclick="() => RequestGpsAndAssign(true)">
                                <i class="bi bi-crosshair"></i> Get GPS location
                            </button>
                        }
                    </div>
                </div>
                <div class="evac-card-body">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-pin-map text-info fs-5"></i>
                        <div>
                            <span class="text-muted small d-block">Location coordinates:</span>
                            @if (isGpsLoading)
                            {
                                <div class="d-flex align-items-center gap-2 text-info small">
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                    <span>Getting GPS location...</span>
                                </div>
                            }
                            else if (gpsLatitude.HasValue && gpsLongitude.HasValue)
                            {
                                <strong class="@(isProvisionalLocation ? "text-warning" : "text-success") small">@gpsStatus</strong>
                            }
                            else
                            {
                                <strong class="text-warning small">@(gpsStatus ?? "Location has not been set yet")</strong>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(gpsErrorMessage))
                    {
                        <div class="status-message status-message--warning py-2 px-3 small mb-0 d-flex flex-column gap-1">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <strong>Browser message:</strong>
                            </div>
                            <span>@gpsErrorMessage</span>
                            @if (isGpsInsecureContext)
                            {
                                <div class="mt-1 pt-1 border-top border-warning border-opacity-50 ui-muted" >
                                    <span>To use GPS, open the link over a secure HTTPS connection. You can also select your location on the map.</span>
                                </div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(zoneValidationWarning))
                    {
                        <div class="status-message @(isOutsideZone ? "status-message--warning" : "") py-2 px-3 small mt-2 mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                            <span>@zoneValidationWarning</span>
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 pt-2 border-top border-secondary small mt-2">
                        <button type="button" class="app-button fw-semibold d-flex align-items-center gap-1 shadow-sm" @onclick="EnableMapLocationCorrection" data-testid="correct-location-btn">
                            <i class="bi bi-map-fill"></i>
                            <span>Correct your location on the map</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
</div>

@code {
    [SupplyParameterFromQuery(Name = "session")]
    public string? SessionId { get; set; }

    [SupplyParameterFromQuery(Name = "wdist")]
    public double? QueryWeightDistance { get; set; }

    [SupplyParameterFromQuery(Name = "wocc")]
    public double? QueryWeightOccupancy { get; set; }

    [SupplyParameterFromQuery(Name = "mode")]
    public string? QueryMode { get; set; }

    private bool isSessionExpired = false;
    private bool isEnvironmentLoaded = false;
    private bool mapInitialized = false;
    private bool loading = true;
    private bool isGpsLoading = false;
    private bool isOutsideZone = false;
    private bool isProvisionalLocation;
    private bool isLocationWarningDismissed;
    private bool isGpsInsecureContext = false;

    private string? errorMessage;
    private string? gpsStatus;
    private string? gpsErrorMessage;
    private string? zoneValidationWarning;

    private double? gpsLatitude;
    private double? gpsLongitude;
    private double? gpsAccuracy;

    private double weightDistance = 0.5;
    private double weightOccupancy = 0.5;

    private List<EvacuationTarget> targets = new();
    private List<List<GeoCoordinate>> roadblocks = new();
    private List<List<GeoCoordinate>> evacZones = new();
    private List<List<GeoCoordinate>> safeZones = new();

    private TargetAssignmentResponse? assignment;
    private string? currentAllocatedTargetId;
    private int _calculationSequence = 0;
    private int _manualLocationSequence;
    private bool HasValidLocation => gpsLatitude.HasValue && gpsLongitude.HasValue &&
        double.IsFinite(gpsLatitude.Value) && double.IsFinite(gpsLongitude.Value) &&
        evacZones.Any(zone => GeoMath.IsPointInPolygon(gpsLatitude.Value, gpsLongitude.Value, zone));

    private IJSObjectReference? citizenMapModule;
    private DotNetObjectReference<Evacuate>? dotNetRef;
    private System.Threading.Timer? pollTimer;

    private static string GetCompassCardinal(double degrees)
    {
        degrees = (degrees % 360 + 360) % 360;
        string[] cardinals = { "N (North)", "NE (Northeast)", "E (East)", "SE (Southeast)", "S (South)", "SW (Southwest)", "W (West)", "NW (Northwest)" };
        int index = (int)Math.Round(degrees / 45.0) % 8;
        return cardinals[index];
    }

    private static int GetEstimatedWalkMinutes(double distanceMeters)
    {
        return Math.Max(1, (int)Math.Ceiling(distanceMeters / (1.2 * 60)));
    }

    private string GetApiBaseUrl()
    {
        return EvacuationApiUrlResolver.Resolve(Navigation.BaseUri);
    }

    private record GpsResult(
        bool Success,
        bool IsSecureContext,
        double? Latitude,
        double? Longitude,
        double? Accuracy,
        string? Code,
        string? Message);

    protected override async Task OnInitializedAsync()
    {
        dotNetRef = DotNetObjectReference.Create(this);

        if (QueryWeightDistance.HasValue) weightDistance = Math.Clamp(QueryWeightDistance.Value, 0.0, 1.0);
        if (QueryWeightOccupancy.HasValue) weightOccupancy = Math.Clamp(QueryWeightOccupancy.Value, 0.0, 1.0);

        await LoadEnvironmentAsync();
        isEnvironmentLoaded = true;

        // Show a provisional route while GPS is pending or unavailable.
        TrySetProvisionalZoneLocation();
        await FetchAssignment(skipApiRefresh: false, expectedSeq: null, isManualRelocation: isProvisionalLocation);

        // In background, request actual GPS to refine if available
        _ = RequestGpsAndAssign(isUserGesture: false);

        pollTimer = new System.Threading.Timer(async _ =>
        {
            if (isEnvironmentLoaded && !loading)
            {
                await InvokeAsync(() => FetchAssignment(skipApiRefresh: false));
            }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isEnvironmentLoaded && !mapInitialized)
        {
            await InitRealMapAsync();
        }
    }

    private async Task InitRealMapAsync()
    {
        try
        {
            citizenMapModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/citizenMapInterop.js");
            double centerLat = gpsLatitude ?? 50.0614;
            double centerLng = gpsLongitude ?? 19.9366;
            var ok = await citizenMapModule.InvokeAsync<bool>("initCitizenMap", "citizen-leaflet-map", centerLat, centerLng, 15, dotNetRef);
            if (ok)
            {
                mapInitialized = true;
                await UpdateCitizenMapJsAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Evacuate] InitRealMapAsync error: {ex.Message}");
        }
    }

    private async Task LoadEnvironmentAsync()
    {
        try
        {
            string url = $"{GetApiBaseUrl()}/api/evacuate/config";
            if (!string.IsNullOrEmpty(SessionId))
            {
                url += $"?session={Uri.EscapeDataString(SessionId)}";
            }

            var cfg = await Http.GetFromJsonAsync<EvacuationPlanConfig>(url);
            if (cfg != null)
            {
                if (cfg.Targets != null && cfg.Targets.Count > 0)
                {
                    targets = cfg.Targets.ToList();
                }
                if (cfg.Roadblocks != null)
                {
                    roadblocks = cfg.Roadblocks.ToList();
                }
                if (cfg.EvacuationZones != null)
                {
                    evacZones = cfg.EvacuationZones.ToList();
                }
                if (cfg.SafeZones != null)
                {
                    safeZones = cfg.SafeZones.ToList();
                }
                if (!QueryWeightDistance.HasValue) weightDistance = cfg.WeightDistance;
                if (!QueryWeightOccupancy.HasValue) weightOccupancy = cfg.WeightOccupancy;

                if (string.IsNullOrEmpty(SessionId) && !string.IsNullOrEmpty(cfg.SessionId))
                {
                    SessionId = cfg.SessionId;
                }
                else if (!string.IsNullOrEmpty(SessionId) && cfg.ExpiresAtUtc.HasValue && cfg.ExpiresAtUtc.Value < DateTime.UtcNow)
                {
                    isSessionExpired = true;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Evacuate] LoadEnvironment error: {ex.Message}");
        }

        // Ensure fallback targets if none loaded
        if (targets.Count == 0)
        {
            targets.Add(new EvacuationTarget(
                Id: "shelter-krakow-1",
                Name: "North Assembly Point (Krakowski Park)",
                X: 19.9266,
                Y: 50.0684,
                Width: 20.0,
                Height: 20.0,
                Capacity: 500,
                CurrentOccupancy: 45,
                IsActive: true,
                Latitude: 50.0684,
                Longitude: 19.9266
            ));
            targets.Add(new EvacuationTarget(
                Id: "shelter-krakow-2",
                Name: "South Assembly Point (Planty Park)",
                X: 19.9380,
                Y: 50.0570,
                Width: 20.0,
                Height: 20.0,
                Capacity: 400,
                CurrentOccupancy: 20,
                IsActive: true,
                Latitude: 50.0570,
                Longitude: 19.9380
            ));
        }

    }

    private async Task RefreshTargetsAsync()
    {
        try
        {
            var tgts = await Http.GetFromJsonAsync<List<EvacuationTarget>>($"{GetApiBaseUrl()}/api/evacuate/targets");
            if (tgts != null && tgts.Count > 0)
            {
                targets = tgts;
                await UpdateCitizenMapJsAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Evacuate] RefreshTargets error: {ex.Message}");
        }
    }

    private async Task RequestGpsAndAssign(bool isUserGesture = false)
    {
        isGpsLoading = true;
        if (isUserGesture)
        {
            gpsStatus = "Getting GPS location...";
            StateHasChanged();
        }

        try
        {
            int locationSequence = _manualLocationSequence;
            var res = await JS.InvokeAsync<GpsResult?>("getGeolocation");
            // A manual selection made while GPS was pending takes precedence.
            if (locationSequence != _manualLocationSequence) return;
            if (res != null && res.Success && res.Latitude.HasValue && res.Longitude.HasValue)
            {
                int seq = ++_calculationSequence;
                ApplyGpsLocation(res.Latitude.Value, res.Longitude.Value, res.Accuracy);
                assignment = null;
                isOutsideZone = !HasValidLocation;
                isGpsInsecureContext = false;
                gpsErrorMessage = null;
                loading = true;
                await UpdateCitizenMapJsAsync();
                StateHasChanged();
                await FetchAssignment(skipApiRefresh: false, expectedSeq: seq, isManualRelocation: isProvisionalLocation);
            }
            else if (res != null && !res.IsSecureContext)
            {
                isGpsInsecureContext = true;
                gpsErrorMessage = res.Message ?? "The browser blocked GPS access over an unencrypted connection (HTTP).";
                if (!gpsLatitude.HasValue)
                {
                    gpsStatus = "GPS access unavailable (HTTPS required)";
                }
                await UpdateCitizenMapJsAsync();
            }
            else if (res != null && !string.IsNullOrEmpty(res.Message))
            {
                isGpsInsecureContext = false;
                gpsErrorMessage = res.Message;
                if (!gpsLatitude.HasValue)
                {
                    gpsStatus = "GPS unavailable (select your location on the map)";
                }
                await UpdateCitizenMapJsAsync();
            }
        }
        catch (Exception ex)
        {
            if (isUserGesture)
            {
                gpsStatus = "GPS module error";
                gpsErrorMessage = ex.Message;
            }
        }
        finally
        {
            isGpsLoading = false;
            if (assignment == null && gpsLatitude.HasValue && gpsLongitude.HasValue)
            {
                await FetchAssignment(skipApiRefresh: false);
            }
            StateHasChanged();
        }
    }

    private void ApplyGpsLocation(double latitude, double longitude, double? accuracy)
    {
        gpsLatitude = Math.Round(latitude, 6);
        gpsLongitude = Math.Round(longitude, 6);
        gpsAccuracy = accuracy;
        isProvisionalLocation = false;
        isLocationWarningDismissed = false;
        gpsStatus = $"{gpsLatitude.Value:F4}°N, {gpsLongitude.Value:F4}°E (±{Math.Round(accuracy ?? 0)}m)";

        if (!HasValidLocation && double.IsFinite(latitude) && double.IsFinite(longitude))
        {
            TrySetProvisionalZoneLocation();
        }
    }

    private bool TrySetProvisionalZoneLocation()
    {
        // Match the first polygon focused by the citizen map.
        var zone = evacZones.FirstOrDefault(z => z.Count >= 3);
        var center = zone == null ? null : GeoMath.GetInteriorCenter(zone);
        if (center is not { } location) return false;

        gpsLatitude = location.Latitude;
        gpsLongitude = location.Longitude;
        gpsAccuracy = 0; // A provisional point has no measured GPS accuracy.
        isProvisionalLocation = true;
        isLocationWarningDismissed = false;
        gpsStatus = $"{gpsLatitude.Value:F4}°N, {gpsLongitude.Value:F4}°E (zone center — verify location)";
        return true;
    }

    private void EnableMapLocationCorrection()
    {
        zoneValidationWarning = null;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnCitizenMapClicked(double lat, double lng)
    {
        ++_manualLocationSequence;
        int seq = ++_calculationSequence;
        gpsLatitude = Math.Round(lat, 6);
        gpsLongitude = Math.Round(lng, 6);
        gpsAccuracy = 15.0;
        if (HasValidLocation) isProvisionalLocation = false;
        isGpsInsecureContext = false;
        gpsStatus = $"{gpsLatitude.Value:F4}°N, {gpsLongitude.Value:F4}°E (selected on the map)";
        isOutsideZone = !HasValidLocation;
        zoneValidationWarning = null;
        assignment = null;
        loading = true;
        await UpdateCitizenMapJsAsync();
        StateHasChanged();
        await FetchAssignment(skipApiRefresh: false, expectedSeq: seq, isManualRelocation: true);
    }

    [JSInvokable]
    public async Task OnShelterSelected(string shelterId)
    {
        var target = targets.FirstOrDefault(t => t.Id == shelterId);
        if (target == null || !HasValidLocation || !gpsLatitude.HasValue || !gpsLongitude.HasValue) return;

        int seq = ++_calculationSequence;
        loading = true;
        currentAllocatedTargetId = target.Id;
        StateHasChanged();

        try
        {
            var req = new TargetAssignmentRequest(
                X: gpsLongitude.Value,
                Y: gpsLatitude.Value,
                WeightDistance: weightDistance,
                WeightOccupancy: weightOccupancy,
                CustomTargets: new List<EvacuationTarget> { target },
                Latitude: gpsLatitude.Value,
                Longitude: gpsLongitude.Value,
                SessionId: SessionId,
                CurrentTargetId: currentAllocatedTargetId,
                IgnoreHysteresis: true,
                StrictGeofence: true
            );

            TargetAssignmentResponse? assignResult = null;
            try
            {
                var response = await Http.PostAsJsonAsync($"{GetApiBaseUrl()}/api/evacuate/assign", req);
                if (response.IsSuccessStatusCode)
                {
                    assignResult = await response.Content.ReadFromJsonAsync<TargetAssignmentResponse>();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Evacuate] API assign on shelter selected failed: {ex.Message}");
            }

            if (assignResult == null)
            {
                assignResult = TargetSelector.SelectGeoTarget(
                    citizenLat: gpsLatitude.Value,
                    citizenLng: gpsLongitude.Value,
                    targets: new List<EvacuationTarget> { target },
                    weightDistance: weightDistance,
                    weightOccupancy: weightOccupancy,
                    roadblocks: roadblocks,
                    evacuationZones: evacZones,
                    currentTargetId: currentAllocatedTargetId,
                    ignoreHysteresis: true,
                    strictGeofence: true
                );
            }

            if (seq == _calculationSequence && assignResult != null)
            {
                assignment = assignResult;
                isOutsideZone = assignResult.IsOutsideZone;
                errorMessage = null;

                _ = Http.PostAsJsonAsync($"{GetApiBaseUrl()}/api/evacuate/checkin", new CheckInRequest(currentAllocatedTargetId, 1));

                await UpdateCitizenMapJsAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            if (seq == _calculationSequence)
            {
                loading = false;
                StateHasChanged();
            }
        }
    }

    private Task FetchAssignment(bool skipApiRefresh) => FetchAssignment(skipApiRefresh, expectedSeq: null, isManualRelocation: false);

    private async Task FetchAssignment(bool skipApiRefresh, int? expectedSeq, bool isManualRelocation = false)
    {
        int seq = expectedSeq ?? ++_calculationSequence;
        if (!HasValidLocation || !gpsLatitude.HasValue || !gpsLongitude.HasValue)
        {
            assignment = null;
            isOutsideZone = gpsLatitude.HasValue && gpsLongitude.HasValue;
            zoneValidationWarning = "Select your location inside the evacuation zone to start navigation.";
            loading = false;
            await UpdateCitizenMapJsAsync();
            StateHasChanged();
            return;
        }
        isOutsideZone = false;
        zoneValidationWarning = null;

        try
        {
            var req = new TargetAssignmentRequest(
                X: gpsLongitude.Value,
                Y: gpsLatitude.Value,
                WeightDistance: weightDistance,
                WeightOccupancy: weightOccupancy,
                Latitude: gpsLatitude.Value,
                Longitude: gpsLongitude.Value,
                SessionId: SessionId,
                CurrentTargetId: currentAllocatedTargetId,
                IgnoreHysteresis: isManualRelocation,
                StrictGeofence: true
            );

            TargetAssignmentResponse? assignResult = null;
            try
            {
                var response = await Http.PostAsJsonAsync($"{GetApiBaseUrl()}/api/evacuate/assign", req);
                if (response.IsSuccessStatusCode)
                {
                    assignResult = await response.Content.ReadFromJsonAsync<TargetAssignmentResponse>();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Evacuate] API assign failed, falling back to local calculation: {ex.Message}");
            }

            // Local fallback calculation if API was unreachable or returned an error
            if (assignResult == null && targets.Count > 0)
            {
                assignResult = TargetSelector.SelectGeoTarget(
                    citizenLat: gpsLatitude.Value,
                    citizenLng: gpsLongitude.Value,
                    targets: targets,
                    weightDistance: weightDistance,
                    weightOccupancy: weightOccupancy,
                    roadblocks: roadblocks,
                    evacuationZones: evacZones,
                    currentTargetId: currentAllocatedTargetId,
                    ignoreHysteresis: isManualRelocation,
                    strictGeofence: true
                );
            }

            if (seq == _calculationSequence && assignResult != null)
            {
                assignment = assignResult;
                isOutsideZone = assignResult.IsOutsideZone;
                errorMessage = null;

                // Slot balancing: if target changed, balance occupancy
                if (assignResult.Target != null && assignResult.Target.Id != currentAllocatedTargetId)
                {
                    var prevTarget = currentAllocatedTargetId;
                    currentAllocatedTargetId = assignResult.Target.Id;

                    if (!string.IsNullOrEmpty(prevTarget))
                    {
                        _ = Http.PostAsJsonAsync($"{GetApiBaseUrl()}/api/evacuate/checkin", new CheckInRequest(prevTarget, -1));
                    }
                    _ = Http.PostAsJsonAsync($"{GetApiBaseUrl()}/api/evacuate/checkin", new CheckInRequest(currentAllocatedTargetId, 1));
                }

                await UpdateCitizenMapJsAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Communication error: {ex.Message}";
        }
        finally
        {
            if (seq == _calculationSequence)
            {
                loading = false;
                StateHasChanged();
            }
        }
    }

    private static readonly JsonSerializerOptions _camelCaseJsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };

    private async Task UpdateCitizenMapJsAsync()
    {
        if (citizenMapModule != null)
        {
            try
            {
                string sheltersJson = JsonSerializer.Serialize(targets, _camelCaseJsonOptions);
                string? selectedId = assignment?.Target?.Id;
                string roadblocksJson = JsonSerializer.Serialize(roadblocks, _camelCaseJsonOptions);
                var routeCoords = assignment?.RoutePath?
                    .Select(p => new[] { p.Latitude, p.Longitude })
                    .ToList() ?? new List<double[]>();
                string routeJson = JsonSerializer.Serialize(routeCoords);
                string zonesJson = JsonSerializer.Serialize(evacZones, _camelCaseJsonOptions);
                string safeZonesJson = JsonSerializer.Serialize(safeZones, _camelCaseJsonOptions);

                await citizenMapModule.InvokeVoidAsync(
                    "updateCitizenMap",
                    "citizen-leaflet-map",
                    gpsLatitude,
                    gpsLongitude,
                    gpsAccuracy ?? 20.0,
                    sheltersJson,
                    selectedId,
                    roadblocksJson,
                    routeJson,
                    zonesJson,
                    safeZonesJson,
                    isProvisionalLocation || !HasValidLocation
                );
            }
            catch
            {
            }
        }
    }

    private string? GetMapsUrl(EvacuationTarget target)
    {
        if (!HasValidLocation || assignment?.IsOutsideZone != false) return null;
        double destLat = target.Latitude ?? target.Y;
        double destLng = target.Longitude ?? target.X;
        GeoCoordinate? origin = gpsLatitude.HasValue && gpsLongitude.HasValue
            ? new GeoCoordinate(gpsLatitude.Value, gpsLongitude.Value)
            : null;
        return GoogleMapsUrlBuilder.Build(new GeoCoordinate(destLat, destLng), origin, assignment?.RoutePath);
    }

    public async ValueTask DisposeAsync()
    {
        if (!string.IsNullOrEmpty(currentAllocatedTargetId))
        {
            var targetToRelease = currentAllocatedTargetId;
            currentAllocatedTargetId = null;
            try
            {
                await Http.PostAsJsonAsync($"{GetApiBaseUrl()}/api/evacuate/checkin", new CheckInRequest(targetToRelease, -1));
            }
            catch
            {
            }
        }

        pollTimer?.Dispose();

        if (citizenMapModule != null)
        {
            try
            {
                await citizenMapModule.InvokeVoidAsync("disposeCitizenMap", "citizen-leaflet-map");
                await citizenMapModule.DisposeAsync();
            }
            catch
            {
            }
            citizenMapModule = null;
        }

        dotNetRef?.Dispose();
    }
