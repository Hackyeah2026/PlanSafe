@page "/evacuate"
@layout EmptyLayout
@using PlanSafe.App.Components.Evacuation
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@L.EvacuationUi.PageTitle</PageTitle>

<div class="evac-workspace ui-workspace" lang="@UiCulture">
    <EvacuationHeader />

    @if (!isEnvironmentLoaded)
    {
        <div class="evac-initial-state" data-testid="init-loader">
            <SurfacePanel Strong="true" Label="@L.EvacuationUi.LoadingLabel">
                <StatusMessage>@L.EvacuationUi.Loading</StatusMessage>
            </SurfacePanel>
        </div>
    }
    else if (planLoadError != null)
    {
        <div class="evac-map" inert aria-hidden="true">
            <div id="citizen-leaflet-map" class="citizen-map"></div>
        </div>
        <div class="evac-blocking-state" data-testid="plan-load-error">
            <SurfacePanel Strong="true" Label="@L.EvacuationUi.PlanUnavailable">
                <h1>@L.EvacuationUi.PlanUnavailable</h1>
                <StatusMessage Tone="StatusTone.Warning" role="alert">@(planLoadError?.Invoke())</StatusMessage>
                <AppButton Class="mt-3" OnClick="ReloadPlan">@L.EvacuationUi.RefreshPage</AppButton>
            </SurfacePanel>
        </div>
    }
    else
    {
        <section class="evac-map" aria-label="@L.EvacuationUi.MapLabel">
            <div id="citizen-leaflet-map" class="citizen-map" aria-label="@L.EvacuationUi.MapSelectLabel"></div>
            <div class="evac-map-tools surface-panel" role="group" aria-label="@L.EvacuationUi.MapTools">
                <AppButton OnClick="FitMapBoundsAsync" title="@L.EvacuationUi.FitHint">
                    <UiIcon Kind="UiIconKind.Reset" /> @L.EvacuationUi.Fit
                </AppButton>
                <details class="map-legend">
                    <summary>@L.EvacuationUi.Legend</summary>
                    <div class="legend-content surface-panel surface-panel--strong">
                        <span><span class="legend-dot shelter"></span> @L.Shelter.Label</span>
                        <span><span class="legend-dot full"></span> @L.EvacuationUi.FullShelter</span>
                        <span><span class="legend-dot position"></span> @L.Location.YourPosition</span>
                        <span><span class="legend-dot zone"></span> @L.Drawing.EvacuationZone</span>
                    </div>
                </details>
            </div>
        </section>

        <aside class="evac-panel surface-panel" aria-label="@L.EvacuationUi.Information">
            <CollapsibleMapPanel ContentId="evacuation-information-content" Title="@PanelTitle" Expanded="detailsExpanded"
                                 ExpandLabel="@L.EvacuationUx.ExpandPanel" CollapseLabel="@L.EvacuationUx.CollapsePanel" OnToggle="TogglePanel">
                <Icon><UiIcon Kind="UiIconKind.Shield" /></Icon>
                <ChildContent>
                    <div class="evac-panel-content">
                        @if (NeedsLocation)
                        {
                            <EvacuationLocation GpsLoading="isGpsLoading" GpsAvailable="canRetryGps" ErrorMessage="@(gpsErrorMessage?.Invoke())"
                                                OutsideZone="isOutsideZone" CanCancel="HasConfirmedLocation"
                                                OnGps="() => RequestGpsAndAssign(true)" OnSelectMap="EnableMapLocationCorrection"
                                                OnCancel="CancelLocationCorrection" />
                        }
                        else
                        {
                            <EvacuationAssignment Assignment="@(CanNavigate ? assignment : null)" Loading="loading"
                                                  ErrorMessage="@(errorMessage?.Invoke())"
                                                  NavigationUrl="@(CanNavigate ? GetMapsUrl(assignment!.Target!) : null)"
                                                  OnRefresh="() => FetchAssignment(false)" />
                            <div class="evac-location-summary">
                                <span><UiIcon Kind="UiIconKind.Shield" /> @(locationFromGps ? L.EvacuationUx.GpsConfirmed : L.EvacuationUx.MapConfirmed)</span>
                                <AppButton OnClick="ShowLocationOptions">@L.EvacuationUx.ChangeLocation</AppButton>
                            </div>
                        }
                    </div>
                </ChildContent>
            </CollapsibleMapPanel>
        </aside>
    }
</div>
