    private string GetMapsUrl(EvacuationTarget target)
    {
        double destLat = target.Latitude ?? target.Y;
        double destLng = target.Longitude ?? target.X;
        string dest = $"{destLat.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)},{destLng.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)}";

        if (gpsLatitude.HasValue && gpsLongitude.HasValue)
        {
            string origin = $"{gpsLatitude.Value.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)},{gpsLongitude.Value.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)}";
            return $"https://www.google.com/maps/dir/?api=1&origin={origin}&destination={dest}&travelmode=walking";
        }
        return $"https://www.google.com/maps/dir/?api=1&destination={dest}&travelmode=walking";
    }

    public async ValueTask DisposeAsync()
    {
        if (!string.IsNullOrEmpty(currentAllocatedTargetId))
        {
            var targetToRelease = currentAllocatedTargetId;
            currentAllocatedTargetId = null;
            try
            {
                await Http.PostAsJsonAsync($"{GetApiBaseUrl()}/api/evacuate/checkin", new CheckInRequest(targetToRelease, -1));
            }
            catch
            {
            }
        }

        pollTimer?.Dispose();

        if (citizenMapModule != null)
        {
            try
            {
                await citizenMapModule.InvokeVoidAsync("disposeCitizenMap", "citizen-leaflet-map");
                await citizenMapModule.DisposeAsync();
            }
            catch
            {
            }
            citizenMapModule = null;
        }

        dotNetRef?.Dispose();
    }
