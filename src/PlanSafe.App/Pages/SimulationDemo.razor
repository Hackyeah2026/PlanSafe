@page "/simulation-demo"
@page "/simulation"
@using System.Diagnostics
@using PlanSafe.App.Simulation
@using PlanSafe.Contracts.Models.Simulation
@using PlanSafe.App.Components
@using PlanSafe.Contracts.Models.Stats
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Simulation Demo - PlanSafe</PageTitle>

<div class="card bg-dark text-white p-3 shadow-lg">
    <div class="row mb-3 align-items-center">
        <div class="col-md-6">
            <h3 class="card-title mb-1">Simulation Demo</h3>
            <p class="text-muted small mb-0">Rzeczywisty układ współrzędnych (metry) &bull; Pole Potencjału + Siły Społeczne &bull; Weidmann & Seyfried</p>
        </div>
        <div class="col-md-6 text-md-end mt-2 mt-md-0">
            <button data-testid="toggle" class="btn @(isRunning ? "btn-danger" : "btn-success") px-3" disabled="@(!ready)" @onclick="ToggleSimulation">
                @(isRunning ? "Zatrzymaj" : "Uruchom")
            </button>
            <button class="btn btn-outline-light ms-2" disabled="@(!ready || isRunning)" @onclick="StepSimulation">
                Krok
            </button>
            <button data-testid="reset" class="btn btn-outline-secondary ms-2" disabled="@(!ready)" @onclick="ResetSimulation">
                Reset Agenci
            </button>
            <button type="button" class="btn btn-info text-dark fw-bold ms-2 shadow-sm" disabled="@(!ready || isPublishing)" @onclick="PublishCurrentPlan">
                @if (isPublishing)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Publikowanie...</span>
                }
                else
                {
                    <span>&#x1F4F1; Zatwierdź Plan & Kod QR</span>
                }
            </button>
            <button type="button" class="btn @(_showStats ? "btn-info" : "btn-outline-info") ms-2 fw-bold shadow-sm" @onclick="ToggleStats" title="Analytics & Statistics">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
                <span class="ms-1">Statistics</span>
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            @if (!string.IsNullOrEmpty(publishError))
            {
                <div class="alert alert-warning py-1 px-2 small mb-2">@publishError</div>
            }

            <div class="position-relative">
                <canvas @ref="canvas" id="simulation-canvas" data-testid="simulation-canvas" width="800" height="500" class="w-100 border border-secondary rounded bg-black" style="display: block; touch-action: none;"></canvas>

                <!-- Nakładka przycisków kamery (Pan & Zoom) -->
                <div class="position-absolute top-0 end-0 p-2 d-flex flex-column gap-1" style="z-index: 10;">
                    <button type="button" class="btn btn-sm btn-dark bg-opacity-75 border-secondary text-white" title="Przybliż (Zoom In)" disabled="@(!ready)" @onclick="ZoomIn">
                        +
                    </button>
                    <button type="button" class="btn btn-sm btn-dark bg-opacity-75 border-secondary text-white" title="Oddal (Zoom Out)" disabled="@(!ready)" @onclick="ZoomOut">
                        -
                    </button>
                    <button type="button" class="btn btn-sm btn-dark bg-opacity-75 border-secondary text-white" title="Wyśrodkuj widok" disabled="@(!ready)" @onclick="ResetCamera">
                        &#x27F2;
                    </button>
                </div>

                <div class="position-absolute bottom-0 end-0 p-2 text-muted small pe-3" style="pointer-events: none; font-size: 0.75rem;">
                    Przeciągaj myszką (Pan) &bull; Kółko myszy (Zoom) &bull; Dwuklik (Reset widoku)
                </div>
            </div>

            <!-- Podsumowanie Obiektów Mapy -->
            <div class="mt-2 p-2 bg-secondary bg-opacity-10 rounded border border-secondary small">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold text-muted">Obiekty na mapie: @obstacles.Count blokad, @targets.Count punktów zbiórki</span>
                </div>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var obs in obstacles)
                    {
                        <span class="badge bg-danger bg-opacity-75 d-inline-flex align-items-center gap-1">
                            <span>Blokada (@obs.X.ToString("F0"), @obs.Y.ToString("F0"))</span>
                        </span>
                    }
                    @foreach (var tgt in targets)
                    {
                        <span class="badge bg-success bg-opacity-75 d-inline-flex align-items-center gap-1">
                            <span>@tgt.Name (@tgt.X.ToString("F0"), @tgt.Y.ToString("F0"))</span>
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="p-3 bg-secondary bg-opacity-10 rounded border border-secondary">
                <h5 class="border-bottom border-secondary pb-2 mb-3">Parametry Symulacji</h5>

                <!-- Obszar Świata (metry) -->
                <div class="mb-3">
                    <label class="form-label d-flex justify-content-between small text-muted">
                        <span>Obszar Świata:</span>
                        <strong class="text-white">@worldWidth.ToString("F0") m &times; @worldHeight.ToString("F0") m (@((worldWidth * worldHeight / 1_000_000.0).ToString("F2", System.Globalization.CultureInfo.InvariantCulture)) km&sup2;)</strong>
                    </label>
                    <div class="btn-group w-100 btn-group-sm mb-2" role="group">
                        <button type="button" class="btn @(worldWidth == 1000 ? "btn-primary" : "btn-outline-secondary")" disabled="@(!ready)" @onclick="() => SetWorldPreset(1000, 1000)">1000m (1km)</button>
                        <button type="button" class="btn @(worldWidth == 500 ? "btn-primary" : "btn-outline-secondary")" disabled="@(!ready)" @onclick="() => SetWorldPreset(500, 500)">500m</button>
                        <button type="button" class="btn @(worldWidth == 200 ? "btn-primary" : "btn-outline-secondary")" disabled="@(!ready)" @onclick="() => SetWorldPreset(200, 200)">200m</button>
                        <button type="button" class="btn @(worldWidth == 60 ? "btn-primary" : "btn-outline-secondary")" disabled="@(!ready)" @onclick="() => SetWorldPreset(60, 40)">Hala 60m</button>
                    </div>
                </div>

                <!-- Wybór Silnika Obliczeniowego (WebGPU / Wasm CPU) -->
                <div class="mb-3">
                    <label class="form-label d-flex justify-content-between small text-muted">
                        <span>Silnik obliczeniowy:</span>
                        <strong class="text-white">@(activeEngine == "webgpu" ? "WebGPU Compute (GPU)" : "Wasm CPU")</strong>
                    </label>
                    <div class="btn-group w-100 btn-group-sm" role="group">
                        <button type="button" class="btn @(activeEngine == "webgpu" ? "btn-primary" : "btn-outline-secondary")" disabled="@(!ready || !isWebGpuSupported)" @onclick='() => SetEngine("webgpu")'>
                            WebGPU (GPU)
                        </button>
                        <button type="button" class="btn @(activeEngine == "wasm" ? "btn-primary" : "btn-outline-secondary")" disabled="@(!ready)" @onclick='() => SetEngine("wasm")'>
                            Wasm CPU
                        </button>
                    </div>
                    @if (!isWebGpuSupported && activeEngine == "wasm")
                    {
                        <div class="text-muted small mt-1" style="font-size: 0.7rem;">
                            WebGPU niedostępne w tej przeglądarce &bull; Aktywny silnik Wasm CPU
                        </div>
                    }
                </div>

                <!-- Przyspieszenie Czasu -->
                <div class="mb-3">
                    <label class="form-label d-flex justify-content-between align-items-center flex-wrap gap-1 small" for="time-scale">
                        <span>Tempo symulacji:</span>
                        <div class="d-flex gap-1 align-items-center">
                            <span class="badge @(activeEngine == "webgpu" ? "bg-primary" : "bg-warning text-dark")" title="Silnik obliczeniowy symulatora">@(activeEngine == "webgpu" ? "WebGPU" : "Wasm CPU")</span>
                            <span data-testid="target-speed" class="badge bg-info text-dark">Cel: @(unlimited ? "Bez limitu" : $"{timeScale.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}×")</span>
                            <span data-testid="actual-speed" class="badge @(isRunning ? (ActualSpeed >= (unlimited ? 1.0 : timeScale * 0.85) ? "bg-success" : "bg-warning text-dark") : "bg-secondary")">Rzeczywiste tempo: @ActualSpeed.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)×</span>
                        </div>
                    </label>
                    <input id="time-scale" data-testid="time-scale" disabled="@(!ready || unlimited)" type="range" class="form-range" min="1.0" max="50.0" step="1.0" @bind="timeScale" />
                    <div class="d-flex justify-content-between text-muted" style="font-size: 0.7rem;">
                        <span>1.0× (Czas rzecz.)</span>
                        <span>25.0×</span>
                        <span>50.0×</span>
                    </div>
                    <div class="form-check form-switch mt-2">
                        <input id="unlimited" data-testid="unlimited" class="form-check-input" type="checkbox" disabled="@(!ready)" @bind="unlimited" />
                        <label class="form-check-label small" for="unlimited">Bez limitu</label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small" for="render-fps-cap">Limit FPS podglądu</label>
                    <select id="render-fps-cap" data-testid="render-fps-cap" disabled="@(!ready)" class="form-select form-select-sm bg-dark text-white border-secondary" @bind="renderFps">
                        <option value="15">15 FPS</option>
                        <option value="30">30 FPS</option>
                        <option value="60">60 FPS</option>
                        <option value="display">Częstotliwość ekranu</option>
                    </select>
                </div>

                <!-- Liczba Agentów -->
                <div class="mb-3">
                    <label class="form-label d-flex justify-content-between small" for="agent-count">
                        <span>Liczba Agentów:</span>
                        <span class="badge bg-secondary">@agentCount</span>
                    </label>
                    <input id="agent-count" data-testid="agent-count" disabled="@(!ready)" type="range" class="form-range" min="50" max="50000" step="50" @bind="agentCount" @bind:after="ApplyCount" />
                    <div class="d-flex justify-content-between text-muted" style="font-size: 0.7rem;">
                        <span>50</span>
                        <span>10 000</span>
                        <span>25 000</span>
                        <span>50 000</span>
                    </div>
                </div>

                <!-- Granulacja (Agenci / Kropkę) -->
                <div class="mb-3">
                    <label class="form-label d-flex justify-content-between small" for="granulation">
                        <span>Granulacja:</span>
                        <span class="badge bg-secondary">@granulation @(granulation == 1 ? "agent / kropkę" : "agentów / kropkę")</span>
                    </label>
                    <input id="granulation" data-testid="granulation" disabled="@(!ready)" type="range" class="form-range" min="1" max="25" step="1" @bind="granulation" @bind:after="ApplyGranulation" />
                    <div class="d-flex justify-content-between text-muted" style="font-size: 0.7rem;">
                        <span>1 (1:1)</span>
                        <span>10</span>
                        <span>25 (Maks. 25:1)</span>
                    </div>
                </div>

                <!-- Siła Odpychania Tłumu -->
                <div class="mb-3">
                    <label class="form-label d-flex justify-content-between small" for="social-repulsion-weight">
                        <span>Siła Odpychania Tłumu:</span>
                        <span class="badge bg-secondary">@socialRepulsionWeight.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)</span>
                    </label>
                    <input id="social-repulsion-weight" data-testid="repulsion-weight" disabled="@(!ready)" type="range" class="form-range" min="0" max="10" step="0.5" @bind="socialRepulsionWeight" @bind:after="ApplyWeight" />
                </div>

                <!-- Tryb Wyświetlania -->
                <div class="mb-3">
                    <label class="form-label small" for="render-mode">Tryb Wyświetlania</label>
                    <select id="render-mode" data-testid="render-mode" disabled="@(!ready)" class="form-select form-select-sm bg-dark text-white border-secondary" @bind="renderMode" @bind:after="RequestRender">
                        <option value="agents">Agenci (Pozycje jednostek)</option>
                        <option value="heatmap">Mapa Ciepła (Prędkość przepływu)</option>
                        <option value="density">Mapa Ciepła (Gęstość tłumu)</option>
                    </select>
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="showWhiskersCheck" disabled="@(!ready)" @bind="showWhiskers" @bind:after="RequestRender" />
                    <label class="form-check-label small" for="showWhiskersCheck">Pokaż wąsy sensoryczne (Whiskers)</label>
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="showFlowParticlesCheck" disabled="@(!ready)" @bind="showFlowParticles" @bind:after="RequestRender" />
                    <label class="form-check-label small" for="showFlowParticlesCheck">Cząsteczki przepływu (Wektor pola / Flow Particles)</label>
                </div>

                <div class="form-check small mt-2">
                    <input id="show-diagnostics" data-testid="diagnostics" type="checkbox" class="form-check-input" @bind="showDiagnostics" />
                    <label class="form-check-label" for="show-diagnostics">Pokaż diagnostykę</label>
                </div>
                @if (showDiagnostics)
                {
                    <div class="small mt-2 p-2 bg-black bg-opacity-50 rounded border border-secondary">
                        <div data-testid="render-fps" class="text-info">Render FPS: @renderFramesPerSecond.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)</div>
                        <div data-testid="steps-per-second" class="text-info">Simulation steps/s: @simulationStepsPerSecond.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)</div>
                    </div>
                }

                <!-- Moduł 2: Dystrybucja i Balansowanie Obciążenia Schronów -->
                <div class="mt-3 pt-3 border-top border-secondary">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0 text-info fw-bold">Dystrybucja & Schrony (Moduł 2)</h6>
                    </div>

                    <!-- Szybkie Scenariusze i Dowolna Regulacja Wag -->
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1 d-block">Szybki wybór scenariusza:</label>
                        <div class="btn-group w-100 btn-group-sm mb-3" role="group">
                            <button type="button" class="btn @(Math.Abs(weightDistance - 1.0) < 0.05 && Math.Abs(weightOccupancy) < 0.05 ? "btn-warning text-dark fw-bold" : "btn-outline-secondary")" disabled="@(!ready)" @onclick="() => SetScenario(1.0, 0.0)">
                                Scenariusz A (1:0)
                            </button>
                            <button type="button" class="btn @(Math.Abs(weightDistance - 0.5) < 0.05 && Math.Abs(weightOccupancy - 0.5) < 0.05 ? "btn-success fw-bold" : "btn-outline-secondary")" disabled="@(!ready)" @onclick="() => SetScenario(0.5, 0.5)">
                                Scenariusz B (0.5:0.5)
                            </button>
                            <button type="button" class="btn @(Math.Abs(weightDistance - 0.2) < 0.05 && Math.Abs(weightOccupancy - 0.8) < 0.05 ? "btn-info text-dark fw-bold" : "btn-outline-secondary")" disabled="@(!ready)" @onclick="() => SetScenario(0.2, 0.8)">
                                Scenariusz C (0.2:0.8)
                            </button>
                        </div>
                    </div>

                    <!-- Balans Wag (Wizualny pasek proporcji, Suma = 1.0) -->
                    <div class="mb-3 p-2 bg-dark bg-opacity-50 rounded border border-secondary">
                        <div class="d-flex justify-content-between align-items-center mb-1 small">
                            <span class="text-muted">Balans wag (Suma = 1.00):</span>
                            <span>
                                <strong class="text-info">@((weightDistance * 100).ToString("F0"))%</strong>
                                <span class="text-muted"> / </span>
                                <strong class="text-warning">@((weightOccupancy * 100).ToString("F0"))%</strong>
                            </span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-info" role="progressbar" style="width: @((weightDistance * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;" title="Odległość: @weightDistance.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"></div>
                            <div class="progress-bar bg-warning" role="progressbar" style="width: @((weightOccupancy * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;" title="Obłożenie: @weightOccupancy.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"></div>
                        </div>
                        <div class="d-flex justify-content-between text-muted mt-1" style="font-size: 0.65rem;">
                            <span class="text-info">&larr; Odległość (w_dist)</span>
                            <span class="text-warning">Obłożenie (w_occ) &rarr;</span>
                        </div>
                    </div>

                    <!-- Płynna Regulacja: Waga Odległości -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small mb-0 fw-semibold text-info" for="weight-dist">Waga odległości (w_dist):</label>
                            <div class="d-flex align-items-center gap-1">
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" disabled="@(!ready || weightDistance <= 0.001)" @onclick="() => AdjustWeightDist(-0.05)" title="Zmniejsz wagę odległości">&minus;</button>
                                <span class="badge bg-secondary font-monospace px-2" style="font-size: 0.85rem; min-width: 45px;">@weightDistance.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)</span>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" disabled="@(!ready || weightDistance >= 0.999)" @onclick="() => AdjustWeightDist(0.05)" title="Zwiększ wagę odległości">+</button>
                            </div>
                        </div>
                        <input id="weight-dist" data-testid="weight-dist" disabled="@(!ready)" type="range" class="form-range" min="0" max="1" step="0.01" value="@weightDistance.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" @oninput="OnWeightDistInput" @onchange="OnWeightDistInput" />
                    </div>

                    <!-- Płynna Regulacja: Waga Obłożenia -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small mb-0 fw-semibold text-warning" for="weight-occ">Waga obłożenia (w_occ):</label>
                            <div class="d-flex align-items-center gap-1">
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" disabled="@(!ready || weightOccupancy <= 0.001)" @onclick="() => AdjustWeightOcc(-0.05)" title="Zmniejsz wagę obłożenia">&minus;</button>
                                <span class="badge bg-secondary font-monospace px-2" style="font-size: 0.85rem; min-width: 45px;">@weightOccupancy.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)</span>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" disabled="@(!ready || weightOccupancy >= 0.999)" @onclick="() => AdjustWeightOcc(0.05)" title="Zwiększ wagę obłożenia">+</button>
                            </div>
                        </div>
                        <input id="weight-occ" data-testid="weight-occ" disabled="@(!ready)" type="range" class="form-range" min="0" max="1" step="0.01" value="@weightOccupancy.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" @oninput="OnWeightOccInput" @onchange="OnWeightOccInput" />
                    </div>

                    <!-- Wskaźniki Obłożenia Schronów na Żywo -->
                    @if (targets.Count > 0)
                    {
                        <div class="p-2 bg-black bg-opacity-40 rounded border border-secondary mb-2 small">
                            <div class="d-flex justify-content-between text-muted mb-1" style="font-size: 0.75rem;">
                                <span>OBŁOŻENIE SCHRONÓW</span>
                                <button type="button" class="btn btn-link p-0 text-info text-decoration-none" style="font-size: 0.7rem;" disabled="@(!ready)" @onclick="ResetShelters">Resetuj obłożenie</button>
                            </div>
                            @foreach (var s in targets)
                            {
                                var pct = s.Capacity > 0 ? (int)Math.Round((double)s.CurrentOccupancy / s.Capacity * 100) : 0;
                                var barColor = pct >= 100 ? "bg-danger" : pct >= 70 ? "bg-warning" : "bg-success";
                                <div class="mb-2">
                                    <div class="d-flex justify-content-between text-white" style="font-size: 0.8rem;">
                                        <span>@s.Name</span>
                                        <strong>@s.CurrentOccupancy / @s.Capacity (@pct%)</strong>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar @barColor" role="progressbar" style="width: @Math.Min(100, pct)%;"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <hr class="border-secondary my-2" />
                <div class="small text-muted">
                    <div data-testid="status" role="status" aria-live="polite">Status: <strong class="@(isRunning ? "text-success" : (_engine != null && (_engine.ActiveAgentCount == 0 || (_engine.EvacuatedCount >= _engine.AgentCount && _engine.EvacuatedCount > 0)) && _engine.SimulationTime > 0 ? "text-info" : "text-warning"))">@(_engine != null && (_engine.ActiveAgentCount == 0 || (_engine.EvacuatedCount >= _engine.AgentCount && _engine.EvacuatedCount > 0)) && _engine.SimulationTime > 0 ? "Zakończona" : (isRunning ? "Uruchomiona" : "Zatrzymana"))</strong></div>
                    <div>Aktywni agenci: @(_engine != null && _engine.ActiveAgentCount == 0 ? 0 : ((_engine?.AgentCount ?? agentCount) - (_engine?.EvacuatedCount ?? 0))) (Ewakuowani: @(_engine != null && _engine.ActiveAgentCount == 0 ? (_engine?.AgentCount ?? agentCount) : (_engine?.EvacuatedCount ?? 0)))</div>
                    <div>Symulowane kropki: @(_engine?.ActiveAgentCount ?? SimulatedAgentCount)</div>
                    <div>Fizyka tłumu: Diagram Weidmanna (gęstość-prędkość) &bull; Asymetria lider-następca</div>
                    <div>Jednostki metryczne: Promień agenta ~@(granulation > 1 ? (0.35 * (1.0 + 0.20 * Math.Sqrt(granulation - 1))).ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "0.35")m &bull; Prędkość ~1.4 m/s (5.0 km/h)</div>
                    <div>Warstwa mapowa: Współrzędne w metrach [0, @worldWidth.ToString("F0")] &times; [0, @worldHeight.ToString("F0")]</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Floating Live Statistics Popup -->
    <StatisticsPopup 
        IsOpen="_showStats" 
        OnClose="() => _showStats = false" 
        Stats="_statsCollector.Stats" 
        IsLive="true" />
</div>

@if (showPublishModal && publishedPlan != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.85); backdrop-filter: blur(4px); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
            <div class="modal-content bg-dark text-white border border-secondary shadow-lg rounded-3 overflow-hidden">
                <!-- Modal Header -->
                <div class="modal-header border-secondary bg-black bg-opacity-40 px-4 py-3 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fs-4">&#x1F4F1;</span>
                        <div>
                            <h5 class="modal-title mb-0 fw-bold text-white">Plan Ewakuacji Opublikowany</h5>
                            <small class="text-success fw-semibold">&#x25CF; Sesja: <span class="font-monospace text-info">@publishedPlan.SessionId</span></small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="ClosePublishModal" aria-label="Zamknij"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body px-4 py-3 text-center">
                    <p class="text-muted small mb-3">
                        Zeskanuj poniższy kod QR telefonem komórkowym lub przekaż link ewakuowanym obywatelom, aby uruchomić mobilnego asystenta z mapą.
                    </p>

                    <!-- QR Code Card -->
                    <div class="d-flex justify-content-center my-2">
                        <div class="bg-white p-3 rounded-3 shadow border border-2 border-white d-flex align-items-center justify-content-center"
                             style="width: 220px; height: 220px; box-sizing: border-box; overflow: hidden;">
                            <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
                                @((MarkupString)WrapSvgResponsive(publishedPlan.QrCodeSvg))
                            </div>
                        </div>
                    </div>

                    <!-- Statistics Tiles -->
                    <div class="row g-2 mb-3 mt-1">
                        <div class="col-4">
                            <div class="p-2 bg-black bg-opacity-40 rounded border border-secondary">
                                <div class="text-muted" style="font-size: 0.7rem;">SCHRONY</div>
                                <div class="fs-5 fw-bold text-success">@targets.Count</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 bg-black bg-opacity-40 rounded border border-secondary">
                                <div class="text-muted" style="font-size: 0.7rem;">BLOKADY</div>
                                <div class="fs-5 fw-bold text-danger">@obstacles.Count</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 bg-black bg-opacity-40 rounded border border-secondary">
                                <div class="text-muted" style="font-size: 0.7rem;">OBSZAR</div>
                                <div class="fs-5 fw-bold text-info">@worldWidth.ToString("F0")m</div>
                            </div>
                        </div>
                    </div>

                    <!-- Shareable URLs -->
                    <div class="text-start mb-3">
                        <label class="form-label small text-muted mb-1">Bezpośrednie adresy dla obywateli:</label>
                        <div class="d-flex flex-column gap-2">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-dark text-white border-secondary small" style="width: 145px;">Widok obywatela:</span>
                                <input type="text" class="form-control bg-black text-info border-secondary font-monospace small" readonly value="@publishedPlan.EvacuateUrl" />
                                <a href="@publishedPlan.EvacuateUrl" target="_blank" class="btn btn-primary px-3 fw-bold d-inline-flex align-items-center gap-1">
                                    <span>Otwórz</span>
                                    <span>&rarr;</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer border-secondary bg-black bg-opacity-20 px-4 py-2 d-flex justify-content-end">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClosePublishModal">Zamknij</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ElementReference canvas;
    private IJSObjectReference? module;
    private IJSObjectReference? simulator;
    private CrowdSimulationEngine? _engine;
    private CancellationTokenSource? _simCts;

    private bool _showStats = false;
    private readonly SimulationStatsCollector _statsCollector = new();

    private int agentCount = 500;
    private int granulation = 1;
    private int SimulatedAgentCount => Math.Max(1, (int)Math.Ceiling((double)agentCount / Math.Max(1, granulation)));

    private double socialRepulsionWeight = 4.5;
    private double whiskerLength = 2.5;
    private double worldWidth = 200.0;
    private double worldHeight = 200.0;
    private double timeScale = 1.0;
    private bool unlimited;
    private string renderFps = "30";

    private double ActualSpeed => simulationStepsPerSecond * 0.016;
    private string activeEngine = "webgpu";
    private bool isWebGpuSupported;
    private string renderMode = "agents";
    private bool showWhiskers;
    private bool showFlowParticles = true;
    private bool isRunning;
    private bool showDiagnostics;
    private double renderFramesPerSecond;
    private double simulationStepsPerSecond;
    private bool ready;
    private bool disposed;

    private List<ObstacleDto> obstacles = new();
    private List<EvacuationTarget> targets = new();
    private PublishPlanResponse? publishedPlan;
    private bool showPublishModal;
    private bool isPublishing;
    private string? publishError;

    private double weightDistance = 0.5;
    private double weightOccupancy = 0.5;

    protected override void OnInitialized()
    {
        InitDefaultEnvironment();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !disposed)
        {
            await InitializeEngine();
        }
    }

    private void InitDefaultEnvironment()
    {
        obstacles.Clear();
        targets.Clear();
        if (worldWidth == 60 && worldHeight == 40)
        {
            obstacles.Add(new ObstacleDto(20.0, 0.0, 8.0, 14.0, "obs_north"));
            obstacles.Add(new ObstacleDto(20.0, 26.0, 8.0, 14.0, "obs_south"));
            targets.Add(new EvacuationTarget("shelter-main", "Wyjście Główne (Wschód)", 56.0, 15.0, 4.0, 10.0, 1000, 0, true));
        }
        else
        {
            obstacles.Add(new ObstacleDto(worldWidth * 0.35, worldHeight * 0.18, worldWidth * 0.12, worldHeight * 0.28, "obs_north"));
            obstacles.Add(new ObstacleDto(worldWidth * 0.35, worldHeight * 0.54, worldWidth * 0.12, worldHeight * 0.28, "obs_south"));
            targets.Add(new EvacuationTarget("shelter-north", "Schron Północny (Bramka A)", worldWidth * 0.90, worldHeight * 0.12, worldWidth * 0.08, worldHeight * 0.20, 300, 35, true));
            targets.Add(new EvacuationTarget("shelter-south", "Schron Południowy (Bramka B)", worldWidth * 0.90, worldHeight * 0.68, worldWidth * 0.08, worldHeight * 0.20, 300, 15, true));
        }
    }

    private object GetWorldConfigDto() => new
    {
        worldWidth = worldWidth,
        worldHeight = worldHeight,
        obstacles = obstacles.Select(o => new { x = o.X, y = o.Y, width = o.Width, height = o.Height }),
        targets = targets.Select(t => new { x = t.X, y = t.Y, width = t.Width, height = t.Height, name = t.Name, id = t.Id }),
        exitZone = targets.FirstOrDefault() is { } ez ? new { x = ez.X, y = ez.Y, width = ez.Width, height = ez.Height } : null
    };

    private async Task InitializeEngine()
    {
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/crowdSimulatorInterop.js");
            simulator ??= await module.InvokeAsync<IJSObjectReference>("initSimulator", canvas);

            try
            {
                isWebGpuSupported = await module.InvokeAsync<bool>("checkWebGpuSupport");
            }
            catch
            {
                isWebGpuSupported = false;
            }

            activeEngine = "wasm";

            _engine = new CrowdSimulationEngine(worldWidth, worldHeight, agentCount);
            _engine.Granulation = granulation;
            _engine.SocialRepulsionWeight = socialRepulsionWeight;
            _engine.WhiskerLength = whiskerLength;
            _engine.SetEnvironment(obstacles, targets, weightDistance, weightOccupancy);
            _engine.InitializeAgents();
            _statsCollector.Reset(_engine.AgentCount);

            await SyncWorldConfigAsync();
            ready = true;
            await RequestRender();
        }
        catch (Exception ex)
        {
            publishError = $"Błąd inicjalizacji widoku: {ex.Message}";
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetEngine(string engine)
    {
        if (engine == "webgpu" && !isWebGpuSupported) return;
        activeEngine = engine;
        if (activeEngine == "webgpu" && simulator != null)
        {
            try
            {
                await simulator.InvokeVoidAsync("initGpu", SimulatedAgentCount, granulation, socialRepulsionWeight, GetWorldConfigDto());
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[PlanSafe] Failed to switch to WebGPU: {ex.Message}");
                activeEngine = "wasm";
            }
        }
        await RequestRender();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SyncWorldConfigAsync()
    {
        if (simulator == null) return;
        await simulator.InvokeVoidAsync("setWorldConfig", new
        {
            worldWidth = worldWidth,
            worldHeight = worldHeight,
            obstacles = obstacles.Select(o => new { x = o.X, y = o.Y, width = o.Width, height = o.Height }),
            targets = targets.Select(t => new { x = t.X, y = t.Y, width = t.Width, height = t.Height, name = t.Name, id = t.Id }),
            exitZone = targets.FirstOrDefault() is { } ez ? new { x = ez.X, y = ez.Y, width = ez.Width, height = ez.Height } : null
        });
    }

    private async Task ToggleSimulation()
    {
        if (!isRunning && _engine != null && (_engine.ActiveAgentCount == 0 || (_engine.EvacuatedCount >= _engine.AgentCount && _engine.EvacuatedCount > 0)) && _engine.SimulationTime > 0)
        {
            _engine.Reset();
            _engine.InitializeAgents();
            _statsCollector.Reset(_engine.AgentCount);
            if (activeEngine == "webgpu" && simulator != null)
            {
                await simulator.InvokeVoidAsync("resetGpu", SimulatedAgentCount, granulation, socialRepulsionWeight);
            }
            await RequestRender();
        }

        isRunning = !isRunning;
        if (isRunning)
        {
            _simCts = new CancellationTokenSource();
            _ = RunSimulationLoopAsync(_simCts.Token);
        }
        else
        {
            _simCts?.Cancel();
            renderFramesPerSecond = 0;
            simulationStepsPerSecond = 0;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task StepSimulation()
    {
        if (activeEngine == "webgpu" && simulator != null)
        {
            await simulator.InvokeVoidAsync("stepGpu", 1);
        }
        if (_engine != null)
        {
            _engine.Step(0.016, timeScale);
            _statsCollector.SampleTelemetry(_engine);
        }
        await RequestRender();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetSimulation()
    {
        _simCts?.Cancel();
        isRunning = false;
        renderFramesPerSecond = 0;
        simulationStepsPerSecond = 0;

        if (activeEngine == "webgpu" && simulator != null)
        {
            await simulator.InvokeVoidAsync("resetGpu", SimulatedAgentCount, granulation, socialRepulsionWeight);
        }

        if (_engine != null)
        {
            _engine.Reset();
            _engine.InitializeAgents();
            _statsCollector.Reset(_engine.AgentCount);
        }
        await RequestRender();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RunSimulationLoopAsync(CancellationToken ct)
    {
        var sw = Stopwatch.StartNew();
        long lastRenderTime = sw.ElapsedMilliseconds;
        long lastStatsRenderTime = sw.ElapsedMilliseconds;
        var fpsTimer = Stopwatch.StartNew();
        int frameCount = 0;
        int stepCount = 0;

        while (!ct.IsCancellationRequested && isRunning)
        {
            if (activeEngine == "webgpu" && simulator != null)
            {
                int batch = unlimited ? 20 : Math.Max(1, (int)Math.Round(timeScale));
                await simulator.InvokeVoidAsync("stepGpu", batch);
                stepCount += batch;
            }

            if (_engine != null)
            {
                double scale = unlimited ? 20.0 : timeScale;
                _engine.Step(0.016, scale);
                _statsCollector.SampleTelemetry(_engine);
                if (activeEngine != "webgpu")
                {
                    stepCount++;
                }
            }

            if (_engine != null && (_engine.ActiveAgentCount == 0 || (_engine.EvacuatedCount >= _engine.AgentCount && _engine.EvacuatedCount > 0)) && _engine.SimulationTime > 0)
            {
                isRunning = false;
                renderFramesPerSecond = 0;
                simulationStepsPerSecond = 0;
                _statsCollector.SampleTelemetry(_engine);
                await RequestRender();
                await InvokeAsync(StateHasChanged);
                break;
            }

            long now = sw.ElapsedMilliseconds;
            int frameInterval = renderFps switch
            {
                "15" => 66,
                "30" => 33,
                "60" => 16,
                _ => 16
            };

            if (now - lastRenderTime >= frameInterval)
            {
                lastRenderTime = now;
                frameCount++;
                await RequestRender();
            }

            if (_showStats && now - lastStatsRenderTime >= 100)
            {
                lastStatsRenderTime = now;
                await InvokeAsync(StateHasChanged);
            }

            if (fpsTimer.ElapsedMilliseconds >= 1000)
            {
                renderFramesPerSecond = frameCount * 1000.0 / fpsTimer.ElapsedMilliseconds;
                simulationStepsPerSecond = stepCount * 1000.0 / fpsTimer.ElapsedMilliseconds;
                frameCount = 0;
                stepCount = 0;
                fpsTimer.Restart();
                await InvokeAsync(StateHasChanged);
            }

            if (!unlimited)
            {
                await Task.Delay(1, ct);
            }
            else
            {
                await Task.Yield();
            }
        }
    }

    private async Task RequestRender()
    {
        if (simulator == null) return;
        try
        {
            if (activeEngine == "webgpu")
            {
                await simulator.InvokeVoidAsync("renderGpu", renderMode, showWhiskers, whiskerLength, granulation, showFlowParticles);
            }
            else if (_engine != null)
            {
                int count = _engine.SimulatedAgentCount;
                await simulator.InvokeVoidAsync("render",
                    _engine.AgentPositionX[..count],
                    _engine.AgentPositionY[..count],
                    _engine.AgentVelocityX[..count],
                    _engine.AgentVelocityY[..count],
                    _engine.AgentRadius[..count],
                    count,
                    renderMode,
                    showWhiskers,
                    whiskerLength,
                    granulation,
                    showFlowParticles);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PlanSafe] RequestRender error: {ex.Message}");
        }
    }

    private async Task SetWorldPreset(double width, double height)
    {
        worldWidth = width;
        worldHeight = height;
        InitDefaultEnvironment();

        if (_engine != null)
        {
            _engine = new CrowdSimulationEngine(worldWidth, worldHeight, agentCount);
            _engine.Granulation = granulation;
            _engine.SocialRepulsionWeight = socialRepulsionWeight;
            _engine.WhiskerLength = whiskerLength;
            _engine.SetEnvironment(obstacles, targets, weightDistance, weightOccupancy);
            _engine.InitializeAgents();
            _statsCollector.Reset(_engine.AgentCount);
        }

        await SyncWorldConfigAsync();
        if (activeEngine == "webgpu" && simulator != null)
        {
            await simulator.InvokeVoidAsync("setGpuWorldConfig", new
            {
                worldWidth = worldWidth,
                worldHeight = worldHeight,
                obstacles = obstacles.Select(o => new { x = o.X, y = o.Y, width = o.Width, height = o.Height }),
                targets = targets.Select(t => new { x = t.X, y = t.Y, width = t.Width, height = t.Height, name = t.Name, id = t.Id }),
                exitZone = targets.FirstOrDefault() is { } ez ? new { x = ez.X, y = ez.Y, width = ez.Width, height = ez.Height } : null,
                count = SimulatedAgentCount,
                granulation = granulation
            });
        }
        await RequestRender();
    }

    private async Task ApplyCount()
    {
        if (_engine != null)
        {
            _engine.AgentCount = agentCount;
            _engine.InitializeAgents();
            _statsCollector.Reset(_engine.AgentCount);
            await RequestRender();
        }
        if (activeEngine == "webgpu" && simulator != null)
        {
            await simulator.InvokeVoidAsync("resetGpu", SimulatedAgentCount, granulation, socialRepulsionWeight);
            await RequestRender();
        }
    }

    private async Task ApplyGranulation()
    {
        if (_engine != null)
        {
            _engine.SetGranulation(granulation);
            _statsCollector.Reset(_engine.AgentCount);
            await RequestRender();
        }
        if (activeEngine == "webgpu" && simulator != null)
        {
            await simulator.InvokeVoidAsync("resetGpu", SimulatedAgentCount, granulation, socialRepulsionWeight);
            await RequestRender();
        }
    }

    private Task ApplyWeight()
    {
        if (_engine != null)
        {
            _engine.SocialRepulsionWeight = socialRepulsionWeight;
        }
        if (activeEngine == "webgpu" && simulator != null)
        {
            _ = simulator.InvokeVoidAsync("resetGpu", SimulatedAgentCount, granulation, socialRepulsionWeight);
        }
        return Task.CompletedTask;
    }

    private void SetScenario(double wDist, double wOcc)
    {
        SetWeightDist(wDist);
    }

    private void AdjustWeightDist(double delta)
    {
        SetWeightDist(weightDistance + delta);
    }

    private void AdjustWeightOcc(double delta)
    {
        SetWeightOcc(weightOccupancy + delta);
    }

    private void SetWeightDist(double val)
    {
        weightDistance = Math.Clamp(Math.Round(val, 2), 0.0, 1.0);
        weightOccupancy = Math.Round(1.0 - weightDistance, 2);
        ApplyWeights();
    }

    private void SetWeightOcc(double val)
    {
        weightOccupancy = Math.Clamp(Math.Round(val, 2), 0.0, 1.0);
        weightDistance = Math.Round(1.0 - weightOccupancy, 2);
        ApplyWeights();
    }

    private void OnWeightDistInput(ChangeEventArgs e)
    {
        if (TryParseDoubleInvariant(e.Value, out var val))
        {
            SetWeightDist(val);
        }
    }

    private void OnWeightOccInput(ChangeEventArgs e)
    {
        if (TryParseDoubleInvariant(e.Value, out var val))
        {
            SetWeightOcc(val);
        }
    }

    private void ApplyWeights()
    {
        if (_engine != null)
        {
            _engine.WeightDistance = weightDistance;
            _engine.WeightOccupancy = weightOccupancy;
            _engine.PotentialFieldMap.RefineDynamicField();
        }
    }

    private void ResetShelters()
    {
        if (_engine != null)
        {
            for (int i = 0; i < _engine.Targets.Count; i++)
            {
                _engine.Targets[i] = _engine.Targets[i] with { CurrentOccupancy = 0 };
            }
            for (int i = 0; i < targets.Count; i++)
            {
                targets[i] = targets[i] with { CurrentOccupancy = 0 };
            }
        }
    }

    private async Task ZoomIn()
    {
        if (simulator != null) await simulator.InvokeVoidAsync("zoom", 1.25);
    }

    private async Task ZoomOut()
    {
        if (simulator != null) await simulator.InvokeVoidAsync("zoom", 0.8);
    }

    private async Task ToggleStats()
    {
        _showStats = !_showStats;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetCamera()
    {
        if (simulator != null) await simulator.InvokeVoidAsync("resetView");
    }

    private void PublishCurrentPlan()
    {
        isPublishing = true;
        publishError = null;

        string baseUrl = Nav?.BaseUri?.TrimEnd('/') ?? "http://localhost:5000";
        string evacuateUrl = $"{baseUrl}/evacuate";

        publishedPlan = new PublishPlanResponse(
            SessionId: Guid.NewGuid().ToString("N")[..8],
            EvacuateUrl: evacuateUrl,
            QrCodeSvg: GenerateSimpleQrCodeSvg(evacuateUrl),
            CreatedAtUtc: DateTime.UtcNow
        );

        isPublishing = false;
        showPublishModal = true;
    }

    private void ClosePublishModal()
    {
        showPublishModal = false;
    }

    private static bool TryParseDoubleInvariant(object? value, out double result)
    {
        result = 0.0;
        if (value is null) return false;
        var str = value.ToString()?.Trim().Replace(',', '.');
        return double.TryParse(str, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out result);
    }

    private static string WrapSvgResponsive(string? svg)
    {
        if (string.IsNullOrWhiteSpace(svg)) return string.Empty;
        if (svg.StartsWith("<svg", StringComparison.OrdinalIgnoreCase))
        {
            return "<svg style=\"width: 100%; height: 100%; max-width: 100%; max-height: 100%; display: block;\" " + svg[4..];
        }
        return svg;
    }

    private static string GenerateSimpleQrCodeSvg(string url)
    {
        int size = 25;
        bool[,] grid = new bool[size, size];

        void DrawFinder(int r0, int c0)
        {
            for (int r = 0; r < 7; r++)
            {
                for (int c = 0; c < 7; c++)
                {
                    bool border = (r == 0 || r == 6 || c == 0 || c == 6);
                    bool center = (r >= 2 && r <= 4 && c >= 2 && c <= 4);
                    grid[r0 + r, c0 + c] = border || center;
                }
            }
        }
        DrawFinder(0, 0);
        DrawFinder(0, size - 7);
        DrawFinder(size - 7, 0);

        for (int i = 8; i < size - 8; i++)
        {
            grid[6, i] = (i % 2 == 0);
            grid[i, 6] = (i % 2 == 0);
        }

        uint hash = 2166136261;
        foreach (char ch in url) hash = (hash ^ ch) * 16777619;
        var rng = new Random((int)hash);

        for (int r = 0; r < size; r++)
        {
            for (int c = 0; c < size; c++)
            {
                bool inFinder = (r < 8 && c < 8) || (r < 8 && c >= size - 8) || (r >= size - 8 && c < 8);
                bool inTiming = (r == 6 || c == 6);
                if (!inFinder && !inTiming)
                {
                    grid[r, c] = (rng.Next(100) < 48);
                }
            }
        }

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 {size + 4} {size + 4}\" shape-rendering=\"crispEdges\">");
        sb.Append($"<rect width=\"{size + 4}\" height=\"{size + 4}\" fill=\"white\"/>");
        for (int r = 0; r < size; r++)
        {
            for (int c = 0; c < size; c++)
            {
                if (grid[r, c])
                {
                    sb.Append($"<rect x=\"{c + 2}\" y=\"{r + 2}\" width=\"1\" height=\"1\" fill=\"black\"/>");
                }
            }
        }
        sb.Append("</svg>");
        return sb.ToString();
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        _simCts?.Cancel();
        isRunning = false;

        try
        {
            if (simulator != null)
            {
                await simulator.InvokeVoidAsync("dispose");
                await simulator.DisposeAsync();
                simulator = null;
            }
            if (module != null)
            {
                await module.DisposeAsync();
                module = null;
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
