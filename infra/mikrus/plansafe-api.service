[Unit]
Description=PlanSafe native API
After=network.target

[Service]
User=plansafe
Group=plansafe
WorkingDirectory=/srv/plansafe/data
ExecStart=/srv/plansafe/current/api/PlanSafe.Api
Environment=ASPNETCORE_URLS=http://127.0.0.1:5001
Environment="ConnectionStrings__PlanSafe=Data Source=/srv/plansafe/data/plansafe.db"
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/plansafe/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
MemoryMax=180M
TasksMax=64
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
